// pond/_util/intfloat — Int <-> Float bridge. **DEPRECATED
// 2026-07-04** — upstream now ships the whole surface natively:
// `std::math::int_to_float` / `float_to_int` (2026-06-11) and
// `std::math::round` / `trunc` (2026-06-14). New code should
// call std::math directly; this lotus remains as thin delegates
// for already-vendored consumers (zero in-tree consumers left).
//
// Historical: consolidated the `int_to_float` helper every
// numeric pond lib wrote locally while F.23 Int→Float widening
// was under-implemented (`let f: Float = i;` and `0.0 + n`
// still reject at let-ascription/binop positions — retested
// 2026-07-04 — but the std::math conversions are the supported
// bridge now).
//
// All callable surface lives on the `IntFloat` namespace lotus
// (per pond/KNOWN_GOTCHAS.md G11 — cross-seed non-fallible free
// fns don't lower in expression position; namespace-lotus
// methods do).
//
// Consumers:
//
//     import "vendor/pond/_util/intfloat" as intf;
//     let ifx = intf::IntFloat { };
//     let f   = ifx.to_float(42);

// IntFloat — namespace lotus.
locus IntFloat {
    params { }

    // to_float(n) -- delegate to the native conversion (was an
    // ASCII roundtrip through parse_float(to_string(n)) before
    // std::math::int_to_float shipped).
    fn to_float(n: Int) -> Float {
        return std::math::int_to_float(n);
    }

    // from_float(f) -- Float -> Int, truncating toward zero.
    fn from_float(f: Float) -> Int {
        return std::math::float_to_int(f);
    }
}
