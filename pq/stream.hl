// pond/pq/stream — dual-transport dispatch (plaintext TCP vs TLS).
//
// std::io::tls exposes only flat path-calls (connect/upgrade/send_bytes/
// recv_bytes/recv_into/close/...) — there is NO tls Stream locus, and a
// TLS handle is an index into an opaque handle table, NOT a kernel fd.
// Handing a TLS handle to std::io::tcp::Stream would treat that table
// index as a raw fd and corrupt/crash. So every pq I/O site routes
// through these helpers, branching on the PgConn's `tls` flag between
// the TLS handle API and the raw-fd TCP API.
//
// This is the PROVEN pattern from pond/http/client/keepalive.hl
// (__send_raw/__recv_raw/__close_handle), ported verbatim in shape; the
// recon spike (daydream-0v2) confirmed std::io::tls and std::io::tcp
// recv collapse EOF/error/timeout to a length-0 Bytes IDENTICALLY, so
// pq's rx_buf/recv_chunk accumulation loop transfers unchanged over TLS.
//
// `handle` is the PgConn.sock field: a raw fd when tls=false, a TLS
// handle (g_tls_entries index) when tls=true.
//
// SCHEDULER CAVEAT (spike finding, daydream-0v2): std::io::tls has NO
// async_io integration — its recv does a blocking SSL_read that parks
// the OS thread, whereas std::io::tcp::recv_bytes yields on an async_io
// pool. Harmless for pq's documented ordinary-cooperative-pool placement
// (where recv blocks either way), but a TLS PgConn/PgPool must NOT be
// placed on an async_io pool until hale grows non-blocking TLS reads —
// it would starve sibling coros that plain TCP would not.

// __send_raw — send `b`, returning bytes written (<0 on error).
fn __send_raw(handle: Int, is_tls: Bool, b: Bytes) -> Int {
    if is_tls { return std::io::tls::send_bytes(handle, b); }
    return std::io::tcp::__send_bytes(handle, b);
}

// __recv_raw — read up to `max_bytes`. A length-0 return means
// EOF/error/retryable collapsed (identical contract on both transports).
fn __recv_raw(handle: Int, is_tls: Bool, max_bytes: Int) -> Bytes {
    if is_tls { return std::io::tls::recv_bytes(handle, max_bytes); }
    return std::io::tcp::__recv_bytes(handle, max_bytes);
}

// __close_handle — close the connection via the right transport. For TLS
// this SSL_free's the session AND closes the underlying fd; for plain TCP
// it closes the fd. A negative handle is a no-op (never opened / already
// torn down).
fn __close_handle(handle: Int, is_tls: Bool) {
    if handle < 0 { return; }
    if is_tls { std::io::tls::close(handle); } else { std::io::tcp::__close_fd(handle); }
}
