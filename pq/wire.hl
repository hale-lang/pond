// pond/pq/wire — PostgreSQL frontend/backend protocol v3 codec.
//
// Pure-Hale pgwire over std::io::tcp — no FFI. Covers the subset
// the DbDriver surface needs: StartupMessage, simple Query ('Q'),
// and parsing the backend's RowDescription ('T') / DataRow ('D')
// / CommandComplete ('C') / ErrorResponse ('E') / ReadyForQuery
// ('Z') / Authentication ('R') / ParameterStatus ('S') /
// BackendKeyData ('K') / NoticeResponse ('N').
//
// Auth: trust (server sends AuthenticationOk immediately) and
// SCRAM-SHA-256 (AuthenticationSASL exchange; the crypto core lives
// in scram.hl, the framing below, the sequencing in pq.hl's
// __sasl_exchange). MD5 auth is still unsupported.
//
// v0 assumptions:
//   - simple query protocol (text result format). Values come
//     back as text; we join columns with \t, rows with \n.
//   - BE ints via arithmetic (x - (x/256)*256 for mod 256), same
//     idiom as pond/websocket/frame.hl. (Hale v1 DOES have bitwise
//     ops — see crypto/util.hl / scram.hl — but the arithmetic form
//     is kept here for consistency with the rest of the codec.)

// ===== big-endian int helpers =====

// be32_append — append `n` as 4 big-endian bytes to a builder.
fn be32_append(b: std::bytes::BytesBuilder, n: Int) {
    let b3 = (n / 16777216) - ((n / 16777216) / 256) * 256;
    let b2 = (n / 65536)    - ((n / 65536)    / 256) * 256;
    let b1 = (n / 256)      - ((n / 256)      / 256) * 256;
    let b0 = n - (n / 256) * 256;
    b.append(std::bytes::from_int(b3));
    b.append(std::bytes::from_int(b2));
    b.append(std::bytes::from_int(b1));
    b.append(std::bytes::from_int(b0));
}

fn be16_append(b: std::bytes::BytesBuilder, n: Int) {
    let b1 = (n / 256) - ((n / 256) / 256) * 256;
    let b0 = n - (n / 256) * 256;
    b.append(std::bytes::from_int(b1));
    b.append(std::bytes::from_int(b0));
}

fn byte_at(buf: Bytes, i: Int) -> Int {
    return std::bytes::at(buf, i) or 0;
}

fn read_be32(buf: Bytes, off: Int) -> Int {
    return byte_at(buf, off) * 16777216
         + byte_at(buf, off + 1) * 65536
         + byte_at(buf, off + 2) * 256
         + byte_at(buf, off + 3);
}

fn read_be16(buf: Bytes, off: Int) -> Int {
    return byte_at(buf, off) * 256 + byte_at(buf, off + 1);
}

// ===== outbound messages =====

// build_startup — the v3.0 StartupMessage. No type byte (startup
// is special): [Int32 len][Int32 196608][k\0v\0...\0].
fn build_startup(user: String, database: String) -> Bytes {
    let body = std::bytes::BytesBuilder { initial_cap: 128 };
    // protocol 3.0 = 196608 (0x00030000)
    be32_append(body, 196608);
    __append_cstr(body, "user");
    __append_cstr(body, user);
    __append_cstr(body, "database");
    __append_cstr(body, database);
    body.append(std::bytes::from_int(0));   // terminating empty key
    let payload = body.snapshot();
    let total = len(payload) + 4;            // +4 for the length field itself

    let out = std::bytes::BytesBuilder { initial_cap: total + 4 };
    be32_append(out, total);
    out.append(payload);
    return out.finish();
}

// build_query — simple Query: [Byte 'Q'][Int32 len][sql\0].
fn build_query(sql: String) -> Bytes {
    let sql_bytes = std::bytes::from_string(sql);
    let body_len = len(sql_bytes) + 1 + 4;   // sql + NUL + length field
    let out = std::bytes::BytesBuilder { initial_cap: body_len + 1 };
    out.append(std::bytes::from_int(81));     // 'Q' = 0x51 = 81
    be32_append(out, body_len);
    out.append(sql_bytes);
    out.append(std::bytes::from_int(0));      // NUL terminator
    return out.finish();
}

// build_terminate — [Byte 'X'][Int32 4]. Graceful close.
fn build_terminate() -> Bytes {
    let out = std::bytes::BytesBuilder { initial_cap: 5 };
    out.append(std::bytes::from_int(88));     // 'X' = 88
    be32_append(out, 4);
    return out.finish();
}

// ===== SASL (SCRAM-SHA-256) outbound messages =====

// build_sasl_initial — SASLInitialResponse:
//   ['p'][Int32 len]["SCRAM-SHA-256"\0][Int32 client-first-len][client-first]
// The mechanism name is a NUL-terminated cstr; the client-first bytes
// are length-prefixed (Int32) and NOT NUL-terminated. `client_first`
// is the full "n,,n=,r=<nonce>" (gs2 header + client-first-bare).
fn build_sasl_initial(client_first: String) -> Bytes {
    let cf = std::bytes::from_string(client_first);
    let body = std::bytes::BytesBuilder { initial_cap: len(cf) + 32 };
    __append_cstr(body, "SCRAM-SHA-256");
    be32_append(body, len(cf));
    body.append(cf);
    let payload = body.snapshot();
    let out = std::bytes::BytesBuilder { initial_cap: len(payload) + 5 };
    out.append(std::bytes::from_int(112));    // 'p' = 112
    be32_append(out, len(payload) + 4);
    out.append(payload);
    return out.finish();
}

// build_sasl_response — SASLResponse:
//   ['p'][Int32 len][client-final]
// The body is the raw client-final-message "c=biws,r=<nonce>,p=<proof>"
// — no mechanism, no length prefix (unlike the initial response).
fn build_sasl_response(client_final: String) -> Bytes {
    let cf = std::bytes::from_string(client_final);
    let out = std::bytes::BytesBuilder { initial_cap: len(cf) + 5 };
    out.append(std::bytes::from_int(112));    // 'p' = 112
    be32_append(out, len(cf) + 4);
    out.append(cf);
    return out.finish();
}

// ===== Authentication ('R') message parsers =====

// sasl_r_code — the Int32 sub-code of an Authentication ('R') message,
// located right after the type byte + length field (offset 5):
//   0 = AuthenticationOk, 10 = AuthenticationSASL,
//   11 = AuthenticationSASLContinue, 12 = AuthenticationSASLFinal.
fn sasl_r_code(body: Bytes) -> Int {
    return read_be32(body, 5);
}

// sasl_r_text — the text payload of a SASLContinue/SASLFinal message:
// everything after the Int32 sub-code (offset 9) to the end of the
// frame (`total`). Code 11 -> server-first-message; code 12 ->
// server-final-message ("v=<ServerSignature>").
fn sasl_r_text(body: Bytes, total: Int) -> String {
    return std::str::from_bytes(std::bytes::slice(body, 9, total));
}

// ===== SASL exchange failure classification (retry contract) =====
//
// A read failure (peer close) mid-__sasl_exchange (pq.hl) is a
// TRANSIENT cold-dial condition per FRICTION.log — observed against a
// perfectly healthy postgres server — not a definitive auth outcome,
// so it MUST be retryable. A definitive outcome (server ErrorResponse,
// a server-signature mismatch, a bad/foreign nonce, or a protocol
// violation like "expected SASLContinue") must NOT be retried blindly
// against a hostile/misconfigured server, so open()'s retry loop
// (pq.hl) treats a small fixed set of `db::DbError.kind` values as
// fail-fast.
//
// This pair of pure functions is the single source of truth for that
// contract. It lives here rather than in pq.hl (whose
// `import "vendor/pond/db"` only resolves inside a vendored consumer
// tree, so pq.hl can't be typechecked/run standalone — see
// FRICTION.log § pond/pq, "In-repo build vs check") so the
// retry/fail-fast classification stays unit-testable offline: the
// "classification level" test for a behaviour that's otherwise
// awkward to exercise without a live socket dropping mid-handshake.
fn sasl_retryable_kind() -> String { return "io"; }

fn is_fail_fast_kind(kind: String) -> Bool {
    return kind == "auth_failed" || kind == "unsupported" || kind == "startup_rejected";
}

fn __append_cstr(b: std::bytes::BytesBuilder, s: String) {
    b.append(std::bytes::from_string(s));
    b.append(std::bytes::from_int(0));
}
