// kv-demo — "create table, insert, select" against a REAL SQLite
// database file, via pond/sqlite's @ffi driver (glue.c over the
// system libsqlite3; see ../../README.md).
//
// What it exercises:
//   1. Happy path  — open (birth), DDL, INSERT (rows_affected +
//      last_insert_rowid), query_one, query_all, and the full
//      prepare / bind_text / step / finalize parameterized path.
//   2. Error paths — every failure arrives as a DbError VALUE
//      through the `or self.handle_*(err)` disposition, never a
//      crash: bad SQL ("exec_failed"), duplicate primary key
//      ("constraint", sqlite_code 19), zero-row query_one
//      ("no_row"), and an unopenable database path ("open_failed",
//      reported by the first SQL call since birth() — a lifecycle
//      method — cannot be fallible).
//
// The database lands at /tmp/pond-sqlite-kv-demo.db; the demo
// drops + recreates its table so reruns are idempotent.
//
// Build (needs libsqlite3-dev; the [ffi] section in
// ../../hale.toml is picked up automatically):
//     hale build sqlite/examples/kv-demo/
//     ./sqlite/examples/kv-demo/kv-demo
//
// Import alias is `sqlite` per pond/CONTRACTS.md.

import "../.." as sqlite;

locus KvDemo {
    params {
        path: String = "/tmp/pond-sqlite-kv-demo.db";
        // Count of DbErrors seen by the handlers; the deliberate
        // error-path section expects exactly four.
        errors_seen: Int = 0;
    }

    // Error-check fns (styleguide § 7): one per success type the
    // call sites expect. Each prints the full DbError payload and
    // substitutes a zero-value so the demo keeps running.
    fn handle_exec(e: sqlite::DbError) -> sqlite::ExecResult {
        self.errors_seen = self.errors_seen + 1;
        println("[kv-demo] DbError: kind=", e.kind,
            " sqlite_code=", to_string(e.sqlite_code),
            " detail=", e.detail);
        return sqlite::ExecResult { };
    }
    fn handle_row(e: sqlite::DbError) -> sqlite::Row {
        self.errors_seen = self.errors_seen + 1;
        println("[kv-demo] DbError: kind=", e.kind,
            " sqlite_code=", to_string(e.sqlite_code),
            " detail=", e.detail);
        return sqlite::Row { };
    }
    fn handle_rows(e: sqlite::DbError) -> sqlite::Rows {
        self.errors_seen = self.errors_seen + 1;
        println("[kv-demo] DbError: kind=", e.kind,
            " sqlite_code=", to_string(e.sqlite_code),
            " detail=", e.detail);
        return sqlite::Rows { };
    }
    fn handle_stmt(e: sqlite::DbError) -> Int {
        self.errors_seen = self.errors_seen + 1;
        println("[kv-demo] DbError: kind=", e.kind,
            " sqlite_code=", to_string(e.sqlite_code),
            " detail=", e.detail);
        return 0;
    }
    fn handle_unit(e: sqlite::DbError) {
        self.errors_seen = self.errors_seen + 1;
        println("[kv-demo] DbError: kind=", e.kind,
            " sqlite_code=", to_string(e.sqlite_code),
            " detail=", e.detail);
    }

    run() {
        println("[kv-demo] opening ", self.path);
        // `let`-bound Db: dissolve() (which closes the connection)
        // fires at run()'s scope exit per the m82 deferred-dissolve
        // rule.
        let conn = sqlite::Db { path: self.path };

        // ---- happy path ----

        // 1. DDL. Drop first so reruns are idempotent.
        let r0 = conn.exec("DROP TABLE IF EXISTS kv")
        or self.handle_exec(err);
        let r1 = conn.exec("CREATE TABLE kv (k TEXT PRIMARY KEY, v TEXT)")
        or self.handle_exec(err);
        println("[kv-demo] CREATE TABLE: rows_affected=",
            to_string(r1.rows_affected));

        // 2. Inserts — rows_affected + last_insert_rowid are real.
        let r2 = conn.exec(
            "INSERT INTO kv (k, v) VALUES ('greeting', 'hello, pond')"
        ) or self.handle_exec(err);
        println("[kv-demo] INSERT greeting: rows_affected=",
            to_string(r2.rows_affected),
            " last_insert_rowid=", to_string(r2.last_insert_rowid));
        let r3 = conn.exec(
            "INSERT INTO kv (k, v) VALUES ('farewell', 'goodbye, stub era')"
        ) or self.handle_exec(err);
        println("[kv-demo] INSERT farewell: rows_affected=",
            to_string(r3.rows_affected),
            " last_insert_rowid=", to_string(r3.last_insert_rowid));

        // 3. query_one — tab-separated columns in Row.data.
        let row = conn.query_one(
            "SELECT k, v FROM kv WHERE k = 'greeting'"
        ) or self.handle_row(err);
        println("[kv-demo] SELECT one: ", row.data);

        // 4. query_all — newline-separated rows.
        let rows = conn.query_all("SELECT k, v FROM kv ORDER BY k")
        or self.handle_rows(err);
        println("[kv-demo] SELECT all (newline-separated rows):");
        println(rows.csv);

        // 5. prepare / bind / step / finalize — parameterized path.
        let stmt = conn.prepare("SELECT v FROM kv WHERE k = ?1")
        or self.handle_stmt(err);
        if stmt > 0 {
            conn.bind_text(stmt, 1, "farewell") or self.handle_unit(err);
            let r = conn.step(stmt) or self.handle_row(err);
            println("[kv-demo] prepared step: ", r.data);
            conn.finalize(stmt) or self.handle_unit(err);
        }

        // ---- error paths (each prints a DbError payload; none crash) ----
        println("[kv-demo] -- deliberate error paths --");

        // a. Bad SQL → kind="exec_failed", sqlite_code=1 (SQLITE_ERROR).
        let bad1 = conn.exec("THIS IS NOT SQL") or self.handle_exec(err);

        // b. Duplicate primary key → kind="constraint", sqlite_code=19.
        let bad2 = conn.exec(
            "INSERT INTO kv (k, v) VALUES ('greeting', 'dupe')"
        ) or self.handle_exec(err);

        // c. Zero-row query_one → kind="no_row".
        let bad3 = conn.query_one("SELECT v FROM kv WHERE k = 'missing'")
        or self.handle_row(err);

        // d. Unopenable path: birth() can't be fallible, so the
        //    open failure surfaces as kind="open_failed" on the
        //    first SQL call against the dead connection.
        let dead = sqlite::Db { path: "/nonexistent-dir/kv.db" };
        let bad4 = dead.exec("SELECT 1") or self.handle_exec(err);

        println("[kv-demo] done: errors_seen=",
            to_string(self.errors_seen), " (expected 4)");
    }
}

fn main() {
    KvDemo { };
}
