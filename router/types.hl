// pond/router — shape types.
//
// Pattern 5 (shape types, pure data, no flow). Per CONTRACTS.md
// the public surface declares two types:
//
//   type RouteParams { qs: String; path_kv: String; }
//   type Context     { req: Request; params: RouteParams; }
//
// `qs` is the raw query string with the leading `?` stripped
// ("a=1&b=2"). `path_kv` is a tab-separated alternating key/
// value list of path captures extracted by the pattern matcher
// ("id\t42\tslug\thello"). Both representations are flat
// Strings because v1 has no Map<K,V>; the free fns
// `path_param` / `query_param` (params.hl) walk them on lookup.
// Lookup is O(N) per call, which is fine — typical routes have
// < 5 path params and < 10 query params, so the constant beats
// any structured-map overhead.
//
// `Context` bundles the parsed request with the matcher's
// captures so middleware + handlers see a single object.
// `req` is the std::http::Request as parsed by std::http;
// `params` carries the per-request capture state. Both fields
// stay value-shaped (no locus refs) so a Context can be passed
// freely between fns and through interface vtable calls.

type RouteParams {
    qs:      String = "";
    path_kv: String = "";
}

// Context is the per-request bundle threaded through the
// middleware chain and into the matched handler. Per the
// contract it carries the parsed `std::http::Request` nested
// under `req` plus the per-request capture state under
// `params`. Handlers read `ctx.req.method` / `ctx.req.path`
// / `ctx.req.headers` / `ctx.req.body`. (The 2026-05-16
// "context-req-field" flatten — pass-A0 ordering rejected
// qualified stdlib types in user type fields — closed at HEAD
// 2026-06-12; this is the contract shape restored.) Note
// `ctx.req.path` is the RAW request target including any
// query string; the matcher strips it for route matching and
// `ctx.params.qs` carries the query half.
type Context {
    req:    std::http::Request;
    params: RouteParams;
}

// Response — pond/router's local Response shape.
//
// Same fields as `std::http::Response` (status / content_type
// / body). Originally declared locally because the pass-A0
// ordering gap rejected qualified stdlib types in user type
// fields; that gap closed at HEAD (2026-06-12), but the local
// type is KEPT: Hale has no type-alias/re-export surface, so
// the alternative is handler authors writing
// `std::http::Response` literals directly — a consumer-facing
// signature break with no ergonomic win. The Router converts
// at the std::http::Server boundary; the conversion is one
// field-equal struct-literal copy (see FRICTION.log
// "response-in-fn-ptr-field" for the refreshed status).
type Response {
    status:       Int    = 200;
    content_type: String = "text/plain";
    // Additional response header lines (Set-Cookie, CORS,
    // X-Custom-*), CRLF-joined with no trailing CRLF — same
    // shape as `std::http::Response.headers` (the C11 field
    // shipped upstream; wired through 2026-06-12). The Server
    // still emits the fixed Content-Type / Content-Length /
    // Connection block unconditionally.
    headers:      String = "";
    body:         String = "";
}
