// pond/router — internal storage loci (file named lists.hl so
// it sorts alphabetically before `router.hl` — the v1 codegen
// declares loci in source-merge order, and Router's params
// reference these vecs by name, so the vec loci must land in
// user_loci first; see FRICTION.log "intra-seed-locus-order").
//
// Pattern 1 in spec/forms.md (@form(vec) — contiguous growable
// buffer). The spec rule "one form per locus" means a Router
// can't carry every list as forms on the same locus, so each
// gets its own @form(vec) child locus instantiated as a Router
// param default. Router.add() / Router.use() dispatch into
// these via the synthesized .push() member; dispatch() reads
// them via .len() + .get(i).
//
// 2026-06-12: the route table is ONE vec of `RouteEntry`
// structs — the LocusRef → Interface coercion now fires at
// struct-literal field-init sites at HEAD (the
// "interface-in-struct-field" gap closed; see FRICTION.log), so
// a `RouteEntry { handler: SomeConcreteLocus { } }` literal
// coerces the locus into the interface-typed field. The
// 2026-05-18 three-parallel-vecs workaround (MethodList /
// PatternList / HandlerList pushed in lockstep) is retired.

// One registered route. `method` is stored uppercased;
// `pattern` as-written; `handler` is the F.20 fat-pointer
// interface value coerced from the concrete handler locus at
// the literal-init site.
type RouteEntry {
    method: String;
    pattern: String;
    handler: Handler;
}

@form(vec)
locus EntryList {
    capacity { heap items of RouteEntry; }
}

@form(vec)
locus MwList {
    capacity { heap items of Middleware; }
}
