// ============================================================
// PROMOTED TO STDLIB (hale >= v0.11.4): this library shipped as
// `std::http::Router` / `Context` / `RouteParams` / `RouteHandler`
// / `Middleware` + `std::http::path_param` / `query_param` — no
// import needed, handlers return `std::http::Response` directly
// (the local Response type + boundary conversion below are the
// vendored-lib workaround the stdlib version retires). This
// vendored copy is FROZEN for consumers on older pins; new code
// should use the stdlib surface.
// ============================================================

// pond/router — Router locus + 404 default + dispatch loop.
//
// Pattern 3 in spirit (service locus with implicit lifecycle —
// no birth/run/dissolve declared because the Router has no
// resources of its own; the route + middleware vec children
// are owned via params with default locus literals, so they
// birth at instantiation and dissolve on the Router's scope
// exit). Router itself is meant to be consumed by
// `std::http::Server { handler: my_router }` — its `handle`
// method satisfies std::http::Handler structurally
// (spec/types.md § F.20 Phase B fat-pointer dispatch).
//
// Public surface per CONTRACTS.md (restored 2026-06-12 — the
// LocusRef → Interface coercion now fires at locus-method arg
// sites and struct-literal field-init sites at HEAD, and `use`
// parses as a method name; the free-fn registration shims
// `router::add(r, ...)` / `router::use_mw(r, ...)` /
// `use_before` / `use_after` are retired):
//
//   locus Router {
//       params { not_found: Handler = NotFound404 { }; }
//       fn add(method: String, pattern: String, h: Handler);
//       fn use(m: Middleware);
//       fn dispatch(req: std::http::Request) -> std::http::Response;
//       fn handle(req: std::http::Request) -> std::http::Response;
//   }
//
// (Signatures elide the contract's `-> ()` — codegen still
// rejects an explicit unit return on locus methods with a
// tuple-arity error; see FRICTION.log "unit-return-on-methods".)
//
// One remaining local-shape note: handlers return the local
// `router::Response`, not `std::http::Response`. The pass-A0
// gap that forced the local type is closed at HEAD, but Hale
// has no alias/re-export surface, so collapsing the type would
// just push `std::http::Response` literals onto handler
// authors. Router converts at the Server boundary instead —
// one field-equal copy. See FRICTION.log
// "response-in-fn-ptr-field".

// Default 404 handler — Handler-shaped locus that returns a
// plain "not found" body. Used as the default value for
// Router.not_found when a consumer doesn't override it. The
// Handler interface satisfaction is structural: NotFound404
// has a `handle(ctx: Context) -> Response` method whose
// signature matches `router::Handler.handle`.
locus NotFound404 {
    fn handle(ctx: Context) -> Response {
        return Response {
            status:       404,
            content_type: "text/plain",
            body:         "not found"
        };
    }
}

// `__router_run_chain(entries, mws, ctx, not_found)` — walk the
// middleware chain forward (each before() transforms the
// Context), find the first matching route, dispatch its
// handler, then walk the middleware chain backward (each
// after() transforms the Response). Onion-shape — the same
// order other frameworks use, but the implementation is
// straight-line because we have indexed access to every vec.
//
// Free fn (not a Router method) because lifecycle methods
// reject `return` per spec/styleguide.md § "Current language
// gaps", and dispatch is naturally a return-bearing helper
// (it returns the Response). Mirrors the Onboard.run / drive
// split in the styleguide canonical example.
fn __router_run_chain(
    entries:   EntryList,
    mws:       MwList,
    ctx:       Context,
    not_found: Handler
) -> Response {
    // Forward middleware sweep.
    let mut cur = ctx;
    let mlen = mws.len();
    let mut i = 0;
    while i < mlen {
        let m = mws.get(i) or raise;
        cur = m.before(cur);
        i = i + 1;
    }

    // Route lookup. First match wins — consumers order more-
    // specific patterns before more-general ones. Matching
    // runs against the query-stripped path (ctx.req.path is
    // the raw request target).
    let path_only = __router_path_only(cur.req.path);
    let mut resp = not_found.handle(cur);
    let rlen = entries.len();
    let mut j = 0;
    while j < rlen {
        let e = entries.get(j) or raise;
        if e.method == cur.req.method {
            // bounded migration (2026-07-02): captures push
            // straight into cur.params' bounded pair; a failed
            // match leaves it cleared, so `cur` is reused across
            // attempts without rebuilding the Context.
            if match_pattern_into(e.pattern, path_only, cur.params) {
                resp = e.handler.handle(cur);
                break;
            }
        }
        j = j + 1;
    }

    // Reverse middleware sweep.
    let mut k = mlen - 1;
    while k >= 0 {
        let m = mws.get(k) or raise;
        resp = m.after(cur, resp);
        k = k - 1;
    }
    return resp;
}

// `__router_to_http(r)` — boundary conversion from the local
// Response shape to std::http::Response. Field-equal copy;
// the Server consumes std::http::Response on the wire side.
fn __router_to_http(r: Response) -> std::http::Response {
    return std::http::Response {
        status:       r.status,
        content_type: r.content_type,
        headers:      r.headers,
        body:         r.body
    };
}

locus Router {
    params {
        // Consumer-overridable 404 handler. Default is a
        // Handler-shaped NotFound404 locus that returns plain
        // "not found" with status 404.
        not_found: Handler = NotFound404 { };
        // Route + middleware storage. Child loci default-
        // initialized at Router birth; their dissolves fire
        // when the Router's enclosing scope exits.
        entries: EntryList = EntryList { };
        mws:     MwList    = MwList    { };
    }

    // `add(method, pattern, h)` — register a route. Method is
    // uppercased on register so consumers can write either case
    // at the call site without affecting match. Pattern is
    // stored as-written. The concrete handler locus coerces to
    // the Handler interface at this method-arg site, then again
    // into the RouteEntry literal's interface-typed field —
    // both coerce sites work at HEAD (2026-06-12).
    fn add(method: String, pattern: String, h: Handler) {
        self.entries.push(RouteEntry {
            method:  std::str::upper(method),
            pattern: pattern,
            handler: h
        });
    }

    // `use(m)` — register a middleware. Contract name restored
    // 2026-06-12: `use` parses as a method name at HEAD (the
    // reserved-word collision the 2026-05-16 `use_mw` rename
    // dodged does not fire in method position).
    fn use(m: Middleware) {
        self.mws.push(m);
    }

    // `dispatch(req)` — public-API entry point for the route
    // lookup. Builds the initial Context (raw Request nested
    // under `req`, query string split into params.qs), runs the
    // middleware-route-middleware chain, returns the
    // std::http::Response (after boundary conversion from the
    // local Response shape).
    fn dispatch(req: std::http::Request) -> std::http::Response {
        let ctx = Context {
            req:    req,
            params: RouteParams {
                qs: __router_query_only(req.path)
            }
        };
        let r = __router_run_chain(
            self.entries, self.mws, ctx, self.not_found
        );
        return __router_to_http(r);
    }

    // `handle(req)` — std::http::Handler satisfaction. Allows
    // `std::http::Server { handler: my_router }` to pass the
    // Router through the Server's interface vtable. Body is a
    // direct delegate to dispatch — the indirection is here
    // so the interface signature matches without callers
    // having to know about the dispatch name.
    fn handle(req: std::http::Request) -> std::http::Response {
        return self.dispatch(req);
    }
}
