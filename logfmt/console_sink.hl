// pond/logfmt — ConsoleSink.
//
// Service locus (catalog pattern 3): the human-facing sibling of
// FileSink. Subscribes to "log.**" and renders each event as a
// colored, aligned console line:
//
//   14:02:07 INFO  app.db connected in 12ms
//   14:02:09 WARN  app    retry 1/3
//   14:02:09 ERROR app.db connect refused
//
// Level badges are colored (cyan/yellow/red, dim for
// debug/trace), the timestamp and logger path render dim, and
// the message stays plain. WARN/ERROR route to stderr — same
// lane split std::log::StdoutSink uses — so `2>/dev/null` and
// shell-pipeline conventions hold.
//
// Color policy:
//   - `color: Bool = true` is the only knob. birth() forces it
//     off when NO_COLOR is set (https://no-color.org).
//   - There is no isatty probe here: that needs an FFI shim and
//     this lib stays FFI-free (G34 also blocks importing
//     pond/term — see FRICTION.md `ansi-helpers-duplicated`).
//     Callers that vendor pond/term pass the probe explicitly:
//
//       logfmt::ConsoleSink { color: term::is_tty(2) };
//
// Like FileSink, the locus also wears the std::text::Sink shape
// (write/line/newline, non-fallible per the interface-binding
// exemption documented on FileSink) so it drop-in replaces
// std::log::StdoutSink at both the log-routing and the
// text-rendering layer. Sink-shape text renders plain (no
// badge) to stdout.

locus ConsoleSink {
    params {
        color: Bool = true;
        show_time: Bool = true;
    }

    bus {
        subscribe "log.**" as on_event of type std::log::LogEvent;
    }

    birth() {
        if std::env::var_exists("NO_COLOR") {
            self.color = false;
        }
    }

    // ----- std::text::Sink-shape methods -----

    fn write(s: String) {
        print(s);
    }

    fn line(s: String) {
        println(s);
    }

    fn newline() {
        println("");
    }

    // ----- Log-event subscriber -----

    fn on_event(e: std::log::LogEvent) {
        let rendered = self.render(e);
        if e.level == 2 || e.level == 3 {
            eprintln(rendered);
        } else {
            println(rendered);
        }
    }

    // One formatted line, sans trailing newline.
    fn render(e: std::log::LogEvent) -> String {
        let mut out = "";
        if self.show_time {
            out = out + self.paint("\x1b[2m", __console_clock()) + " ";
        }
        out = out + self.badge(e.level) + " ";
        if len(e.path) > 0 {
            out = out + self.paint("\x1b[2m", e.path) + " ";
        }
        return out + e.msg;
    }

    // Colored, width-5 level badge.
    fn badge(level: Int) -> String {
        if level == 1 { return self.paint("\x1b[36m", "INFO "); }
        if level == 2 { return self.paint("\x1b[33;1m", "WARN "); }
        if level == 3 { return self.paint("\x1b[31;1m", "ERROR"); }
        if level == 4 { return self.paint("\x1b[2m", "DEBUG"); }
        if level == 5 { return self.paint("\x1b[2m", "TRACE"); }
        return self.paint("\x1b[2m", "LOG  ");
    }

    // Wrap s in an SGR prefix + reset when color is on.
    fn paint(sgr: String, s: String) -> String {
        if !self.color { return s; }
        return sgr + s + "\x1b[0m";
    }
}

// ---- Local helpers ----
//
// `__console_`-prefixed: free fns are seed-global under F.19,
// so internals carry the file's prefix to keep logfmt's shared
// scope clean.

// Wall-clock HH:MM:SS (UTC) from std::time::now() epoch seconds.
fn __console_clock() -> String {
    let now = std::time::now();
    let secs_today = now % 86400;
    let h = secs_today / 3600;
    let m = (secs_today % 3600) / 60;
    let s = secs_today % 60;
    return std::str::pad_left(to_string(h), 2, "0") + ":"
        + std::str::pad_left(to_string(m), 2, "0") + ":"
        + std::str::pad_left(to_string(s), 2, "0");
}
