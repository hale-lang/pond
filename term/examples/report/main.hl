// term/examples/report — Console demo: a stylized build report.
//
// Exercises the whole Console surface: title, rules, kv pairs,
// steps, success/warn/error sigils, bullets. Agent-runnable —
// piped output degrades to clean plain text; on a terminal (or
// under FORCE_COLOR=1) the same binary renders colored.
// warn/error land on stderr (`2>/dev/null` to see the split).
//
// Build + run:
//   hale build term/examples/report/
//   ./term/examples/report/report
//   FORCE_COLOR=1 ./term/examples/report/report

import "../.." as term;

locus ReportDemo {
    run() {
        drive();
    }
}

fn main() {
    ReportDemo { };
}

fn drive() {
    let c = term::Console { };

    c.title("pond build report");
    c.kv("profile", term::profile_name(term::detect_profile()));
    c.kv("terminal", to_string(term::is_tty(1)));

    c.rule("steps");
    c.step(1, 4, "vendor pond into the app");
    c.success("fetched at v0.1.0");
    c.step(2, 4, "build term/");
    c.success("5 shims linked, 0 warnings");
    c.step(3, 4, "build tui/");
    c.warn("unicode width heuristic in use (see FRICTION.log)");
    c.step(4, 4, "run demos");
    c.error("keys demo needs a tty — skipped");

    c.rule("notes");
    c.bullet("ConsoleSink renders std::log events; Console renders app output");
    c.bullet("NO_COLOR / piped stdout degrade to plain text");
    c.rule("");
    // Sink-shape passthrough (write/line/newline) — Console
    // slots anywhere a std::text::Sink is expected.
    c.write("  sink shape: ");
    c.line("write + line OK");
    c.info("report complete");
}
