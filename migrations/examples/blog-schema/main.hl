// blog-schema — pond/migrations end-to-end demo against a REAL
// SQLite database.
//
// Vendored normally the imports look like:
//
//     import "vendor/pond/migrations" as migs;
//     import "vendor/pond/sqlite"     as sqlite;
//     import "vendor/pond/db"         as db;     // Migrator's driver interface
//
// In-tree the example reaches the libs via relative paths. Per
// pond's no-transitive-deps rule (and hale.toml [ffi] auto-pickup,
// which only scans DIRECT imports), the app vendors pond/sqlite
// itself even though only the sqlite::Driver injection touches it.
//
// The demo:
//   1. opens /tmp/pond-migrations-blog-demo.db and drops the demo
//      tables so every run starts fresh (self-cleaning);
//   2. wraps the connection in sqlite::Driver (the
//      db::DbDriver adapter — see ../../../sqlite/driver.hl) and
//      runs a Migrator over it: ensure() + apply v1 + apply v2
//      → 2 applied;
//   3. runs a SECOND Migrator over the same driver — both
//      versions are already recorded, so applied = 0 (re-run is a
//      no-op);
//   4. prints the schema_migrations rows and verifies via
//      sqlite_master that `posts` and `comments` exist.
//
// Migrations are data-driven (version, name, up_sql) per the
// 2026-06-08 contract — the SQL lives inline below, not in .sql
// files scanned from disk.
//
// Build & run (the [ffi] section links libsqlite3):
//     hale build migrations/examples/blog-schema/
//     ./migrations/examples/blog-schema/blog-schema

import "../.." as migs;
import "../../../sqlite" as sqlite;

locus BlogSchemaDemo {
    params {
        db_path: String = "/tmp/pond-migrations-blog-demo.db";
    }

    // One full migration round: fresh Migrator, ensure, apply both
    // versions in order. Returns the number applied this round.
    fn migrate_round(d: sqlite::Driver, label: String) -> Int {
        let m = migs::Migrator { driver: d };
        let _ = m.ensure();
        let _ = m.apply(1, "create_posts", __sql_create_posts());
        let _ = m.apply(2, "add_comments", __sql_add_comments());
        println("[blog-schema] ", label, ": applied=", to_string(m.applied),
                " ok=", to_string(m.ok()),
                " current_version=", to_string(m.current_version()));
        return m.applied;
    }

    run() {
        println("[blog-schema] target db: ", self.db_path);
        let conn = sqlite::Db { path: self.db_path };

        // Self-cleaning: drop everything this demo creates.
        let _ = conn.exec(
            "DROP TABLE IF EXISTS comments; "
            + "DROP TABLE IF EXISTS posts; "
            + "DROP TABLE IF EXISTS schema_migrations"
        ) or sqlite::ExecResult { };

        let d = sqlite::Driver { conn: conn };
        println("[blog-schema] driver backend: ", d.backend(),
                " (open ok=", to_string(d.open().ok), ")");

        // Round 1: both migrations pending → applied = 2.
        let n1 = self.migrate_round(d, "first run");

        // Round 2: same set again → applied = 0 (idempotent).
        let n2 = self.migrate_round(d, "re-run   ");

        // Show the tracking rows (version \t name \t applied_at).
        let tracked = d.query_all(
            "SELECT version, name, applied_at FROM schema_migrations ORDER BY version");
        println("[blog-schema] schema_migrations rows (n=",
                to_string(tracked.n), "):");
        println(tracked.csv);

        // Verify the migrated tables exist for real.
        let tables = conn.query_all(
            "SELECT name FROM sqlite_master WHERE type='table'"
            + " AND name IN ('posts','comments') ORDER BY name"
        ) or sqlite::Rows { csv: "ERR" };
        println("[blog-schema] tables present: ", tables.csv);

        if n1 == 2 && n2 == 0 && tables.csv == "comments\nposts" {
            println("[blog-schema] OK — 2 applied, re-run no-op, both tables exist");
        } else {
            println("[blog-schema] FAIL — unexpected state");
        }
    }
}

// The migration set (forward-only, ascending versions).

fn __sql_create_posts() -> String {
    return "CREATE TABLE posts ("
        + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
        + "title TEXT NOT NULL, "
        + "body TEXT NOT NULL DEFAULT '')";
}

fn __sql_add_comments() -> String {
    return "CREATE TABLE comments ("
        + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
        + "post_id INTEGER NOT NULL REFERENCES posts(id), "
        + "author TEXT NOT NULL, "
        + "body TEXT NOT NULL)";
}

fn main() {
    BlogSchemaDemo { };
}
