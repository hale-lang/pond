// pond/migrations tests — Migrator over sqlite::Driver on a real
// temp-file db.
//
// SCOPE NOTE: Migrator prints to stdout on BOTH the fresh-apply
// success path ("[migrate] applied vN ...") and the failure paths
// ("[migrate] FAILED ..." / "ensure FAILED"), and a passing test
// must be silent (spec/testing.md: pass = exit 0 + empty stdout).
// Those paths therefore cannot be exercised in-process here — the
// blog-schema example remains their gate. This test covers every
// SILENT contract surface:
//
//   - ensure() creates the tracking table (true, and the table
//     really exists)
//   - current_version() reads 0 on fresh, max(version) once rows
//     exist
//   - apply() of an already-recorded version is a no-op skip:
//     returns true, applied stays 0, ok() stays true, and the
//     migration SQL does NOT run
//   - the sticky failure latch: a failed Migrator skips every
//     later apply() (returns false, nothing applied)
//
// Run:
//   C_INCLUDE_PATH=$HOME/.local/include LIBRARY_PATH=$HOME/.local/lib \
//     hale test migrations/

import ".." as migs;
import "../../sqlite" as sqlite;

fn main() {
    let path = "/tmp/pond_test_migrations_migrator.db";
    std::io::fs::unlink(path) or discard;

    let conn = sqlite::Db { path: path };
    let d = sqlite::Driver { conn: conn };
    let m = migs::Migrator { driver: d };

    // ---- ensure: tracking table bringup ----
    std::test::assert(m.ensure(), "ensure() returns true");
    let t = d.query_one(
        "SELECT name FROM sqlite_master WHERE type='table'"
        + " AND name='schema_migrations'");
    std::test::assert(t.ok, "tracking table exists after ensure");
    std::test::assert_eq_str(t.data, "schema_migrations", "tracking table name");
    std::test::assert_eq_int(m.current_version(), 0, "fresh db is at version 0");

    // Seed two recorded versions directly (the sqlite applied_at
    // default from ensure() fills the timestamp). Going through
    // m.apply() here would print on success — see SCOPE NOTE.
    let s1 = d.exec("INSERT INTO schema_migrations (version, name)"
        + " VALUES (1, 'create_posts')");
    std::test::assert(s1.ok, "seed v1 recorded");
    let s2 = d.exec("INSERT INTO schema_migrations (version, name)"
        + " VALUES (2, 'add_comments')");
    std::test::assert(s2.ok, "seed v2 recorded");
    std::test::assert_eq_int(m.current_version(), 2, "current_version reads max");

    // ---- re-run is a no-op: recorded versions skip silently ----
    std::test::assert(m.apply(1, "create_posts", "CREATE TABLE posts (id int)"),
        "re-apply of v1 skips with true");
    std::test::assert(m.apply(2, "add_comments", "CREATE TABLE comments (id int)"),
        "re-apply of v2 skips with true");
    std::test::assert_eq_int(m.applied, 0, "no-op run applied 0");
    std::test::assert(m.ok(), "no-op run stays ok");
    // ...and the skipped migrations' SQL really did not execute.
    let ghost = d.query_one(
        "SELECT count(*) FROM sqlite_master WHERE type='table'"
        + " AND name IN ('posts','comments')");
    std::test::assert_eq_str(ghost.data, "0", "skipped migrations run no SQL");

    // ---- sticky failure latch ----
    let mf = migs::Migrator { driver: d, failed: true };
    std::test::assert(!mf.apply(3, "later", "CREATE TABLE later (id int)"),
        "failed migrator refuses further applies");
    std::test::assert(!mf.ok(), "failed migrator reports not-ok");
    std::test::assert_eq_int(mf.applied, 0, "failed migrator applies nothing");
    let ghost2 = d.query_one(
        "SELECT count(*) FROM sqlite_master WHERE name='later'");
    std::test::assert_eq_str(ghost2.data, "0", "latched apply ran no SQL");
}
