// pond/migrations — forward-only schema migrations over db::DbDriver.
//
// Rewritten (2026-05-29) onto the pond/db driver interface. The
// prior version was dir-based and hard-coupled to the (stubbed)
// pond/sqlite free-fn surface, and carried codegen-quirk
// workarounds ("can't hold a Db locus param", free-fn-only) that
// are now obsolete — a locus holds a `db::DbDriver` slot and calls
// methods directly (verified in fathom/apps/smoke-db, smoke-pq).
//
// **Model.** Migrations are supplied by the caller as
// (version, name, up_sql), applied in ascending version order.
// `apply()` records each in `schema_migrations` and skips any
// version <= the recorded max — so re-running the full set is a
// no-op (idempotent). Data-driven rather than directory-scanning:
// an app embeds its ordered migration calls (no fs/embed needed),
// and it works against ANY backend the DbDriver covers (postgres,
// sqlite-when-unblocked, in-memory).
//
// **Atomicity.** Each migration is sent as one multi-statement
// simple query (`<up_sql>; INSERT INTO schema_migrations ...`).
// Postgres runs a multi-statement Query as a single implicit
// transaction with NO explicit BEGIN, so a failing statement
// rolls the whole migration back and returns the connection to
// idle (avoids the aborted-transaction trap an explicit
// BEGIN/COMMIT-in-one-Query would create).
//
// **Forward-only.** No down migrations in v0 — reversal is a new
// forward migration (down migrations are a footgun against a live
// authority DB and almost never run).

import "../db" as db;

locus Migrator {
    params {
        driver:   db::DbDriver;
        applied:  Int    = 0;     // count applied this run
        failed:   Bool   = false; // sticky: once a migration fails, skip the rest
        last_err: String = "";
    }

    // ensure — create the tracking table if absent. Call once
    // before the apply() sequence. The applied_at default is the
    // one piece of backend-specific DDL: postgres gets a real
    // timestamptz; sqlite (no now(), no timestamptz) gets an ISO
    // text stamp via strftime.
    fn ensure() -> Bool {
        let mut applied_at_ddl = "applied_at timestamptz NOT NULL DEFAULT now()";
        if self.driver.backend() == "sqlite" {
            applied_at_ddl = "applied_at text NOT NULL"
                + " DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ','now'))";
        }
        let e = self.driver.exec(
            "CREATE TABLE IF NOT EXISTS schema_migrations ("
            + "version int PRIMARY KEY, "
            + "name text NOT NULL, "
            + applied_at_ddl + ")");
        if !e.ok {
            self.failed = true;
            self.last_err = "ensure: " + e.err.detail;
            println("[migrate] ensure FAILED: ", e.err.detail);
        }
        return e.ok;
    }

    // current_version — highest applied version, 0 if none.
    fn current_version() -> Int {
        let r = self.driver.query_one(
            "SELECT coalesce(max(version),0) FROM schema_migrations");
        if !r.ok { return 0; }
        return std::str::parse_int(r.data) or 0;
    }

    // apply — run migration `version` if newer than the recorded
    // max. Idempotent: version <= current is a skip (returns true).
    // Latches `failed` on error so later apply()s in the sequence
    // no-op (forward progress stops at the first failure).
    fn apply(version: Int, name: String, up_sql: String) -> Bool {
        if self.failed { return false; }
        let cur = self.current_version();
        if version <= cur {
            return true;
        }
        let sql = up_sql
            + "; INSERT INTO schema_migrations (version, name) VALUES ("
            + to_string(version) + ", '" + name + "')";
        let e = self.driver.exec(sql);
        if !e.ok {
            self.failed = true;
            self.last_err = "v" + to_string(version) + " " + name + ": " + e.err.detail;
            println("[migrate] FAILED v", version, " ", name, ": ", e.err.detail);
            return false;
        }
        self.applied = self.applied + 1;
        println("[migrate] applied v", version, " ", name);
        return true;
    }

    fn ok() -> Bool { return !self.failed; }
}
