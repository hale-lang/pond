// pond/tui — Screen: cell grid + diff renderer.
//
// Front/back buffers of Cell records over @form(vec); widgets
// and App.view() write cells; flush() diffs against the
// previous frame and emits minimal escape sequences (cursor
// moves only on discontinuity, SGR only on style change) into
// a reusable BytesBuilder, then writes the frame in one
// write(2). Wrapped in DEC 2026 synchronized-update so the
// terminal repaints once per frame.
//
// Steady-state allocation: the frame builder and both grids
// are locus fields reused across frames (F.28/F.29 builder
// discipline) — per-frame transients (to_string of cursor
// coords) live in flush()'s method scratch and reclaim at
// return.
//
// Coordinates are 0-based x (column), y (row). Color values use
// the same one-Int encoding as pond/term: -1 default, 0..255
// palette, 16777216+rgb truecolor. attrs is a bitmask:
// 1 bold, 2 dim, 4 italic, 8 underline, 16 reverse, 32 strike.

type Cell {
    ch: Int = 32;     // codepoint; 0 = wide-char continuation
    fg: Int = -1;
    bg: Int = -1;
    attrs: Int = 0;
}

@form(vec)
locus CellVec {
    capacity { heap items of Cell; }
}

locus Screen {
    params {
        w: Int = 0;
        h: Int = 0;
        cells: CellVec = CellVec { };
        prev: CellVec = CellVec { };
        frame: std::bytes::BytesBuilder
            = std::bytes::BytesBuilder { initial_cap: 16384 };
        full_redraw: Bool = true;
        cursor_x: Int = -1;     // -1 = hidden
        cursor_y: Int = -1;
        // SGR emit state, valid during one flush().
        cur_fg: Int = -999;
        cur_bg: Int = -999;
        cur_attrs: Int = -1;
    }

    // Grow the grids to w*h (vec capacity is monotonic — no
    // shrink; the logical size is w*h). Forces a full redraw.
    fn resize(w: Int, h: Int) {
        self.w = w;
        self.h = h;
        let needed = w * h;
        while self.cells.len() < needed {
            self.cells.push(Cell { });
            self.prev.push(Cell { });
        }
        // Stale prev cells would suppress redraw after shrink/
        // grow cycles; full_redraw repaints everything once.
        self.full_redraw = true;
    }

    // Blank every cell (space, default colors).
    fn clear() {
        let n = self.w * self.h;
        let mut i = 0;
        while i < n {
            self.cells.set(i, Cell { }) or discard;
            i = i + 1;
        }
    }

    fn set_cell(x: Int, y: Int, ch: Int, fg: Int, bg: Int, attrs: Int) {
        if x < 0 || y < 0 || x >= self.w || y >= self.h { return; }
        let mut cp = ch;
        if cp < 32 && cp != 0 { cp = 32; }   // control chars would tear the frame
        self.cells.set(y * self.w + x,
            Cell { ch: cp, fg: fg, bg: bg, attrs: attrs }) or discard;
    }

    // Write a string starting at (x, y), clipped at the right
    // edge. Decodes UTF-8; wide codepoints occupy two cells
    // (the second marked ch=0).
    fn put(x: Int, y: Int, s: String, fg: Int, bg: Int, attrs: Int) {
        let n = len(s);
        let mut i = 0;
        let mut cx = x;
        while i < n {
            if cx >= self.w { return; }
            let b = std::str::byte_at_unchecked(s, i);
            let mut cp = b;
            let mut sz = 1;
            if b >= 240 {
                sz = 4;
            } else if b >= 224 {
                sz = 3;
            } else if b >= 192 {
                sz = 2;
            }
            if i + sz > n { return; }   // truncated tail — stop
            if sz == 2 {
                cp = (b - 192) * 64
                    + (std::str::byte_at_unchecked(s, i + 1) - 128);
            }
            if sz == 3 {
                cp = ((b - 224) * 64
                    + (std::str::byte_at_unchecked(s, i + 1) - 128)) * 64
                    + (std::str::byte_at_unchecked(s, i + 2) - 128);
            }
            if sz == 4 {
                cp = (((b - 240) * 64
                    + (std::str::byte_at_unchecked(s, i + 1) - 128)) * 64
                    + (std::str::byte_at_unchecked(s, i + 2) - 128)) * 64
                    + (std::str::byte_at_unchecked(s, i + 3) - 128);
            }
            let wdt = char_width(cp);
            if wdt > 0 {
                self.set_cell(cx, y, cp, fg, bg, attrs);
                if wdt == 2 {
                    if cx + 1 < self.w {
                        self.set_cell(cx + 1, y, 0, fg, bg, attrs);
                    }
                }
                cx = cx + wdt;
            }
            i = i + sz;
        }
    }

    // Plain-style convenience.
    fn print(x: Int, y: Int, s: String) {
        self.put(x, y, s, -1, -1, 0);
    }

    // Fill a rect with a blank cell of the given background.
    fn fill(x: Int, y: Int, w: Int, h: Int, bg: Int) {
        let mut yy = y;
        while yy < y + h {
            let mut xx = x;
            while xx < x + w {
                self.set_cell(xx, yy, 32, -1, bg, 0);
                xx = xx + 1;
            }
            yy = yy + 1;
        }
    }

    fn set_cursor(x: Int, y: Int) {
        self.cursor_x = x;
        self.cursor_y = y;
    }

    fn hide_cursor() {
        self.cursor_x = -1;
        self.cursor_y = -1;
    }

    // Diff against the previous frame and write the delta to
    // stdout in one syscall.
    fn flush() {
        self.frame.clear();
        self.frame.append_str("\x1b[?2026h");
        self.cur_fg = -999;
        self.cur_bg = -999;
        self.cur_attrs = -1;
        if self.full_redraw {
            self.frame.append_str("\x1b[0m\x1b[2J");
        }

        let mut pend_x = -2;   // terminal cursor after last emit
        let mut pend_y = -2;
        let mut y = 0;
        while y < self.h {
            let mut x = 0;
            while x < self.w {
                let idx = y * self.w + x;
                let c = self.cells.get(idx) or Cell { };
                let p = self.prev.get(idx) or Cell { };
                let mut dirty = self.full_redraw;
                if !dirty {
                    if c.ch != p.ch || c.fg != p.fg
                        || c.bg != p.bg || c.attrs != p.attrs {
                        dirty = true;
                    }
                }
                if dirty && c.ch != 0 {
                    if pend_x != x || pend_y != y {
                        self.frame.append_str("\x1b["
                            + to_string(y + 1) + ";"
                            + to_string(x + 1) + "H");
                    }
                    self.emit_sgr(c.fg, c.bg, c.attrs);
                    append_codepoint(self.frame, c.ch);
                    pend_x = x + char_width(c.ch);
                    pend_y = y;
                }
                self.prev.set(idx, c) or discard;
                x = x + 1;
            }
            y = y + 1;
        }

        self.frame.append_str("\x1b[0m");
        if self.cursor_x >= 0 {
            self.frame.append_str("\x1b["
                + to_string(self.cursor_y + 1) + ";"
                + to_string(self.cursor_x + 1) + "H\x1b[?25h");
        }
        self.frame.append_str("\x1b[?2026l");
        self.full_redraw = false;

        // clone(): @ffi String params take exactly String —
        // StringView deliberately does NOT coerce there (no NUL
        // at a view's end; hale #105 confirmed + documented in
        // spec/ffi.md). The clone IS the correct shape; the
        // zero-copy alternative is a StringView-typed extern.
        // See FRICTION.md `frame-clone-per-flush`.
        tui_write_stdout(std::str::clone(self.frame.text_view()));
    }

    // Emit an SGR run only when style changes between cells.
    fn emit_sgr(fg: Int, bg: Int, attrs: Int) {
        if fg == self.cur_fg && bg == self.cur_bg
            && attrs == self.cur_attrs {
            return;
        }
        self.frame.append_str("\x1b[0m");
        if (attrs & 1) != 0 { self.frame.append_str("\x1b[1m"); }
        if (attrs & 2) != 0 { self.frame.append_str("\x1b[2m"); }
        if (attrs & 4) != 0 { self.frame.append_str("\x1b[3m"); }
        if (attrs & 8) != 0 { self.frame.append_str("\x1b[4m"); }
        if (attrs & 16) != 0 { self.frame.append_str("\x1b[7m"); }
        if (attrs & 32) != 0 { self.frame.append_str("\x1b[9m"); }
        if fg >= 0 { self.frame.append_str(__color_sgr(38, fg)); }
        if bg >= 0 { self.frame.append_str(__color_sgr(48, bg)); }
        self.cur_fg = fg;
        self.cur_bg = bg;
        self.cur_attrs = attrs;
    }
}

// ---- Rendering helpers (free fns) ----

// Truecolor pack — same encoding as pond/term.
fn rgb(r: Int, g: Int, b: Int) -> Int {
    return 16777216 + r * 65536 + g * 256 + b;
}

// SGR fragment for one color channel (38 fg / 48 bg).
fn __color_sgr(base: Int, c: Int) -> String {
    if c >= 16777216 {
        let v = c - 16777216;
        return "\x1b[" + to_string(base) + ";2;"
            + to_string(v / 65536) + ";"
            + to_string((v / 256) % 256) + ";"
            + to_string(v % 256) + "m";
    }
    return "\x1b[" + to_string(base) + ";5;" + to_string(c) + "m";
}

// Append cp's UTF-8 bytes to the builder.
fn append_codepoint(b: std::bytes::BytesBuilder, cp: Int) {
    if cp < 128 {
        b.append_u8(cp);
        return;
    }
    if cp < 2048 {
        b.append_u8(192 + cp / 64);
        b.append_u8(128 + cp % 64);
        return;
    }
    if cp < 65536 {
        b.append_u8(224 + cp / 4096);
        b.append_u8(128 + (cp / 64) % 64);
        b.append_u8(128 + cp % 64);
        return;
    }
    b.append_u8(240 + cp / 262144);
    b.append_u8(128 + (cp / 4096) % 64);
    b.append_u8(128 + (cp / 64) % 64);
    b.append_u8(128 + cp % 64);
}

// Display width of a codepoint: 0 (combining / zero-width /
// continuation), 1, or 2 (East Asian Wide / Fullwidth, incl.
// emoji presentation). ASCII short-circuits; everything else
// consults the generated full-Unicode table (width.hl —
// regenerate via tools/gen_width_table.py).
fn char_width(cp: Int) -> Int {
    if cp == 0 { return 0; }       // wide-cell continuation marker
    if cp < 32 { return 1; }       // controls (set_cell clamps these)
    if cp < 127 { return 1; }      // ASCII fast path
    return width_lookup(cp);
}
