// pond/tui — @ffi externs over glue.c.
//
// `tui_`-prefixed C symbols; see glue.c's header for why these
// duplicate pond/term's shims instead of importing them.

@ffi("c") fn tui_isatty(fd: Int) -> Int;
@ffi("c") fn tui_raw_enable() -> Int;
@ffi("c") fn tui_raw_disable() -> Int;
@ffi("c") fn tui_size_packed() -> Int;
@ffi("c") fn tui_write_stdout(s: String) -> Int;
@ffi("c") fn tui_read_byte(timeout_ms: Int) -> Int;
