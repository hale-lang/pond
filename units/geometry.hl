// Exact unit catalogue. Source definitions and spelling policy: README.md.
// No quantity types or rounding policies are imposed by this seed.

// International customary length; US liquid volumes; imperial volumes.
// rad and degree intentionally have no rational edge (pi is irrational).
unit inch = 127 / 5000 m; // international inch (length).
unit ft = 12 inch; // international foot (length).
unit yd = 3 ft; // international yard (length).
unit mi = 5280 ft; // international statute mile (length).
unit nmi = 1852 m; // nautical mile (length).
unit fathom = 6 ft; // international fathom (length).
unit angstrom = 1 / 10 nm; // angstrom (atomic-scale length).
unit au = 149597870700 m; // astronomical unit (length).
unit m2; // square metre (area).
unit mm2 = 1 / 1000000 m2; // square millimetre (area).
unit cm2 = 1 / 10000 m2; // square centimetre (area).
unit dm2 = 1 / 100 m2; // square decimetre (area).
unit km2 = 1000000 m2; // square kilometre (area).
unit um2 = 1 / 1000000 mm2; // square micrometre (area).
unit nm2 = 1 / 1000000 um2; // square nanometre (area).
unit pm2 = 1 / 1000000 nm2; // square picometre (area).
unit angstrom2 = 1 / 100 nm2; // square angstrom (area).
unit barn = 1 / 10000 pm2; // barn (area, commonly a nuclear cross section).
unit in2 = 16129 / 2500 cm2; // square international inch (area).
unit ft2 = 144 in2; // square international foot (area).
unit yd2 = 9 ft2; // square international yard (area).
unit mi2 = 27878400 ft2; // square international statute mile (area).
unit ha = 10000 m2; // hectare (area).
unit acre = 43560 ft2; // international acre (area).
unit m3; // cubic metre (volume).
unit mm3 = 1 / 1000000000 m3; // cubic millimetre (volume).
unit cm3 = 1 / 1000000 m3; // cubic centimetre (volume).
unit dm3 = 1 / 1000 m3; // cubic decimetre (volume).
unit km3 = 1000000000 m3; // cubic kilometre (volume).
unit L = 1 dm3; // litre (volume).
unit in3 = 2048383 / 125000 cm3; // cubic international inch (volume).
unit ft3 = 1728 in3; // cubic international foot (volume).
unit yd3 = 27 ft3; // cubic international yard (volume).
unit acre_ft = 43560 ft3; // acre-foot using the international foot (volume).
unit gal_us = 231 in3; // US liquid gallon (volume).
unit qt_us = 1 / 4 gal_us; // US liquid quart (volume).
unit pt_us = 1 / 2 qt_us; // US liquid pint (volume).
unit cup_us = 1 / 2 pt_us; // US customary cup, eight US fluid ounces (volume).
unit floz_us = 1 / 8 cup_us; // US fluid ounce (volume).
unit tbsp_us = 1 / 2 floz_us; // US customary tablespoon (volume).
unit tsp_us = 1 / 3 tbsp_us; // US customary teaspoon (volume).
unit gal_imp = 454609 / 100000 L; // imperial gallon (volume).
unit qt_imp = 1 / 4 gal_imp; // imperial quart (volume).
unit pt_imp = 1 / 2 qt_imp; // imperial pint (volume).
unit floz_imp = 1 / 20 pt_imp; // imperial fluid ounce (volume).
unit degree; // degree (plane angle).
unit arcmin = 1 / 60 degree; // arcminute, one sixtieth of a degree (plane angle).
unit arcsec = 1 / 60 arcmin; // arcsecond, one sixtieth of an arcminute (plane angle).
unit turn = 360 degree; // full revolution (plane angle).
unit gradian = 9 / 10 degree; // gradian, one hundredth of a right angle (plane angle).
unit dL = 1 / 10 L; // decilitre (volume).
unit cL = 1 / 10 dL; // centilitre (volume).
unit mL = 1 / 10 cL; // millilitre (volume).
unit uL = 1 / 1000 mL; // microlitre (volume).
unit nL = 1 / 1000 uL; // nanolitre (volume).
unit pL = 1 / 1000 nL; // picolitre (volume).
unit fL = 1 / 1000 pL; // femtolitre (volume).
unit aL = 1 / 1000 fL; // attolitre (volume).
unit zL = 1 / 1000 aL; // zeptolitre (volume).
unit yL = 1 / 1000 zL; // yoctolitre (volume).
unit rL = 1 / 1000 yL; // rontolitre (volume).
unit qL = 1 / 1000 rL; // quectolitre (volume).
unit daL = 10 L; // decalitre (volume).
unit hL = 10 daL; // hectolitre (volume).
unit kL = 10 hL; // kilolitre (volume).
unit ML = 1000 kL; // megalitre (volume).
unit GL = 1000 ML; // gigalitre (volume).
unit TL = 1000 GL; // teralitre (volume).
unit PL = 1000 TL; // petalitre (volume).
unit EL = 1000 PL; // exalitre (volume).
unit ZL = 1000 EL; // zettalitre (volume).
unit YL = 1000 ZL; // yottalitre (volume).
unit RL = 1000 YL; // ronnalitre (volume).
unit QL = 1000 RL; // quettalitre (volume).
