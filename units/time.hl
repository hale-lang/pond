// Exact unit catalogue. Source definitions and spelling policy: README.md.
// No quantity types or rounding policies are imposed by this seed.

// ns, us, ms, s, min, h and day belong to the stdlib; never redeclare them.
// asec is attosecond: as is the import-alias keyword. A week is exactly 7 fixed days.
unit ds = 1 / 10 s; // decisecond (duration).
unit cs = 1 / 10 ds; // centisecond (duration).
unit ps = 1 / 1000 ns; // picosecond (duration).
unit fs = 1 / 1000 ps; // femtosecond (duration).
unit asec = 1 / 1000 fs; // attosecond (duration).
unit zs = 1 / 1000 asec; // zeptosecond (duration).
unit ys = 1 / 1000 zs; // yoctosecond (duration).
unit rs = 1 / 1000 ys; // rontosecond (duration).
unit qs = 1 / 1000 rs; // quectosecond (duration).
unit das = 10 s; // decasecond (duration).
unit hs = 10 das; // hectosecond (duration).
unit ks = 10 hs; // kilosecond (duration).
unit Ms = 1000 ks; // megasecond (duration).
unit Gs = 1000 Ms; // gigasecond (duration).
unit Ts = 1000 Gs; // terasecond (duration).
unit Ps = 1000 Ts; // petasecond (duration).
unit Es = 1000 Ps; // exasecond (duration).
unit Zs = 1000 Es; // zettasecond (duration).
unit Ys = 1000 Zs; // yottasecond (duration).
unit Rs = 1000 Ys; // ronnasecond (duration).
unit Qs = 1000 Rs; // quettasecond (duration).
unit week = 7 day; // week, seven fixed 24-hour days (duration).
