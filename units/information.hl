// Exact unit catalogue. Source definitions and spelling policy: README.md.
// No quantity types or rounding policies are imposed by this seed.

unit bit; // bit (information).
unit B = 8 bit; // byte (information).
unit kbit = 1000 bit; // kilobit (information; decimal prefix).
unit Mbit = 1000 kbit; // megabit (information; decimal prefix).
unit Gbit = 1000 Mbit; // gigabit (information; decimal prefix).
unit Tbit = 1000 Gbit; // terabit (information; decimal prefix).
unit Pbit = 1000 Tbit; // petabit (information; decimal prefix).
unit Ebit = 1000 Pbit; // exabit (information; decimal prefix).
unit kB = 1000 B; // kilobyte (information; decimal prefix).
unit MB = 1000 kB; // megabyte (information; decimal prefix).
unit GB = 1000 MB; // gigabyte (information; decimal prefix).
unit TB = 1000 GB; // terabyte (information; decimal prefix).
unit PB = 1000 TB; // petabyte (information; decimal prefix).
unit EB = 1000 PB; // exabyte (information; decimal prefix).
unit ZB = 1000 EB; // zettabyte (information; decimal prefix).
unit YB = 1000 ZB; // yottabyte (information; decimal prefix).
unit RB = 1000 YB; // ronnabyte (information; decimal prefix).
unit QB = 1000 RB; // quettabyte (information; decimal prefix).
unit Zbit = 1000 Ebit; // zettabit (information; decimal prefix).
unit Ybit = 1000 Zbit; // yottabit (information; decimal prefix).
unit Rbit = 1000 Ybit; // ronnabit (information; decimal prefix).
unit Qbit = 1000 Rbit; // quettabit (information; decimal prefix).
unit Kibit = 1024 bit; // kibibit (information; binary prefix).
unit Mibit = 1024 Kibit; // mebibit (information; binary prefix).
unit Gibit = 1024 Mibit; // gibibit (information; binary prefix).
unit Tibit = 1024 Gibit; // tebibit (information; binary prefix).
unit Pibit = 1024 Tibit; // pebibit (information; binary prefix).
unit Eibit = 1024 Pibit; // exbibit (information; binary prefix).
unit KiB = 1024 B; // kibibyte (information; binary prefix).
unit MiB = 1024 KiB; // mebibyte (information; binary prefix).
unit GiB = 1024 MiB; // gibibyte (information; binary prefix).
unit TiB = 1024 GiB; // tebibyte (information; binary prefix).
unit PiB = 1024 TiB; // pebibyte (information; binary prefix).
unit EiB = 1024 PiB; // exbibyte (information; binary prefix).
unit ZiB = 1024 EiB; // zebibyte (information; binary prefix).
unit YiB = 1024 ZiB; // yobibyte (information; binary prefix).
unit RiB = 1024 YiB; // robibyte (information; binary prefix).
unit QiB = 1024 RiB; // quebibyte (information; binary prefix).
unit Zibit = 1024 Eibit; // zebibit (information; binary prefix).
unit Yibit = 1024 Zibit; // yobibit (information; binary prefix).
unit Ribit = 1024 Yibit; // robibit (information; binary prefix).
unit Qibit = 1024 Ribit; // quebibit (information; binary prefix).
unit one = 1; // one, the unit of a dimensionless ratio.
unit pct = 1 / 100 one; // percent, one part in a hundred.
unit permille = 1 / 1000 one; // per mille, one part in a thousand.
unit bp = 1 / 10000 one; // basis point, one part in ten thousand.
unit ppm = 1 / 1000000 one; // parts per million (dimensionless ratio).
unit ppb = 1 / 1000000000 one; // parts per billion, one part in a thousand million (dimensionless ratio).
