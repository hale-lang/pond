// Exact unit catalogue. Source definitions and spelling policy: README.md.
// No quantity types or rounding policies are imposed by this seed.

// Compound spellings name independent components; no dimensional products.
// Density is mass / mixture volume. Molality is amount / solvent mass.
// No composition-dependent or empirical conversion is asserted.
unit mol_per_m3; // mole per cubic metre (amount concentration).
unit mol_per_L = 1000 mol_per_m3; // mole per litre (amount concentration).
unit mmol_per_L = 1 / 1000 mol_per_L; // millimole per litre (amount concentration).
unit umol_per_L = 1 / 1000 mmol_per_L; // micromole per litre (amount concentration).
unit nmol_per_L = 1 / 1000 umol_per_L; // nanomole per litre (amount concentration).
unit mmol_per_m3 = 1 / 1000 mol_per_m3; // millimole per cubic metre (amount concentration).
unit mol_per_mL = 1000 mol_per_L; // mole per millilitre (amount concentration).
unit mmol_per_mL = 1 / 1000 mol_per_mL; // millimole per millilitre (amount concentration).
unit umol_per_mL = 1 / 1000 mmol_per_mL; // micromole per millilitre (amount concentration).
unit kg_per_m3; // kilogram per cubic metre (density or mass concentration).
unit g_per_L = 1 kg_per_m3; // gram per litre (density or mass concentration).
unit mg_per_mL = 1 g_per_L; // milligram per millilitre (density or mass concentration).
unit g_per_cm3 = 1000 kg_per_m3; // gram per cubic centimetre (density or mass concentration).
unit g_per_m3 = 1 / 1000 kg_per_m3; // gram per cubic metre (density or mass concentration).
unit mg_per_L = 1 g_per_m3; // milligram per litre (density or mass concentration).
unit ug_per_L = 1 / 1000 mg_per_L; // microgram per litre (density or mass concentration).
unit lb_per_ft3 = 28349523125 / 1769802912 kg_per_m3; // avoirdupois pound per cubic international foot (density).
unit mol_per_kg; // mole per kilogram of solvent (molality).
unit mmol_per_kg = 1 / 1000 mol_per_kg; // millimole per kilogram of solvent (molality).
unit umol_per_kg = 1 / 1000 mmol_per_kg; // micromole per kilogram of solvent (molality).
unit mol_per_g = 1000 mol_per_kg; // mole per gram of solvent (molality).
unit mmol_per_g = 1 mol_per_kg; // millimole per gram of solvent (molality).
unit umol_per_g = 1 mmol_per_kg; // micromole per gram of solvent (molality).
unit kg_per_mol; // kilogram per mole (molar mass).
unit g_per_mol = 1 / 1000 kg_per_mol; // gram per mole (molar mass).
unit mg_per_mol = 1 / 1000 g_per_mol; // milligram per mole (molar mass).
unit kg_per_kmol = 1 g_per_mol; // kilogram per kilomole (molar mass).
unit m3_per_mol; // cubic metre per mole (molar volume).
unit L_per_mol = 1 / 1000 m3_per_mol; // litre per mole (molar volume).
unit mL_per_mol = 1 / 1000 L_per_mol; // millilitre per mole (molar volume).
unit m3_per_kmol = 1 L_per_mol; // cubic metre per kilomole (molar volume).
unit enzyme_unit = 50 / 3 nkat; // enzyme unit, one micromole converted per minute (catalytic activity).
unit entity = 250000000 / 150553519 ymol; // one specified entity (amount of substance).
unit e_charge = 801088317 / 5000000000 aC; // elementary charge, the positive magnitude of an electron's charge.
unit Da; // dalton, also called the unified atomic mass unit (mass).
unit kDa = 1000 Da; // kilodalton (mass).
unit MDa = 1000 kDa; // megadalton (mass).
unit GDa = 1000 MDa; // gigadalton (mass).
unit J_per_mol; // joule per mole (molar energy).
unit kJ_per_mol = 1000 J_per_mol; // kilojoule per mole (molar energy).
unit cal_th_per_mol = 523 / 125 J_per_mol; // thermochemical calorie per mole (molar energy).
unit J_per_K; // joule per kelvin (heat capacity).
