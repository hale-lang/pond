unit J_per_kg_K; // joule per kilogram per kelvin (specific heat capacity).
unit kJ_per_kg_K = 1000 J_per_kg_K; // kilojoule per kilogram per kelvin (specific heat capacity).
unit J_per_g_K = 1000 J_per_kg_K; // joule per gram per kelvin (specific heat capacity).
unit cal_th_per_g_K = 4184 J_per_kg_K; // thermochemical calorie per gram per kelvin (specific heat capacity).
unit J_per_mol_K; // joule per mole per kelvin (molar heat capacity).
