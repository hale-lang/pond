    std::test::assert(right_35 == left_35, "prefix_conductance/base_anchor_TS: reverse");
    std::test::assert_eq_int(left_35 / 1S, k * 1000000000000, "prefix_conductance/base_anchor_TS: target count");
    std::test::assert_eq_int(right_35 / 1TS, k * 1, "prefix_conductance/base_anchor_TS: source count");

    // 1 PS = 1000000000000000 S
    let source_36: Denomination3 = 1PS;
    let target_36: Denomination6 = 1000000000000000S;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_conductance/base_anchor_PS: forward");
    std::test::assert(right_36 == left_36, "prefix_conductance/base_anchor_PS: reverse");
    std::test::assert_eq_int(left_36 / 1S, k * 1000000000000000, "prefix_conductance/base_anchor_PS: target count");
    std::test::assert_eq_int(right_36 / 1PS, k * 1, "prefix_conductance/base_anchor_PS: source count");

    // 1 ES = 1000000000000000000 S
    let source_37: Denomination0 = 1ES;
    let target_37: Denomination6 = 1000000000000000000S;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_conductance/base_anchor_ES: forward");
    std::test::assert(right_37 == left_37, "prefix_conductance/base_anchor_ES: reverse");
    std::test::assert_eq_int(left_37 / 1S, k * 1000000000000000000, "prefix_conductance/base_anchor_ES: target count");
    std::test::assert_eq_int(right_37 / 1ES, k * 1, "prefix_conductance/base_anchor_ES: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
