    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_voltage/base_anchor_PV: forward");
    std::test::assert(right_36 == left_36, "prefix_voltage/base_anchor_PV: reverse");
    std::test::assert_eq_int(left_36 / 1V, k * 1000000000000000, "prefix_voltage/base_anchor_PV: target count");
    std::test::assert_eq_int(right_36 / 1PV, k * 1, "prefix_voltage/base_anchor_PV: source count");

    // 1 EV = 1000000000000000000 V
    let source_37: Denomination0 = 1EV;
    let target_37: Denomination7 = 1000000000000000000V;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_voltage/base_anchor_EV: forward");
    std::test::assert(right_37 == left_37, "prefix_voltage/base_anchor_EV: reverse");
    std::test::assert_eq_int(left_37 / 1V, k * 1000000000000000000, "prefix_voltage/base_anchor_EV: target count");
    std::test::assert_eq_int(right_37 / 1EV, k * 1, "prefix_voltage/base_anchor_EV: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
