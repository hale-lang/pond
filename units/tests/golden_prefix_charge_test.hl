    let target_36: Denomination0 = 1000000000000000C;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_charge/base_anchor_PC: forward");
    std::test::assert(right_36 == left_36, "prefix_charge/base_anchor_PC: reverse");
    std::test::assert_eq_int(left_36 / 1C, k * 1000000000000000, "prefix_charge/base_anchor_PC: target count");
    std::test::assert_eq_int(right_36 / 1PC, k * 1, "prefix_charge/base_anchor_PC: source count");

    // 1 EC = 1000000000000000000 C
    let source_37: Denomination1 = 1EC;
    let target_37: Denomination0 = 1000000000000000000C;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_charge/base_anchor_EC: forward");
    std::test::assert(right_37 == left_37, "prefix_charge/base_anchor_EC: reverse");
    std::test::assert_eq_int(left_37 / 1C, k * 1000000000000000000, "prefix_charge/base_anchor_EC: target count");
    std::test::assert_eq_int(right_37 / 1EC, k * 1, "prefix_charge/base_anchor_EC: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
