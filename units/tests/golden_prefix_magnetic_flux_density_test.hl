    std::test::assert(right_33 == left_33, "prefix_magnetic_flux_density/base_anchor_MT: reverse");
    std::test::assert_eq_int(left_33 / 1T, k * 1000000, "prefix_magnetic_flux_density/base_anchor_MT: target count");
    std::test::assert_eq_int(right_33 / 1MT, k * 1, "prefix_magnetic_flux_density/base_anchor_MT: source count");

    // 1 GT = 1000000000 T
    let source_34: Denomination1 = 1GT;
    let target_34: Denomination6 = 1000000000T;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_magnetic_flux_density/base_anchor_GT: forward");
    std::test::assert(right_34 == left_34, "prefix_magnetic_flux_density/base_anchor_GT: reverse");
    std::test::assert_eq_int(left_34 / 1T, k * 1000000000, "prefix_magnetic_flux_density/base_anchor_GT: target count");
    std::test::assert_eq_int(right_34 / 1GT, k * 1, "prefix_magnetic_flux_density/base_anchor_GT: source count");

    // 1 TT = 1000000000000 T
    let source_35: Denomination7 = 1TT;
    let target_35: Denomination6 = 1000000000000T;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_magnetic_flux_density/base_anchor_TT: forward");
    std::test::assert(right_35 == left_35, "prefix_magnetic_flux_density/base_anchor_TT: reverse");
    std::test::assert_eq_int(left_35 / 1T, k * 1000000000000, "prefix_magnetic_flux_density/base_anchor_TT: target count");
    std::test::assert_eq_int(right_35 / 1TT, k * 1, "prefix_magnetic_flux_density/base_anchor_TT: source count");

    // 1 PT = 1000000000000000 T
    let source_36: Denomination3 = 1PT;
    let target_36: Denomination6 = 1000000000000000T;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_magnetic_flux_density/base_anchor_PT: forward");
    std::test::assert(right_36 == left_36, "prefix_magnetic_flux_density/base_anchor_PT: reverse");
    std::test::assert_eq_int(left_36 / 1T, k * 1000000000000000, "prefix_magnetic_flux_density/base_anchor_PT: target count");
    std::test::assert_eq_int(right_36 / 1PT, k * 1, "prefix_magnetic_flux_density/base_anchor_PT: source count");

    // 1 ET = 1000000000000000000 T
    let source_37: Denomination0 = 1ET;
    let target_37: Denomination6 = 1000000000000000000T;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_magnetic_flux_density/base_anchor_ET: forward");
    std::test::assert(right_37 == left_37, "prefix_magnetic_flux_density/base_anchor_ET: reverse");
    std::test::assert_eq_int(left_37 / 1T, k * 1000000000000000000, "prefix_magnetic_flux_density/base_anchor_ET: target count");
    std::test::assert_eq_int(right_37 / 1ET, k * 1, "prefix_magnetic_flux_density/base_anchor_ET: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
