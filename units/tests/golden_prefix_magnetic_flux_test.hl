    std::test::assert_eq_int(left_32 / 1Wb, k * 1000, "prefix_magnetic_flux/base_anchor_kWb: target count");
    std::test::assert_eq_int(right_32 / 1kWb, k * 1, "prefix_magnetic_flux/base_anchor_kWb: source count");

    // 1 MWb = 1000000 Wb
    let source_33: Denomination2 = 1MWb;
    let target_33: Denomination7 = 1000000Wb;
    let left_33 = k * source_33;
    let right_33 = k * target_33;
    std::test::assert(left_33 == right_33, "prefix_magnetic_flux/base_anchor_MWb: forward");
    std::test::assert(right_33 == left_33, "prefix_magnetic_flux/base_anchor_MWb: reverse");
    std::test::assert_eq_int(left_33 / 1Wb, k * 1000000, "prefix_magnetic_flux/base_anchor_MWb: target count");
    std::test::assert_eq_int(right_33 / 1MWb, k * 1, "prefix_magnetic_flux/base_anchor_MWb: source count");

    // 1 GWb = 1000000000 Wb
    let source_34: Denomination1 = 1GWb;
    let target_34: Denomination7 = 1000000000Wb;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_magnetic_flux/base_anchor_GWb: forward");
    std::test::assert(right_34 == left_34, "prefix_magnetic_flux/base_anchor_GWb: reverse");
    std::test::assert_eq_int(left_34 / 1Wb, k * 1000000000, "prefix_magnetic_flux/base_anchor_GWb: target count");
    std::test::assert_eq_int(right_34 / 1GWb, k * 1, "prefix_magnetic_flux/base_anchor_GWb: source count");

    // 1 TWb = 1000000000000 Wb
    let source_35: Denomination6 = 1TWb;
    let target_35: Denomination7 = 1000000000000Wb;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_magnetic_flux/base_anchor_TWb: forward");
    std::test::assert(right_35 == left_35, "prefix_magnetic_flux/base_anchor_TWb: reverse");
    std::test::assert_eq_int(left_35 / 1Wb, k * 1000000000000, "prefix_magnetic_flux/base_anchor_TWb: target count");
    std::test::assert_eq_int(right_35 / 1TWb, k * 1, "prefix_magnetic_flux/base_anchor_TWb: source count");

    // 1 PWb = 1000000000000000 Wb
    let source_36: Denomination3 = 1PWb;
    let target_36: Denomination7 = 1000000000000000Wb;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_magnetic_flux/base_anchor_PWb: forward");
    std::test::assert(right_36 == left_36, "prefix_magnetic_flux/base_anchor_PWb: reverse");
    std::test::assert_eq_int(left_36 / 1Wb, k * 1000000000000000, "prefix_magnetic_flux/base_anchor_PWb: target count");
    std::test::assert_eq_int(right_36 / 1PWb, k * 1, "prefix_magnetic_flux/base_anchor_PWb: source count");

    // 1 EWb = 1000000000000000000 Wb
    let source_37: Denomination0 = 1EWb;
    let target_37: Denomination7 = 1000000000000000000Wb;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_magnetic_flux/base_anchor_EWb: forward");
    std::test::assert(right_37 == left_37, "prefix_magnetic_flux/base_anchor_EWb: reverse");
    std::test::assert_eq_int(left_37 / 1Wb, k * 1000000000000000000, "prefix_magnetic_flux/base_anchor_EWb: target count");
    std::test::assert_eq_int(right_37 / 1EWb, k * 1, "prefix_magnetic_flux/base_anchor_EWb: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
