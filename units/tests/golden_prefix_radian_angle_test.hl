    std::test::assert_eq_int(left_33 / 1rad, k * 1000000, "prefix_radian_angle/base_anchor_Mrad: target count");
    std::test::assert_eq_int(right_33 / 1Mrad, k * 1, "prefix_radian_angle/base_anchor_Mrad: source count");

    // 1 Grad = 1000000000 rad
    let source_34: Denomination1 = 1Grad;
    let target_34: Denomination20 = 1000000000rad;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_radian_angle/base_anchor_Grad: forward");
    std::test::assert(right_34 == left_34, "prefix_radian_angle/base_anchor_Grad: reverse");
    std::test::assert_eq_int(left_34 / 1rad, k * 1000000000, "prefix_radian_angle/base_anchor_Grad: target count");
    std::test::assert_eq_int(right_34 / 1Grad, k * 1, "prefix_radian_angle/base_anchor_Grad: source count");

    // 1 Trad = 1000000000000 rad
    let source_35: Denomination6 = 1Trad;
    let target_35: Denomination20 = 1000000000000rad;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_radian_angle/base_anchor_Trad: forward");
    std::test::assert(right_35 == left_35, "prefix_radian_angle/base_anchor_Trad: reverse");
    std::test::assert_eq_int(left_35 / 1rad, k * 1000000000000, "prefix_radian_angle/base_anchor_Trad: target count");
    std::test::assert_eq_int(right_35 / 1Trad, k * 1, "prefix_radian_angle/base_anchor_Trad: source count");

    // 1 Prad = 1000000000000000 rad
    let source_36: Denomination3 = 1Prad;
    let target_36: Denomination20 = 1000000000000000rad;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_radian_angle/base_anchor_Prad: forward");
    std::test::assert(right_36 == left_36, "prefix_radian_angle/base_anchor_Prad: reverse");
    std::test::assert_eq_int(left_36 / 1rad, k * 1000000000000000, "prefix_radian_angle/base_anchor_Prad: target count");
    std::test::assert_eq_int(right_36 / 1Prad, k * 1, "prefix_radian_angle/base_anchor_Prad: source count");

    // 1 Erad = 1000000000000000000 rad
    let source_37: Denomination0 = 1Erad;
    let target_37: Denomination20 = 1000000000000000000rad;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_radian_angle/base_anchor_Erad: forward");
    std::test::assert(right_37 == left_37, "prefix_radian_angle/base_anchor_Erad: reverse");
    std::test::assert_eq_int(left_37 / 1rad, k * 1000000000000000000, "prefix_radian_angle/base_anchor_Erad: target count");
    std::test::assert_eq_int(right_37 / 1Erad, k * 1, "prefix_radian_angle/base_anchor_Erad: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
