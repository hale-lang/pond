    std::test::assert_eq_int(right_34 / 1GH, k * 1, "prefix_inductance/base_anchor_GH: source count");

    // 1 TH = 1000000000000 H
    let source_35: Denomination7 = 1TH;
    let target_35: Denomination2 = 1000000000000H;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_inductance/base_anchor_TH: forward");
    std::test::assert(right_35 == left_35, "prefix_inductance/base_anchor_TH: reverse");
    std::test::assert_eq_int(left_35 / 1H, k * 1000000000000, "prefix_inductance/base_anchor_TH: target count");
    std::test::assert_eq_int(right_35 / 1TH, k * 1, "prefix_inductance/base_anchor_TH: source count");

    // 1 PH = 1000000000000000 H
    let source_36: Denomination4 = 1PH;
    let target_36: Denomination2 = 1000000000000000H;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_inductance/base_anchor_PH: forward");
    std::test::assert(right_36 == left_36, "prefix_inductance/base_anchor_PH: reverse");
    std::test::assert_eq_int(left_36 / 1H, k * 1000000000000000, "prefix_inductance/base_anchor_PH: target count");
    std::test::assert_eq_int(right_36 / 1PH, k * 1, "prefix_inductance/base_anchor_PH: source count");

    // 1 EH = 1000000000000000000 H
    let source_37: Denomination0 = 1EH;
    let target_37: Denomination2 = 1000000000000000000H;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_inductance/base_anchor_EH: forward");
    std::test::assert(right_37 == left_37, "prefix_inductance/base_anchor_EH: reverse");
    std::test::assert_eq_int(left_37 / 1H, k * 1000000000000000000, "prefix_inductance/base_anchor_EH: target count");
    std::test::assert_eq_int(right_37 / 1EH, k * 1, "prefix_inductance/base_anchor_EH: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
