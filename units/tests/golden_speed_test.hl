    // 1 m_per_s = 3600 m_per_h
    let source_5: Denomination5 = 1m_per_s;
    let target_5: Denomination4 = 3600m_per_h;
    let left_5 = k * source_5;
    let right_5 = k * target_5;
    std::test::assert(left_5 == right_5, "speed/m_per_s_to_m_per_h: forward");
    std::test::assert(right_5 == left_5, "speed/m_per_s_to_m_per_h: reverse");
    std::test::assert_eq_int(left_5 / 1m_per_h, k * 3600, "speed/m_per_s_to_m_per_h: target count");
    std::test::assert_eq_int(right_5 / 1m_per_s, k * 1, "speed/m_per_s_to_m_per_h: source count");

