// Generated from independent golden.json by generate_golden.py; do not edit.
// magnetic_flux: 2 runtime ratios, 0 literal-conversion ratios.
// Each runtime ratio checks signed multiples 1, -1 and 3 in both directions.
// Source references and graph-only limitations are recorded in golden.json.

import ".." as units;

type GoldenQuantity = quantity Int in QWb;

type Denomination0 = GoldenQuantity in Mx;
type Denomination1 = GoldenQuantity in Wb;
type Denomination2 = GoldenQuantity in uWb;

fn check_runtime(k: Int) {
    // 1 Wb = 100000000 Mx
    let source_0: Denomination1 = 1Wb;
    let target_0: Denomination0 = 100000000Mx;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "magnetic_flux/Wb_to_Mx: forward");
    std::test::assert(right_0 == left_0, "magnetic_flux/Wb_to_Mx: reverse");
    std::test::assert_eq_int(left_0 / 1Mx, k * 100000000, "magnetic_flux/Wb_to_Mx: target count");
    std::test::assert_eq_int(right_0 / 1Wb, k * 1, "magnetic_flux/Wb_to_Mx: source count");

    // 1 uWb = 100 Mx
    let source_1: Denomination2 = 1uWb;
    let target_1: Denomination0 = 100Mx;
    let left_1 = k * source_1;
    let right_1 = k * target_1;
    std::test::assert(left_1 == right_1, "magnetic_flux/uWb_to_Mx: forward");
    std::test::assert(right_1 == left_1, "magnetic_flux/uWb_to_Mx: reverse");
    std::test::assert_eq_int(left_1 / 1Mx, k * 100, "magnetic_flux/uWb_to_Mx: target count");
    std::test::assert_eq_int(right_1 / 1uWb, k * 1, "magnetic_flux/uWb_to_Mx: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
