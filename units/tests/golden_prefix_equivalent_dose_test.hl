    std::test::assert_eq_int(left_32 / 1Sv, k * 1000, "prefix_equivalent_dose/base_anchor_kSv: target count");
    std::test::assert_eq_int(right_32 / 1kSv, k * 1, "prefix_equivalent_dose/base_anchor_kSv: source count");

    // 1 MSv = 1000000 Sv
    let source_33: Denomination2 = 1MSv;
    let target_33: Denomination6 = 1000000Sv;
    let left_33 = k * source_33;
    let right_33 = k * target_33;
    std::test::assert(left_33 == right_33, "prefix_equivalent_dose/base_anchor_MSv: forward");
    std::test::assert(right_33 == left_33, "prefix_equivalent_dose/base_anchor_MSv: reverse");
    std::test::assert_eq_int(left_33 / 1Sv, k * 1000000, "prefix_equivalent_dose/base_anchor_MSv: target count");
    std::test::assert_eq_int(right_33 / 1MSv, k * 1, "prefix_equivalent_dose/base_anchor_MSv: source count");

    // 1 GSv = 1000000000 Sv
    let source_34: Denomination1 = 1GSv;
    let target_34: Denomination6 = 1000000000Sv;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_equivalent_dose/base_anchor_GSv: forward");
    std::test::assert(right_34 == left_34, "prefix_equivalent_dose/base_anchor_GSv: reverse");
    std::test::assert_eq_int(left_34 / 1Sv, k * 1000000000, "prefix_equivalent_dose/base_anchor_GSv: target count");
    std::test::assert_eq_int(right_34 / 1GSv, k * 1, "prefix_equivalent_dose/base_anchor_GSv: source count");

    // 1 TSv = 1000000000000 Sv
    let source_35: Denomination7 = 1TSv;
    let target_35: Denomination6 = 1000000000000Sv;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_equivalent_dose/base_anchor_TSv: forward");
    std::test::assert(right_35 == left_35, "prefix_equivalent_dose/base_anchor_TSv: reverse");
    std::test::assert_eq_int(left_35 / 1Sv, k * 1000000000000, "prefix_equivalent_dose/base_anchor_TSv: target count");
    std::test::assert_eq_int(right_35 / 1TSv, k * 1, "prefix_equivalent_dose/base_anchor_TSv: source count");

    // 1 PSv = 1000000000000000 Sv
    let source_36: Denomination3 = 1PSv;
    let target_36: Denomination6 = 1000000000000000Sv;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_equivalent_dose/base_anchor_PSv: forward");
    std::test::assert(right_36 == left_36, "prefix_equivalent_dose/base_anchor_PSv: reverse");
    std::test::assert_eq_int(left_36 / 1Sv, k * 1000000000000000, "prefix_equivalent_dose/base_anchor_PSv: target count");
    std::test::assert_eq_int(right_36 / 1PSv, k * 1, "prefix_equivalent_dose/base_anchor_PSv: source count");

    // 1 ESv = 1000000000000000000 Sv
    let source_37: Denomination0 = 1ESv;
    let target_37: Denomination6 = 1000000000000000000Sv;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_equivalent_dose/base_anchor_ESv: forward");
    std::test::assert(right_37 == left_37, "prefix_equivalent_dose/base_anchor_ESv: reverse");
    std::test::assert_eq_int(left_37 / 1Sv, k * 1000000000000000000, "prefix_equivalent_dose/base_anchor_ESv: target count");
    std::test::assert_eq_int(right_37 / 1ESv, k * 1, "prefix_equivalent_dose/base_anchor_ESv: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
