    std::test::assert_eq_int(left_33 / 1kat, k * 1000000, "prefix_catalytic_activity/base_anchor_Mkat: target count");
    std::test::assert_eq_int(right_33 / 1Mkat, k * 1, "prefix_catalytic_activity/base_anchor_Mkat: source count");

    // 1 Gkat = 1000000000 kat
    let source_34: Denomination1 = 1Gkat;
    let target_34: Denomination15 = 1000000000kat;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_catalytic_activity/base_anchor_Gkat: forward");
    std::test::assert(right_34 == left_34, "prefix_catalytic_activity/base_anchor_Gkat: reverse");
    std::test::assert_eq_int(left_34 / 1kat, k * 1000000000, "prefix_catalytic_activity/base_anchor_Gkat: target count");
    std::test::assert_eq_int(right_34 / 1Gkat, k * 1, "prefix_catalytic_activity/base_anchor_Gkat: source count");

    // 1 Tkat = 1000000000000 kat
    let source_35: Denomination6 = 1Tkat;
    let target_35: Denomination15 = 1000000000000kat;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_catalytic_activity/base_anchor_Tkat: forward");
    std::test::assert(right_35 == left_35, "prefix_catalytic_activity/base_anchor_Tkat: reverse");
    std::test::assert_eq_int(left_35 / 1kat, k * 1000000000000, "prefix_catalytic_activity/base_anchor_Tkat: target count");
    std::test::assert_eq_int(right_35 / 1Tkat, k * 1, "prefix_catalytic_activity/base_anchor_Tkat: source count");

    // 1 Pkat = 1000000000000000 kat
    let source_36: Denomination3 = 1Pkat;
    let target_36: Denomination15 = 1000000000000000kat;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_catalytic_activity/base_anchor_Pkat: forward");
    std::test::assert(right_36 == left_36, "prefix_catalytic_activity/base_anchor_Pkat: reverse");
    std::test::assert_eq_int(left_36 / 1kat, k * 1000000000000000, "prefix_catalytic_activity/base_anchor_Pkat: target count");
    std::test::assert_eq_int(right_36 / 1Pkat, k * 1, "prefix_catalytic_activity/base_anchor_Pkat: source count");

    // 1 Ekat = 1000000000000000000 kat
    let source_37: Denomination0 = 1Ekat;
    let target_37: Denomination15 = 1000000000000000000kat;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_catalytic_activity/base_anchor_Ekat: forward");
    std::test::assert(right_37 == left_37, "prefix_catalytic_activity/base_anchor_Ekat: reverse");
    std::test::assert_eq_int(left_37 / 1kat, k * 1000000000000000000, "prefix_catalytic_activity/base_anchor_Ekat: target count");
    std::test::assert_eq_int(right_37 / 1Ekat, k * 1, "prefix_catalytic_activity/base_anchor_Ekat: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
