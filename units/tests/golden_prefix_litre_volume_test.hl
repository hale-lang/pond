    std::test::assert(left_34 == right_34, "prefix_litre_volume/base_anchor_GL: forward");
    std::test::assert(right_34 == left_34, "prefix_litre_volume/base_anchor_GL: reverse");
    std::test::assert_eq_int(left_34 / 1L, k * 1000000000, "prefix_litre_volume/base_anchor_GL: target count");
    std::test::assert_eq_int(right_34 / 1GL, k * 1, "prefix_litre_volume/base_anchor_GL: source count");

    // 1 TL = 1000000000000 L
    let source_35: Denomination7 = 1TL;
    let target_35: Denomination2 = 1000000000000L;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_litre_volume/base_anchor_TL: forward");
    std::test::assert(right_35 == left_35, "prefix_litre_volume/base_anchor_TL: reverse");
    std::test::assert_eq_int(left_35 / 1L, k * 1000000000000, "prefix_litre_volume/base_anchor_TL: target count");
    std::test::assert_eq_int(right_35 / 1TL, k * 1, "prefix_litre_volume/base_anchor_TL: source count");

    // 1 PL = 1000000000000000 L
    let source_36: Denomination4 = 1PL;
    let target_36: Denomination2 = 1000000000000000L;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_litre_volume/base_anchor_PL: forward");
    std::test::assert(right_36 == left_36, "prefix_litre_volume/base_anchor_PL: reverse");
    std::test::assert_eq_int(left_36 / 1L, k * 1000000000000000, "prefix_litre_volume/base_anchor_PL: target count");
    std::test::assert_eq_int(right_36 / 1PL, k * 1, "prefix_litre_volume/base_anchor_PL: source count");

    // 1 EL = 1000000000000000000 L
    let source_37: Denomination0 = 1EL;
    let target_37: Denomination2 = 1000000000000000000L;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_litre_volume/base_anchor_EL: forward");
    std::test::assert(right_37 == left_37, "prefix_litre_volume/base_anchor_EL: reverse");
    std::test::assert_eq_int(left_37 / 1L, k * 1000000000000000000, "prefix_litre_volume/base_anchor_EL: target count");
    std::test::assert_eq_int(right_37 / 1EL, k * 1, "prefix_litre_volume/base_anchor_EL: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
