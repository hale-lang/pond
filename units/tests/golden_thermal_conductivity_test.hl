// Generated from independent golden.json by generate_golden.py; do not edit.
// thermal_conductivity: 2 runtime ratios, 0 literal-conversion ratios.
// Each runtime ratio checks signed multiples 1, -1 and 3 in both directions.
// Source references and graph-only limitations are recorded in golden.json.

import ".." as units;

type GoldenQuantity = quantity Int in W_per_cm_K;

type Denomination0 = GoldenQuantity in W_per_cm_K;
type Denomination1 = GoldenQuantity in W_per_m_K;
type Denomination2 = GoldenQuantity in mW_per_m_K;

fn check_runtime(k: Int) {
    // 1 W_per_cm_K = 100000 mW_per_m_K
    let source_0: Denomination0 = 1W_per_cm_K;
    let target_0: Denomination2 = 100000mW_per_m_K;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "thermal_conductivity/W_per_cm_K_to_mW_per_m_K: forward");
    std::test::assert(right_0 == left_0, "thermal_conductivity/W_per_cm_K_to_mW_per_m_K: reverse");
    std::test::assert_eq_int(left_0 / 1mW_per_m_K, k * 100000, "thermal_conductivity/W_per_cm_K_to_mW_per_m_K: target count");
    std::test::assert_eq_int(right_0 / 1W_per_cm_K, k * 1, "thermal_conductivity/W_per_cm_K_to_mW_per_m_K: source count");

    // 1 W_per_cm_K = 100 W_per_m_K
    let source_1: Denomination0 = 1W_per_cm_K;
    let target_1: Denomination1 = 100W_per_m_K;
    let left_1 = k * source_1;
    let right_1 = k * target_1;
    std::test::assert(left_1 == right_1, "thermal_conductivity/W_per_cm_K_to_W_per_m_K: forward");
    std::test::assert(right_1 == left_1, "thermal_conductivity/W_per_cm_K_to_W_per_m_K: reverse");
    std::test::assert_eq_int(left_1 / 1W_per_m_K, k * 100, "thermal_conductivity/W_per_cm_K_to_W_per_m_K: target count");
    std::test::assert_eq_int(right_1 / 1W_per_cm_K, k * 1, "thermal_conductivity/W_per_cm_K_to_W_per_m_K: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
