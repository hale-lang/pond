    std::test::assert_eq_int(right_36 / 1Pm, k * 1, "prefix_length/base_anchor_Pm: source count");

    // 1 Em = 1000000000000000000 m
    let source_37: Denomination0 = 1Em;
    let target_37: Denomination16 = 1000000000000000000m;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_length/base_anchor_Em: forward");
    std::test::assert(right_37 == left_37, "prefix_length/base_anchor_Em: reverse");
    std::test::assert_eq_int(left_37 / 1m, k * 1000000000000000000, "prefix_length/base_anchor_Em: target count");
    std::test::assert_eq_int(right_37 / 1Em, k * 1, "prefix_length/base_anchor_Em: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
