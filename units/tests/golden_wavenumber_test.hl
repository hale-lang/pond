// Generated from independent golden.json by generate_golden.py; do not edit.
// wavenumber: 1 runtime ratios, 0 literal-conversion ratios.
// Each runtime ratio checks signed multiples 1, -1 and 3 in both directions.
// Source references and graph-only limitations are recorded in golden.json.

import ".." as units;

type GoldenQuantity = quantity Int in per_cm;

type Denomination0 = GoldenQuantity in per_cm;
type Denomination1 = GoldenQuantity in per_m;

fn check_runtime(k: Int) {
    // 1 per_cm = 100 per_m
    let source_0: Denomination0 = 1per_cm;
    let target_0: Denomination1 = 100per_m;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "wavenumber/per_cm_to_per_m: forward");
    std::test::assert(right_0 == left_0, "wavenumber/per_cm_to_per_m: reverse");
    std::test::assert_eq_int(left_0 / 1per_m, k * 100, "wavenumber/per_cm_to_per_m: target count");
    std::test::assert_eq_int(right_0 / 1per_cm, k * 1, "wavenumber/per_cm_to_per_m: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
