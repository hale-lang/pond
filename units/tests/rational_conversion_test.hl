// Runtime rational conversions, with expected counts independently checked by
// exact fractions: Torr/mbar = 4053/3040, enzyme_unit/nkat = 50/3,
// lb/g = 45359237/100000. No intermediate floating-point rounding.
import ".." as units;

// App-chosen principal denominations retain a non-integer p/q at .in().
type TestPressure = quantity Int in Torr;
type TestActivity = quantity Int in enzyme_unit;
type TestMass = quantity Int in lb;
type Millibars = TestPressure in mbar;
type Nanokatals = TestActivity in nkat;
type Grams = TestMass in g;

fn torr(count: Int) -> TestPressure {
    return count * 1Torr;
}

fn millibars(count: Int) -> Millibars {
    return count * 1mbar;
}

fn enzyme_units(count: Int) -> TestActivity {
    return count * 1enzyme_unit;
}

fn nanokatals(count: Int) -> Nanokatals {
    return count * 1nkat;
}

fn pounds(count: Int) -> TestMass {
    return count * 1lb;
}

fn grams(count: Int) -> Grams {
    return count * 1g;
}

fn check_pressure(count: Int, down: Int, up: Int, toward_zero: Int, even: Int, away: Int) {
    let value = torr(count);
    let floored = value.in(mbar) or floor;
    let ceiling = value.in(mbar) or ceil;
    let truncated = value.in(mbar) or trunc;
    let nearest_even = value.in(mbar) or half_even;
    let nearest_away = value.in(mbar) or half_up;
    std::test::assert_eq_int(floored / 1mbar, down, "pressure floor uses the complete rational factor");
    std::test::assert_eq_int(ceiling / 1mbar, up, "pressure ceil uses the complete rational factor");
    std::test::assert_eq_int(truncated / 1mbar, toward_zero, "pressure trunc uses the complete rational factor");
    std::test::assert_eq_int(nearest_even / 1mbar, even, "pressure half_even uses the complete rational factor");
    std::test::assert_eq_int(nearest_away / 1mbar, away, "pressure half_up uses the complete rational factor");
}

fn check_enzyme(count: Int, down: Int, up: Int, toward_zero: Int, even: Int, away: Int) {
    let value = enzyme_units(count);
    let floored = value.in(nkat) or floor;
    let ceiling = value.in(nkat) or ceil;
    let truncated = value.in(nkat) or trunc;
    let nearest_even = value.in(nkat) or half_even;
    let nearest_away = value.in(nkat) or half_up;
    std::test::assert_eq_int(floored / 1nkat, down, "enzyme floor uses the complete rational factor");
    std::test::assert_eq_int(ceiling / 1nkat, up, "enzyme ceil uses the complete rational factor");
    std::test::assert_eq_int(truncated / 1nkat, toward_zero, "enzyme trunc uses the complete rational factor");
    std::test::assert_eq_int(nearest_even / 1nkat, even, "enzyme half_even uses the complete rational factor");
    std::test::assert_eq_int(nearest_away / 1nkat, away, "enzyme half_up uses the complete rational factor");
}

fn check_mass(count: Int, down: Int, up: Int, toward_zero: Int, even: Int, away: Int) {
    let value = pounds(count);
    let floored = value.in(g) or floor;
    let ceiling = value.in(g) or ceil;
    let truncated = value.in(g) or trunc;
    let nearest_even = value.in(g) or half_even;
    let nearest_away = value.in(g) or half_up;
    std::test::assert_eq_int(floored / 1g, down, "mass floor uses the complete rational factor");
    std::test::assert_eq_int(ceiling / 1g, up, "mass ceil uses the complete rational factor");
    std::test::assert_eq_int(truncated / 1g, toward_zero, "mass trunc uses the complete rational factor");
    std::test::assert_eq_int(nearest_even / 1g, even, "mass half_even uses the complete rational factor");
    std::test::assert_eq_int(nearest_away / 1g, away, "mass half_up uses the complete rational factor");
}

fn main() {
    check_pressure(1, 1, 2, 1, 1, 1);
    check_pressure(2, 2, 3, 2, 3, 3);
    check_pressure(-1, -2, -1, -1, -1, -1);
    check_pressure(-2, -3, -2, -2, -3, -3);
    check_pressure(1520, 2026, 2027, 2026, 2026, 2027);
    check_pressure(4560, 6079, 6080, 6079, 6080, 6080);
    check_pressure(-1520, -2027, -2026, -2026, -2026, -2027);
    check_pressure(-4560, -6080, -6079, -6079, -6080, -6080);
    check_pressure(3040, 4053, 4053, 4053, 4053, 4053);
    check_pressure(-3040, -4053, -4053, -4053, -4053, -4053);

    check_enzyme(1, 16, 17, 16, 17, 17);
    check_enzyme(2, 33, 34, 33, 33, 33);
    check_enzyme(-1, -17, -16, -16, -17, -17);
    check_enzyme(-2, -34, -33, -33, -33, -33);
    check_enzyme(3, 50, 50, 50, 50, 50);
    check_enzyme(-3, -50, -50, -50, -50, -50);

    check_mass(1, 453, 454, 453, 454, 454);
    check_mass(-1, -454, -453, -453, -454, -454);
    check_mass(100000, 45359237, 45359237, 45359237, 45359237, 45359237);
    check_mass(-100000, -45359237, -45359237, -45359237, -45359237, -45359237);

    let exact_pressure = torr(3040).in(mbar) or 999mbar;
    let inexact_pressure = torr(1).in(mbar) or 999mbar;
    let negative_pressure = torr(-1).in(mbar) or 999mbar;
    std::test::assert_eq_int(exact_pressure / 1mbar, 4053, "exact rational pressure conversion bypasses substitute");
    std::test::assert_eq_int(inexact_pressure / 1mbar, 999, "inexact positive pressure conversion takes substitute");
    std::test::assert_eq_int(negative_pressure / 1mbar, 999, "inexact negative pressure conversion takes substitute");

    let pressure_back = millibars(4053).in(Torr) or 999Torr;
    let pressure_nearest = millibars(1).in(Torr) or half_even;
    let pressure_negative = millibars(-1).in(Torr) or half_even;
    let pressure_floor = millibars(1).in(Torr) or floor;
    let pressure_ceil = millibars(-1).in(Torr) or ceil;
    let pressure_substitute = millibars(1).in(Torr) or 999Torr;
    std::test::assert_eq_int(pressure_back / 1Torr, 3040, "exact reverse pressure conversion");
    std::test::assert_eq_int(pressure_nearest / 1Torr, 1, "one millibar is about 0.75006 Torr");
    std::test::assert_eq_int(pressure_negative / 1Torr, -1, "negative reverse pressure rounds symmetrically");
    std::test::assert_eq_int(pressure_floor / 1Torr, 0, "positive reverse pressure floor");
    std::test::assert_eq_int(pressure_ceil / 1Torr, 0, "negative reverse pressure ceiling");
    std::test::assert_eq_int(pressure_substitute / 1Torr, 999, "reverse pressure substitute");

    let exact_activity = enzyme_units(3).in(nkat) or 999nkat;
    let inexact_activity = enzyme_units(1).in(nkat) or 999nkat;
    let negative_activity = enzyme_units(-1).in(nkat) or 999nkat;
    std::test::assert_eq_int(exact_activity / 1nkat, 50, "three enzyme units are exactly 50 nanokatals");
    std::test::assert_eq_int(inexact_activity / 1nkat, 999, "inexact positive enzyme conversion takes substitute");
    std::test::assert_eq_int(negative_activity / 1nkat, 999, "inexact negative enzyme conversion takes substitute");

    let activity_back = nanokatals(50).in(enzyme_unit) or 999enzyme_unit;
    let activity_tie = nanokatals(25).in(enzyme_unit) or half_even;
    let activity_even = nanokatals(75).in(enzyme_unit) or half_even;
    let activity_away = nanokatals(75).in(enzyme_unit) or half_up;
    let activity_negative_even = nanokatals(-75).in(enzyme_unit) or half_even;
    let activity_negative_away = nanokatals(-75).in(enzyme_unit) or half_up;
    let activity_substitute = nanokatals(1).in(enzyme_unit) or 999enzyme_unit;
    std::test::assert_eq_int(activity_back / 1enzyme_unit, 3, "50 nanokatals convert exactly to three enzyme units");
    std::test::assert_eq_int(activity_tie / 1enzyme_unit, 2, "1.5 enzyme units ties to even two");
    std::test::assert_eq_int(activity_even / 1enzyme_unit, 4, "4.5 enzyme units ties to even four");
    std::test::assert_eq_int(activity_away / 1enzyme_unit, 5, "4.5 enzyme units ties away to five");
    std::test::assert_eq_int(activity_negative_even / 1enzyme_unit, -4, "negative enzyme tie goes to even");
    std::test::assert_eq_int(activity_negative_away / 1enzyme_unit, -5, "negative enzyme tie goes away from zero");
    std::test::assert_eq_int(activity_substitute / 1enzyme_unit, 999, "reverse enzyme substitute");

    let exact_mass = pounds(100000).in(g) or 999g;
    let inexact_mass = pounds(1).in(g) or 999g;
    let negative_mass = pounds(-1).in(g) or 999g;
    std::test::assert_eq_int(exact_mass / 1g, 45359237, "exact international-pound conversion");
    std::test::assert_eq_int(inexact_mass / 1g, 999, "inexact positive pound conversion takes substitute");
    std::test::assert_eq_int(negative_mass / 1g, 999, "inexact negative pound conversion takes substitute");

    let mass_back = grams(45359237).in(lb) or 999lb;
    let mass_nearest = grams(453).in(lb) or half_even;
    let mass_negative = grams(-453).in(lb) or half_even;
    let mass_substitute = grams(1).in(lb) or 999lb;
    std::test::assert_eq_int(mass_back / 1lb, 100000, "exact reverse international-pound conversion");
    std::test::assert_eq_int(mass_nearest / 1lb, 1, "453 grams rounds to one pound");
    std::test::assert_eq_int(mass_negative / 1lb, -1, "negative grams round symmetrically");
    std::test::assert_eq_int(mass_substitute / 1lb, 999, "reverse pound substitute");
}
