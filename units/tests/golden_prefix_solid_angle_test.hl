    std::test::assert(left_34 == right_34, "prefix_solid_angle/base_anchor_Gsr: forward");
    std::test::assert(right_34 == left_34, "prefix_solid_angle/base_anchor_Gsr: reverse");
    std::test::assert_eq_int(left_34 / 1sr, k * 1000000000, "prefix_solid_angle/base_anchor_Gsr: target count");
    std::test::assert_eq_int(right_34 / 1Gsr, k * 1, "prefix_solid_angle/base_anchor_Gsr: source count");

    // 1 Tsr = 1000000000000 sr
    let source_35: Denomination6 = 1Tsr;
    let target_35: Denomination21 = 1000000000000sr;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_solid_angle/base_anchor_Tsr: forward");
    std::test::assert(right_35 == left_35, "prefix_solid_angle/base_anchor_Tsr: reverse");
    std::test::assert_eq_int(left_35 / 1sr, k * 1000000000000, "prefix_solid_angle/base_anchor_Tsr: target count");
    std::test::assert_eq_int(right_35 / 1Tsr, k * 1, "prefix_solid_angle/base_anchor_Tsr: source count");

    // 1 Psr = 1000000000000000 sr
    let source_36: Denomination3 = 1Psr;
    let target_36: Denomination21 = 1000000000000000sr;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_solid_angle/base_anchor_Psr: forward");
    std::test::assert(right_36 == left_36, "prefix_solid_angle/base_anchor_Psr: reverse");
    std::test::assert_eq_int(left_36 / 1sr, k * 1000000000000000, "prefix_solid_angle/base_anchor_Psr: target count");
    std::test::assert_eq_int(right_36 / 1Psr, k * 1, "prefix_solid_angle/base_anchor_Psr: source count");

    // 1 Esr = 1000000000000000000 sr
    let source_37: Denomination0 = 1Esr;
    let target_37: Denomination21 = 1000000000000000000sr;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_solid_angle/base_anchor_Esr: forward");
    std::test::assert(right_37 == left_37, "prefix_solid_angle/base_anchor_Esr: reverse");
    std::test::assert_eq_int(left_37 / 1sr, k * 1000000000000000000, "prefix_solid_angle/base_anchor_Esr: target count");
    std::test::assert_eq_int(right_37 / 1Esr, k * 1, "prefix_solid_angle/base_anchor_Esr: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
