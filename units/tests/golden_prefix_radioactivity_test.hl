    std::test::assert(left_33 == right_33, "prefix_radioactivity/base_anchor_MBq: forward");
    std::test::assert(right_33 == left_33, "prefix_radioactivity/base_anchor_MBq: reverse");
    std::test::assert_eq_int(left_33 / 1Bq, k * 1000000, "prefix_radioactivity/base_anchor_MBq: target count");
    std::test::assert_eq_int(right_33 / 1MBq, k * 1, "prefix_radioactivity/base_anchor_MBq: source count");

    // 1 GBq = 1000000000 Bq
    let source_34: Denomination2 = 1GBq;
    let target_34: Denomination0 = 1000000000Bq;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_radioactivity/base_anchor_GBq: forward");
    std::test::assert(right_34 == left_34, "prefix_radioactivity/base_anchor_GBq: reverse");
    std::test::assert_eq_int(left_34 / 1Bq, k * 1000000000, "prefix_radioactivity/base_anchor_GBq: target count");
    std::test::assert_eq_int(right_34 / 1GBq, k * 1, "prefix_radioactivity/base_anchor_GBq: source count");

    // 1 TBq = 1000000000000 Bq
    let source_35: Denomination7 = 1TBq;
    let target_35: Denomination0 = 1000000000000Bq;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_radioactivity/base_anchor_TBq: forward");
    std::test::assert(right_35 == left_35, "prefix_radioactivity/base_anchor_TBq: reverse");
    std::test::assert_eq_int(left_35 / 1Bq, k * 1000000000000, "prefix_radioactivity/base_anchor_TBq: target count");
    std::test::assert_eq_int(right_35 / 1TBq, k * 1, "prefix_radioactivity/base_anchor_TBq: source count");

    // 1 PBq = 1000000000000000 Bq
    let source_36: Denomination4 = 1PBq;
    let target_36: Denomination0 = 1000000000000000Bq;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_radioactivity/base_anchor_PBq: forward");
    std::test::assert(right_36 == left_36, "prefix_radioactivity/base_anchor_PBq: reverse");
    std::test::assert_eq_int(left_36 / 1Bq, k * 1000000000000000, "prefix_radioactivity/base_anchor_PBq: target count");
    std::test::assert_eq_int(right_36 / 1PBq, k * 1, "prefix_radioactivity/base_anchor_PBq: source count");

    // 1 EBq = 1000000000000000000 Bq
    let source_37: Denomination1 = 1EBq;
    let target_37: Denomination0 = 1000000000000000000Bq;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_radioactivity/base_anchor_EBq: forward");
    std::test::assert(right_37 == left_37, "prefix_radioactivity/base_anchor_EBq: reverse");
    std::test::assert_eq_int(left_37 / 1Bq, k * 1000000000000000000, "prefix_radioactivity/base_anchor_EBq: target count");
    std::test::assert_eq_int(right_37 / 1EBq, k * 1, "prefix_radioactivity/base_anchor_EBq: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
