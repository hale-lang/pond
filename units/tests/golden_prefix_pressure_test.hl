    std::test::assert_eq_int(left_35 / 1Pa, k * 1000000000000, "prefix_pressure/base_anchor_TPa: target count");
    std::test::assert_eq_int(right_35 / 1TPa, k * 1, "prefix_pressure/base_anchor_TPa: source count");

    // 1 PPa = 1000000000000000 Pa
    let source_36: Denomination3 = 1PPa;
    let target_36: Denomination4 = 1000000000000000Pa;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_pressure/base_anchor_PPa: forward");
    std::test::assert(right_36 == left_36, "prefix_pressure/base_anchor_PPa: reverse");
    std::test::assert_eq_int(left_36 / 1Pa, k * 1000000000000000, "prefix_pressure/base_anchor_PPa: target count");
    std::test::assert_eq_int(right_36 / 1PPa, k * 1, "prefix_pressure/base_anchor_PPa: source count");

    // 1 EPa = 1000000000000000000 Pa
    let source_37: Denomination0 = 1EPa;
    let target_37: Denomination4 = 1000000000000000000Pa;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_pressure/base_anchor_EPa: forward");
    std::test::assert(right_37 == left_37, "prefix_pressure/base_anchor_EPa: reverse");
    std::test::assert_eq_int(left_37 / 1Pa, k * 1000000000000000000, "prefix_pressure/base_anchor_EPa: target count");
    std::test::assert_eq_int(right_37 / 1EPa, k * 1, "prefix_pressure/base_anchor_EPa: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
