    std::test::assert_eq_int(right_33 / 1Mlm, k * 1, "prefix_luminous_flux/base_anchor_Mlm: source count");

    // 1 Glm = 1000000000 lm
    let source_34: Denomination1 = 1Glm;
    let target_34: Denomination16 = 1000000000lm;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_luminous_flux/base_anchor_Glm: forward");
    std::test::assert(right_34 == left_34, "prefix_luminous_flux/base_anchor_Glm: reverse");
    std::test::assert_eq_int(left_34 / 1lm, k * 1000000000, "prefix_luminous_flux/base_anchor_Glm: target count");
    std::test::assert_eq_int(right_34 / 1Glm, k * 1, "prefix_luminous_flux/base_anchor_Glm: source count");

    // 1 Tlm = 1000000000000 lm
    let source_35: Denomination6 = 1Tlm;
    let target_35: Denomination16 = 1000000000000lm;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_luminous_flux/base_anchor_Tlm: forward");
    std::test::assert(right_35 == left_35, "prefix_luminous_flux/base_anchor_Tlm: reverse");
    std::test::assert_eq_int(left_35 / 1lm, k * 1000000000000, "prefix_luminous_flux/base_anchor_Tlm: target count");
    std::test::assert_eq_int(right_35 / 1Tlm, k * 1, "prefix_luminous_flux/base_anchor_Tlm: source count");

    // 1 Plm = 1000000000000000 lm
    let source_36: Denomination3 = 1Plm;
    let target_36: Denomination16 = 1000000000000000lm;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_luminous_flux/base_anchor_Plm: forward");
    std::test::assert(right_36 == left_36, "prefix_luminous_flux/base_anchor_Plm: reverse");
    std::test::assert_eq_int(left_36 / 1lm, k * 1000000000000000, "prefix_luminous_flux/base_anchor_Plm: target count");
    std::test::assert_eq_int(right_36 / 1Plm, k * 1, "prefix_luminous_flux/base_anchor_Plm: source count");

    // 1 Elm = 1000000000000000000 lm
    let source_37: Denomination0 = 1Elm;
    let target_37: Denomination16 = 1000000000000000000lm;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_luminous_flux/base_anchor_Elm: forward");
    std::test::assert(right_37 == left_37, "prefix_luminous_flux/base_anchor_Elm: reverse");
    std::test::assert_eq_int(left_37 / 1lm, k * 1000000000000000000, "prefix_luminous_flux/base_anchor_Elm: target count");
    std::test::assert_eq_int(right_37 / 1Elm, k * 1, "prefix_luminous_flux/base_anchor_Elm: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
