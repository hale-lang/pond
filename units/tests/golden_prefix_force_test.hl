    let target_36: Denomination3 = 1000000000000000N;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_force/base_anchor_PN: forward");
    std::test::assert(right_36 == left_36, "prefix_force/base_anchor_PN: reverse");
    std::test::assert_eq_int(left_36 / 1N, k * 1000000000000000, "prefix_force/base_anchor_PN: target count");
    std::test::assert_eq_int(right_36 / 1PN, k * 1, "prefix_force/base_anchor_PN: source count");

    // 1 EN = 1000000000000000000 N
    let source_37: Denomination0 = 1EN;
    let target_37: Denomination3 = 1000000000000000000N;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_force/base_anchor_EN: forward");
    std::test::assert(right_37 == left_37, "prefix_force/base_anchor_EN: reverse");
    std::test::assert_eq_int(left_37 / 1N, k * 1000000000000000000, "prefix_force/base_anchor_EN: target count");
    std::test::assert_eq_int(right_37 / 1EN, k * 1, "prefix_force/base_anchor_EN: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
