import ".." as units;

type GoldenQuantity = quantity Int in Pa_s;

type Denomination0 = GoldenQuantity in P;
type Denomination1 = GoldenQuantity in Pa_s;
type Denomination2 = GoldenQuantity in cP;
type Denomination3 = GoldenQuantity in mPa_s;

fn check_runtime(k: Int) {
    // 1 Pa_s = 1000 cP
    let source_0: Denomination1 = 1Pa_s;
    let target_0: Denomination2 = 1000cP;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "dynamic_viscosity/Pa_s_to_cP: forward");
    std::test::assert(right_0 == left_0, "dynamic_viscosity/Pa_s_to_cP: reverse");
    std::test::assert_eq_int(left_0 / 1cP, k * 1000, "dynamic_viscosity/Pa_s_to_cP: target count");
    std::test::assert_eq_int(right_0 / 1Pa_s, k * 1, "dynamic_viscosity/Pa_s_to_cP: source count");

    // 1 P = 100 cP
    let source_1: Denomination0 = 1P;
    let target_1: Denomination2 = 100cP;
    let left_1 = k * source_1;
    let right_1 = k * target_1;
    std::test::assert(left_1 == right_1, "dynamic_viscosity/P_to_cP: forward");
    std::test::assert(right_1 == left_1, "dynamic_viscosity/P_to_cP: reverse");
    std::test::assert_eq_int(left_1 / 1cP, k * 100, "dynamic_viscosity/P_to_cP: target count");
    std::test::assert_eq_int(right_1 / 1P, k * 1, "dynamic_viscosity/P_to_cP: source count");

    // 1 mPa_s = 1 cP
    let source_2: Denomination3 = 1mPa_s;
    let target_2: Denomination2 = 1cP;
    let left_2 = k * source_2;
    let right_2 = k * target_2;
    std::test::assert(left_2 == right_2, "dynamic_viscosity/mPa_s_to_cP: forward");
    std::test::assert(right_2 == left_2, "dynamic_viscosity/mPa_s_to_cP: reverse");
    std::test::assert_eq_int(left_2 / 1cP, k * 1, "dynamic_viscosity/mPa_s_to_cP: target count");
    std::test::assert_eq_int(right_2 / 1mPa_s, k * 1, "dynamic_viscosity/mPa_s_to_cP: source count");

    // 1 Pa_s = 10 P
    let source_3: Denomination1 = 1Pa_s;
    let target_3: Denomination0 = 10P;
    let left_3 = k * source_3;
    let right_3 = k * target_3;
    std::test::assert(left_3 == right_3, "dynamic_viscosity/Pa_s_to_P: forward");
    std::test::assert(right_3 == left_3, "dynamic_viscosity/Pa_s_to_P: reverse");
    std::test::assert_eq_int(left_3 / 1P, k * 10, "dynamic_viscosity/Pa_s_to_P: target count");
    std::test::assert_eq_int(right_3 / 1Pa_s, k * 1, "dynamic_viscosity/Pa_s_to_P: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
