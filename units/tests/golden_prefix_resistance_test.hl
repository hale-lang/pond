    std::test::assert_eq_int(left_33 / 1ohm, k * 1000000, "prefix_resistance/base_anchor_Mohm: target count");
    std::test::assert_eq_int(right_33 / 1Mohm, k * 1, "prefix_resistance/base_anchor_Mohm: source count");

    // 1 Gohm = 1000000000 ohm
    let source_34: Denomination1 = 1Gohm;
    let target_34: Denomination18 = 1000000000ohm;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_resistance/base_anchor_Gohm: forward");
    std::test::assert(right_34 == left_34, "prefix_resistance/base_anchor_Gohm: reverse");
    std::test::assert_eq_int(left_34 / 1ohm, k * 1000000000, "prefix_resistance/base_anchor_Gohm: target count");
    std::test::assert_eq_int(right_34 / 1Gohm, k * 1, "prefix_resistance/base_anchor_Gohm: source count");

    // 1 Tohm = 1000000000000 ohm
    let source_35: Denomination6 = 1Tohm;
    let target_35: Denomination18 = 1000000000000ohm;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_resistance/base_anchor_Tohm: forward");
    std::test::assert(right_35 == left_35, "prefix_resistance/base_anchor_Tohm: reverse");
    std::test::assert_eq_int(left_35 / 1ohm, k * 1000000000000, "prefix_resistance/base_anchor_Tohm: target count");
    std::test::assert_eq_int(right_35 / 1Tohm, k * 1, "prefix_resistance/base_anchor_Tohm: source count");

    // 1 Pohm = 1000000000000000 ohm
    let source_36: Denomination3 = 1Pohm;
    let target_36: Denomination18 = 1000000000000000ohm;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_resistance/base_anchor_Pohm: forward");
    std::test::assert(right_36 == left_36, "prefix_resistance/base_anchor_Pohm: reverse");
    std::test::assert_eq_int(left_36 / 1ohm, k * 1000000000000000, "prefix_resistance/base_anchor_Pohm: target count");
    std::test::assert_eq_int(right_36 / 1Pohm, k * 1, "prefix_resistance/base_anchor_Pohm: source count");

    // 1 Eohm = 1000000000000000000 ohm
    let source_37: Denomination0 = 1Eohm;
    let target_37: Denomination18 = 1000000000000000000ohm;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_resistance/base_anchor_Eohm: forward");
    std::test::assert(right_37 == left_37, "prefix_resistance/base_anchor_Eohm: reverse");
    std::test::assert_eq_int(left_37 / 1ohm, k * 1000000000000000000, "prefix_resistance/base_anchor_Eohm: target count");
    std::test::assert_eq_int(right_37 / 1Eohm, k * 1, "prefix_resistance/base_anchor_Eohm: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
