    std::test::assert_eq_int(left_33 / 1Gy, k * 1000000, "prefix_absorbed_dose/base_anchor_MGy: target count");
    std::test::assert_eq_int(right_33 / 1MGy, k * 1, "prefix_absorbed_dose/base_anchor_MGy: source count");

    // 1 GGy = 1000000000 Gy
    let source_34: Denomination1 = 1GGy;
    let target_34: Denomination2 = 1000000000Gy;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_absorbed_dose/base_anchor_GGy: forward");
    std::test::assert(right_34 == left_34, "prefix_absorbed_dose/base_anchor_GGy: reverse");
    std::test::assert_eq_int(left_34 / 1Gy, k * 1000000000, "prefix_absorbed_dose/base_anchor_GGy: target count");
    std::test::assert_eq_int(right_34 / 1GGy, k * 1, "prefix_absorbed_dose/base_anchor_GGy: source count");

    // 1 TGy = 1000000000000 Gy
    let source_35: Denomination7 = 1TGy;
    let target_35: Denomination2 = 1000000000000Gy;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_absorbed_dose/base_anchor_TGy: forward");
    std::test::assert(right_35 == left_35, "prefix_absorbed_dose/base_anchor_TGy: reverse");
    std::test::assert_eq_int(left_35 / 1Gy, k * 1000000000000, "prefix_absorbed_dose/base_anchor_TGy: target count");
    std::test::assert_eq_int(right_35 / 1TGy, k * 1, "prefix_absorbed_dose/base_anchor_TGy: source count");

    // 1 PGy = 1000000000000000 Gy
    let source_36: Denomination4 = 1PGy;
    let target_36: Denomination2 = 1000000000000000Gy;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_absorbed_dose/base_anchor_PGy: forward");
    std::test::assert(right_36 == left_36, "prefix_absorbed_dose/base_anchor_PGy: reverse");
    std::test::assert_eq_int(left_36 / 1Gy, k * 1000000000000000, "prefix_absorbed_dose/base_anchor_PGy: target count");
    std::test::assert_eq_int(right_36 / 1PGy, k * 1, "prefix_absorbed_dose/base_anchor_PGy: source count");

    // 1 EGy = 1000000000000000000 Gy
    let source_37: Denomination0 = 1EGy;
    let target_37: Denomination2 = 1000000000000000000Gy;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_absorbed_dose/base_anchor_EGy: forward");
    std::test::assert(right_37 == left_37, "prefix_absorbed_dose/base_anchor_EGy: reverse");
    std::test::assert_eq_int(left_37 / 1Gy, k * 1000000000000000000, "prefix_absorbed_dose/base_anchor_EGy: target count");
    std::test::assert_eq_int(right_37 / 1EGy, k * 1, "prefix_absorbed_dose/base_anchor_EGy: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
