    std::test::assert(left_36 == right_36, "prefix_current/base_anchor_PA: forward");
    std::test::assert(right_36 == left_36, "prefix_current/base_anchor_PA: reverse");
    std::test::assert_eq_int(left_36 / 1A, k * 1000000000000000, "prefix_current/base_anchor_PA: target count");
    std::test::assert_eq_int(right_36 / 1PA, k * 1, "prefix_current/base_anchor_PA: source count");

    // 1 EA = 1000000000000000000 A
    let source_37: Denomination1 = 1EA;
    let target_37: Denomination0 = 1000000000000000000A;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_current/base_anchor_EA: forward");
    std::test::assert(right_37 == left_37, "prefix_current/base_anchor_EA: reverse");
    std::test::assert_eq_int(left_37 / 1A, k * 1000000000000000000, "prefix_current/base_anchor_EA: target count");
    std::test::assert_eq_int(right_37 / 1EA, k * 1, "prefix_current/base_anchor_EA: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
