// Generated from independent golden.json by generate_golden.py; do not edit.
// kinematic_viscosity: 3 runtime ratios, 0 literal-conversion ratios.
// Each runtime ratio checks signed multiples 1, -1 and 3 in both directions.
// Source references and graph-only limitations are recorded in golden.json.

import ".." as units;

type GoldenQuantity = quantity Int in m2_per_s;

type Denomination0 = GoldenQuantity in St;
type Denomination1 = GoldenQuantity in cSt;
type Denomination2 = GoldenQuantity in m2_per_s;
type Denomination3 = GoldenQuantity in mm2_per_s;

fn check_runtime(k: Int) {
    // 1 m2_per_s = 1000000 cSt
    let source_0: Denomination2 = 1m2_per_s;
    let target_0: Denomination1 = 1000000cSt;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "kinematic_viscosity/m2_per_s_to_cSt: forward");
    std::test::assert(right_0 == left_0, "kinematic_viscosity/m2_per_s_to_cSt: reverse");
    std::test::assert_eq_int(left_0 / 1cSt, k * 1000000, "kinematic_viscosity/m2_per_s_to_cSt: target count");
    std::test::assert_eq_int(right_0 / 1m2_per_s, k * 1, "kinematic_viscosity/m2_per_s_to_cSt: source count");

    // 1 St = 100 cSt
    let source_1: Denomination0 = 1St;
    let target_1: Denomination1 = 100cSt;
    let left_1 = k * source_1;
    let right_1 = k * target_1;
    std::test::assert(left_1 == right_1, "kinematic_viscosity/St_to_cSt: forward");
    std::test::assert(right_1 == left_1, "kinematic_viscosity/St_to_cSt: reverse");
    std::test::assert_eq_int(left_1 / 1cSt, k * 100, "kinematic_viscosity/St_to_cSt: target count");
    std::test::assert_eq_int(right_1 / 1St, k * 1, "kinematic_viscosity/St_to_cSt: source count");

    // 1 cSt = 1 mm2_per_s
    let source_2: Denomination1 = 1cSt;
    let target_2: Denomination3 = 1mm2_per_s;
    let left_2 = k * source_2;
    let right_2 = k * target_2;
    std::test::assert(left_2 == right_2, "kinematic_viscosity/cSt_to_mm2_per_s: forward");
    std::test::assert(right_2 == left_2, "kinematic_viscosity/cSt_to_mm2_per_s: reverse");
    std::test::assert_eq_int(left_2 / 1mm2_per_s, k * 1, "kinematic_viscosity/cSt_to_mm2_per_s: target count");
    std::test::assert_eq_int(right_2 / 1cSt, k * 1, "kinematic_viscosity/cSt_to_mm2_per_s: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
