import ".." as units;

type GoldenQuantity = quantity Int in kJ_per_kg_K;

type Denomination0 = GoldenQuantity in J_per_g_K;
type Denomination1 = GoldenQuantity in J_per_kg_K;
type Denomination2 = GoldenQuantity in cal_th_per_g_K;
type Denomination3 = GoldenQuantity in kJ_per_kg_K;

fn check_runtime(k: Int) {
    // 1 J_per_g_K = 1 kJ_per_kg_K
    let source_0: Denomination0 = 1J_per_g_K;
    let target_0: Denomination3 = 1kJ_per_kg_K;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "specific_heat/J_per_g_K_to_kJ_per_kg_K: forward");
    std::test::assert(right_0 == left_0, "specific_heat/J_per_g_K_to_kJ_per_kg_K: reverse");
    std::test::assert_eq_int(left_0 / 1kJ_per_kg_K, k * 1, "specific_heat/J_per_g_K_to_kJ_per_kg_K: target count");
    std::test::assert_eq_int(right_0 / 1J_per_g_K, k * 1, "specific_heat/J_per_g_K_to_kJ_per_kg_K: source count");

    // 1 cal_th_per_g_K = 4184 J_per_kg_K
    let source_1: Denomination2 = 1cal_th_per_g_K;
    let target_1: Denomination1 = 4184J_per_kg_K;
    let left_1 = k * source_1;
    let right_1 = k * target_1;
    std::test::assert(left_1 == right_1, "specific_heat/cal_th_per_g_K_to_J_per_kg_K: forward");
    std::test::assert(right_1 == left_1, "specific_heat/cal_th_per_g_K_to_J_per_kg_K: reverse");
    std::test::assert_eq_int(left_1 / 1J_per_kg_K, k * 4184, "specific_heat/cal_th_per_g_K_to_J_per_kg_K: target count");
    std::test::assert_eq_int(right_1 / 1cal_th_per_g_K, k * 1, "specific_heat/cal_th_per_g_K_to_J_per_kg_K: source count");

    // 125 cal_th_per_g_K = 523 J_per_g_K
    let source_2: Denomination2 = 125cal_th_per_g_K;
    let target_2: Denomination0 = 523J_per_g_K;
    let left_2 = k * source_2;
    let right_2 = k * target_2;
    std::test::assert(left_2 == right_2, "specific_heat/cal_th_per_g_K_to_J_per_g_K: forward");
    std::test::assert(right_2 == left_2, "specific_heat/cal_th_per_g_K_to_J_per_g_K: reverse");
    std::test::assert_eq_int(left_2 / 1J_per_g_K, k * 523, "specific_heat/cal_th_per_g_K_to_J_per_g_K: target count");
    std::test::assert_eq_int(right_2 / 1cal_th_per_g_K, k * 125, "specific_heat/cal_th_per_g_K_to_J_per_g_K: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
