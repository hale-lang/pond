    std::test::assert_eq_int(left_34 / 1F, k * 1000000000, "prefix_capacitance/base_anchor_GF: target count");
    std::test::assert_eq_int(right_34 / 1GF, k * 1, "prefix_capacitance/base_anchor_GF: source count");

    // 1 TF = 1000000000000 F
    let source_35: Denomination7 = 1TF;
    let target_35: Denomination1 = 1000000000000F;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_capacitance/base_anchor_TF: forward");
    std::test::assert(right_35 == left_35, "prefix_capacitance/base_anchor_TF: reverse");
    std::test::assert_eq_int(left_35 / 1F, k * 1000000000000, "prefix_capacitance/base_anchor_TF: target count");
    std::test::assert_eq_int(right_35 / 1TF, k * 1, "prefix_capacitance/base_anchor_TF: source count");

    // 1 PF = 1000000000000000 F
    let source_36: Denomination4 = 1PF;
    let target_36: Denomination1 = 1000000000000000F;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_capacitance/base_anchor_PF: forward");
    std::test::assert(right_36 == left_36, "prefix_capacitance/base_anchor_PF: reverse");
    std::test::assert_eq_int(left_36 / 1F, k * 1000000000000000, "prefix_capacitance/base_anchor_PF: target count");
    std::test::assert_eq_int(right_36 / 1PF, k * 1, "prefix_capacitance/base_anchor_PF: source count");

    // 1 EF = 1000000000000000000 F
    let source_37: Denomination0 = 1EF;
    let target_37: Denomination1 = 1000000000000000000F;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_capacitance/base_anchor_EF: forward");
    std::test::assert(right_37 == left_37, "prefix_capacitance/base_anchor_EF: reverse");
    std::test::assert_eq_int(left_37 / 1F, k * 1000000000000000000, "prefix_capacitance/base_anchor_EF: target count");
    std::test::assert_eq_int(right_37 / 1EF, k * 1, "prefix_capacitance/base_anchor_EF: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
