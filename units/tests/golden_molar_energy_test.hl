// Generated from independent golden.json by generate_golden.py; do not edit.
// molar_energy: 3 runtime ratios, 0 literal-conversion ratios.
// Each runtime ratio checks signed multiples 1, -1 and 3 in both directions.
// Source references and graph-only limitations are recorded in golden.json.

import ".." as units;

type GoldenQuantity = quantity Int in kJ_per_mol;

type Denomination0 = GoldenQuantity in J_per_mol;
type Denomination1 = GoldenQuantity in cal_th_per_mol;
type Denomination2 = GoldenQuantity in kJ_per_mol;

fn check_runtime(k: Int) {
    // 1 kJ_per_mol = 1000 J_per_mol
    let source_0: Denomination2 = 1kJ_per_mol;
    let target_0: Denomination0 = 1000J_per_mol;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "molar_energy/kJ_per_mol_to_J_per_mol: forward");
    std::test::assert(right_0 == left_0, "molar_energy/kJ_per_mol_to_J_per_mol: reverse");
    std::test::assert_eq_int(left_0 / 1J_per_mol, k * 1000, "molar_energy/kJ_per_mol_to_J_per_mol: target count");
    std::test::assert_eq_int(right_0 / 1kJ_per_mol, k * 1, "molar_energy/kJ_per_mol_to_J_per_mol: source count");

    // 125 cal_th_per_mol = 523 J_per_mol
    let source_1: Denomination1 = 125cal_th_per_mol;
    let target_1: Denomination0 = 523J_per_mol;
    let left_1 = k * source_1;
    let right_1 = k * target_1;
    std::test::assert(left_1 == right_1, "molar_energy/cal_th_per_mol_to_J_per_mol: forward");
    std::test::assert(right_1 == left_1, "molar_energy/cal_th_per_mol_to_J_per_mol: reverse");
    std::test::assert_eq_int(left_1 / 1J_per_mol, k * 523, "molar_energy/cal_th_per_mol_to_J_per_mol: target count");
    std::test::assert_eq_int(right_1 / 1cal_th_per_mol, k * 125, "molar_energy/cal_th_per_mol_to_J_per_mol: source count");

    // 523 kJ_per_mol = 125000 cal_th_per_mol
    let source_2: Denomination2 = 523kJ_per_mol;
    let target_2: Denomination1 = 125000cal_th_per_mol;
    let left_2 = k * source_2;
    let right_2 = k * target_2;
    std::test::assert(left_2 == right_2, "molar_energy/kJ_per_mol_to_cal_th_per_mol: forward");
    std::test::assert(right_2 == left_2, "molar_energy/kJ_per_mol_to_cal_th_per_mol: reverse");
    std::test::assert_eq_int(left_2 / 1cal_th_per_mol, k * 125000, "molar_energy/kJ_per_mol_to_cal_th_per_mol: target count");
    std::test::assert_eq_int(right_2 / 1kJ_per_mol, k * 523, "molar_energy/kJ_per_mol_to_cal_th_per_mol: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
