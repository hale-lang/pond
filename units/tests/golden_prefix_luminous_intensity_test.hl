    std::test::assert_eq_int(left_33 / 1cd, k * 1000000, "prefix_luminous_intensity/base_anchor_Mcd: target count");
    std::test::assert_eq_int(right_33 / 1Mcd, k * 1, "prefix_luminous_intensity/base_anchor_Mcd: source count");

    // 1 Gcd = 1000000000 cd
    let source_34: Denomination1 = 1Gcd;
    let target_34: Denomination11 = 1000000000cd;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_luminous_intensity/base_anchor_Gcd: forward");
    std::test::assert(right_34 == left_34, "prefix_luminous_intensity/base_anchor_Gcd: reverse");
    std::test::assert_eq_int(left_34 / 1cd, k * 1000000000, "prefix_luminous_intensity/base_anchor_Gcd: target count");
    std::test::assert_eq_int(right_34 / 1Gcd, k * 1, "prefix_luminous_intensity/base_anchor_Gcd: source count");

    // 1 Tcd = 1000000000000 cd
    let source_35: Denomination6 = 1Tcd;
    let target_35: Denomination11 = 1000000000000cd;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_luminous_intensity/base_anchor_Tcd: forward");
    std::test::assert(right_35 == left_35, "prefix_luminous_intensity/base_anchor_Tcd: reverse");
    std::test::assert_eq_int(left_35 / 1cd, k * 1000000000000, "prefix_luminous_intensity/base_anchor_Tcd: target count");
    std::test::assert_eq_int(right_35 / 1Tcd, k * 1, "prefix_luminous_intensity/base_anchor_Tcd: source count");

    // 1 Pcd = 1000000000000000 cd
    let source_36: Denomination3 = 1Pcd;
    let target_36: Denomination11 = 1000000000000000cd;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_luminous_intensity/base_anchor_Pcd: forward");
    std::test::assert(right_36 == left_36, "prefix_luminous_intensity/base_anchor_Pcd: reverse");
    std::test::assert_eq_int(left_36 / 1cd, k * 1000000000000000, "prefix_luminous_intensity/base_anchor_Pcd: target count");
    std::test::assert_eq_int(right_36 / 1Pcd, k * 1, "prefix_luminous_intensity/base_anchor_Pcd: source count");

    // 1 Ecd = 1000000000000000000 cd
    let source_37: Denomination0 = 1Ecd;
    let target_37: Denomination11 = 1000000000000000000cd;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_luminous_intensity/base_anchor_Ecd: forward");
    std::test::assert(right_37 == left_37, "prefix_luminous_intensity/base_anchor_Ecd: reverse");
    std::test::assert_eq_int(left_37 / 1cd, k * 1000000000000000000, "prefix_luminous_intensity/base_anchor_Ecd: target count");
    std::test::assert_eq_int(right_37 / 1Ecd, k * 1, "prefix_luminous_intensity/base_anchor_Ecd: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
