    let target_2: Denomination3 = 3600000ms;
    let left_2 = k * source_2;
    let right_2 = k * target_2;
    std::test::assert(left_2 == right_2, "time/h_to_ms: forward");
    std::test::assert(right_2 == left_2, "time/h_to_ms: reverse");
    let source_unit_2: Denomination1 = 1h;
    let target_unit_2: Denomination3 = 1ms;
    std::test::assert_eq_int(left_2 / target_unit_2, k * 3600000, "time/h_to_ms: target count");
    std::test::assert_eq_int(right_2 / source_unit_2, k * 1, "time/h_to_ms: source count");

    // 1 min = 60000000 us
    let source_3: Denomination2 = 1min;
    let target_3: Denomination6 = 60000000us;
    let left_3 = k * source_3;
    let right_3 = k * target_3;
    std::test::assert(left_3 == right_3, "time/min_to_us: forward");
    std::test::assert(right_3 == left_3, "time/min_to_us: reverse");
    let source_unit_3: Denomination2 = 1min;
    let target_unit_3: Denomination6 = 1us;
    std::test::assert_eq_int(left_3 / target_unit_3, k * 60000000, "time/min_to_us: target count");
    std::test::assert_eq_int(right_3 / source_unit_3, k * 1, "time/min_to_us: source count");

    // Exact widening to picoseconds avoids Hale codegen mixing its primitive Duration class with an Int-backed boundary at the canonical nanosecond meet; the signed ratio and both quotient counts are still checked at runtime.
    // 1 s = 1000000000 ns
    let source_4: Denomination5 = 1s;
    let target_4: Denomination4 = 1000000000ns;
    let left_4 = (k * source_4).in(ps);
    let right_4 = (k * target_4).in(ps);
    std::test::assert(left_4 == right_4, "time/s_to_ns: forward");
    std::test::assert(right_4 == left_4, "time/s_to_ns: reverse");
    let source_unit_4: Denomination5 = 1s;
    let target_unit_4: Denomination4 = 1ns;
    std::test::assert_eq_int(left_4 / target_unit_4, k * 1000000000, "time/s_to_ns: target count");
    std::test::assert_eq_int(right_4 / source_unit_4, k * 1, "time/s_to_ns: source count");

    // 1 week = 7 day
    let source_5: Denomination7 = 1week;
    let target_5: Denomination0 = 7day;
    let left_5 = k * source_5;
    let right_5 = k * target_5;
