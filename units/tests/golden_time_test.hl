    std::test::assert(right_5 == left_5, "time/week_to_day: reverse");
    let source_unit_5: Denomination7 = 1week;
    let target_unit_5: Denomination0 = 1day;
    std::test::assert_eq_int(left_5 / target_unit_5, k * 7, "time/week_to_day: target count");
