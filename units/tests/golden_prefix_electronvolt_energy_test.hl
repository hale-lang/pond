    std::test::assert_eq_int(right_33 / 1MeV, k * 1, "prefix_electronvolt_energy/base_anchor_MeV: source count");

    // 1 GeV = 1000000000 eV
    let source_34: Denomination1 = 1GeV;
    let target_34: Denomination13 = 1000000000eV;
    let left_34 = k * source_34;
    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_electronvolt_energy/base_anchor_GeV: forward");
    std::test::assert(right_34 == left_34, "prefix_electronvolt_energy/base_anchor_GeV: reverse");
    std::test::assert_eq_int(left_34 / 1eV, k * 1000000000, "prefix_electronvolt_energy/base_anchor_GeV: target count");
    std::test::assert_eq_int(right_34 / 1GeV, k * 1, "prefix_electronvolt_energy/base_anchor_GeV: source count");

    // 1 TeV = 1000000000000 eV
    let source_35: Denomination6 = 1TeV;
    let target_35: Denomination13 = 1000000000000eV;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_electronvolt_energy/base_anchor_TeV: forward");
    std::test::assert(right_35 == left_35, "prefix_electronvolt_energy/base_anchor_TeV: reverse");
    std::test::assert_eq_int(left_35 / 1eV, k * 1000000000000, "prefix_electronvolt_energy/base_anchor_TeV: target count");
    std::test::assert_eq_int(right_35 / 1TeV, k * 1, "prefix_electronvolt_energy/base_anchor_TeV: source count");

    // 1 PeV = 1000000000000000 eV
    let source_36: Denomination3 = 1PeV;
    let target_36: Denomination13 = 1000000000000000eV;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_electronvolt_energy/base_anchor_PeV: forward");
    std::test::assert(right_36 == left_36, "prefix_electronvolt_energy/base_anchor_PeV: reverse");
    std::test::assert_eq_int(left_36 / 1eV, k * 1000000000000000, "prefix_electronvolt_energy/base_anchor_PeV: target count");
    std::test::assert_eq_int(right_36 / 1PeV, k * 1, "prefix_electronvolt_energy/base_anchor_PeV: source count");

    // 1 EeV = 1000000000000000000 eV
    let source_37: Denomination0 = 1EeV;
    let target_37: Denomination13 = 1000000000000000000eV;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_electronvolt_energy/base_anchor_EeV: forward");
    std::test::assert(right_37 == left_37, "prefix_electronvolt_energy/base_anchor_EeV: reverse");
    std::test::assert_eq_int(left_37 / 1eV, k * 1000000000000000000, "prefix_electronvolt_energy/base_anchor_EeV: target count");
    std::test::assert_eq_int(right_37 / 1EeV, k * 1, "prefix_electronvolt_energy/base_anchor_EeV: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
