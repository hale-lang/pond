// Generated from independent golden.json by generate_golden.py; do not edit.
// surface_tension: 2 runtime ratios, 0 literal-conversion ratios.
// Each runtime ratio checks signed multiples 1, -1 and 3 in both directions.
// Source references and graph-only limitations are recorded in golden.json.

import ".." as units;

type GoldenQuantity = quantity Int in N_per_m;

type Denomination0 = GoldenQuantity in N_per_m;
type Denomination1 = GoldenQuantity in dyn_per_cm;
type Denomination2 = GoldenQuantity in mN_per_m;

fn check_runtime(k: Int) {
    // 1 N_per_m = 1000 dyn_per_cm
    let source_0: Denomination0 = 1N_per_m;
    let target_0: Denomination1 = 1000dyn_per_cm;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "surface_tension/N_per_m_to_dyn_per_cm: forward");
    std::test::assert(right_0 == left_0, "surface_tension/N_per_m_to_dyn_per_cm: reverse");
    std::test::assert_eq_int(left_0 / 1dyn_per_cm, k * 1000, "surface_tension/N_per_m_to_dyn_per_cm: target count");
    std::test::assert_eq_int(right_0 / 1N_per_m, k * 1, "surface_tension/N_per_m_to_dyn_per_cm: source count");

    // 1 dyn_per_cm = 1 mN_per_m
    let source_1: Denomination1 = 1dyn_per_cm;
    let target_1: Denomination2 = 1mN_per_m;
    let left_1 = k * source_1;
    let right_1 = k * target_1;
    std::test::assert(left_1 == right_1, "surface_tension/dyn_per_cm_to_mN_per_m: forward");
    std::test::assert(right_1 == left_1, "surface_tension/dyn_per_cm_to_mN_per_m: reverse");
    std::test::assert_eq_int(left_1 / 1mN_per_m, k * 1, "surface_tension/dyn_per_cm_to_mN_per_m: target count");
    std::test::assert_eq_int(right_1 / 1dyn_per_cm, k * 1, "surface_tension/dyn_per_cm_to_mN_per_m: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
