    let right_34 = k * target_34;
    std::test::assert(left_34 == right_34, "prefix_illuminance/base_anchor_Glx: forward");
    std::test::assert(right_34 == left_34, "prefix_illuminance/base_anchor_Glx: reverse");
    std::test::assert_eq_int(left_34 / 1lx, k * 1000000000, "prefix_illuminance/base_anchor_Glx: target count");
    std::test::assert_eq_int(right_34 / 1Glx, k * 1, "prefix_illuminance/base_anchor_Glx: source count");

    // 1 Tlx = 1000000000000 lx
    let source_35: Denomination6 = 1Tlx;
    let target_35: Denomination16 = 1000000000000lx;
    let left_35 = k * source_35;
    let right_35 = k * target_35;
    std::test::assert(left_35 == right_35, "prefix_illuminance/base_anchor_Tlx: forward");
    std::test::assert(right_35 == left_35, "prefix_illuminance/base_anchor_Tlx: reverse");
    std::test::assert_eq_int(left_35 / 1lx, k * 1000000000000, "prefix_illuminance/base_anchor_Tlx: target count");
    std::test::assert_eq_int(right_35 / 1Tlx, k * 1, "prefix_illuminance/base_anchor_Tlx: source count");

    // 1 Plx = 1000000000000000 lx
    let source_36: Denomination3 = 1Plx;
    let target_36: Denomination16 = 1000000000000000lx;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_illuminance/base_anchor_Plx: forward");
    std::test::assert(right_36 == left_36, "prefix_illuminance/base_anchor_Plx: reverse");
    std::test::assert_eq_int(left_36 / 1lx, k * 1000000000000000, "prefix_illuminance/base_anchor_Plx: target count");
    std::test::assert_eq_int(right_36 / 1Plx, k * 1, "prefix_illuminance/base_anchor_Plx: source count");

    // 1 Elx = 1000000000000000000 lx
    let source_37: Denomination0 = 1Elx;
    let target_37: Denomination16 = 1000000000000000000lx;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_illuminance/base_anchor_Elx: forward");
    std::test::assert(right_37 == left_37, "prefix_illuminance/base_anchor_Elx: reverse");
    std::test::assert_eq_int(left_37 / 1lx, k * 1000000000000000000, "prefix_illuminance/base_anchor_Elx: target count");
    std::test::assert_eq_int(right_37 / 1Elx, k * 1, "prefix_illuminance/base_anchor_Elx: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
