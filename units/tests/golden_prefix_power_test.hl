    let target_36: Denomination7 = 1000000000000000W;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_power/base_anchor_PW: forward");
    std::test::assert(right_36 == left_36, "prefix_power/base_anchor_PW: reverse");
    std::test::assert_eq_int(left_36 / 1W, k * 1000000000000000, "prefix_power/base_anchor_PW: target count");
    std::test::assert_eq_int(right_36 / 1PW, k * 1, "prefix_power/base_anchor_PW: source count");

    // 1 EW = 1000000000000000000 W
    let source_37: Denomination0 = 1EW;
    let target_37: Denomination7 = 1000000000000000000W;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_power/base_anchor_EW: forward");
    std::test::assert(right_37 == left_37, "prefix_power/base_anchor_EW: reverse");
    std::test::assert_eq_int(left_37 / 1W, k * 1000000000000000000, "prefix_power/base_anchor_EW: target count");
    std::test::assert_eq_int(right_37 / 1EW, k * 1, "prefix_power/base_anchor_EW: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
