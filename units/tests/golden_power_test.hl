import ".." as units;

type GoldenQuantity = quantity Int in QW;

type Denomination0 = GoldenQuantity in Btu_IT_per_h;
type Denomination1 = GoldenQuantity in W;
type Denomination2 = GoldenQuantity in hp_mech;
type Denomination3 = GoldenQuantity in hp_metric;
type Denomination4 = GoldenQuantity in kW;

fn check_runtime(k: Int) {
    // 800 hp_metric = 588399 W
    let source_0: Denomination3 = 800hp_metric;
    let target_0: Denomination1 = 588399W;
    let left_0 = k * source_0;
    let right_0 = k * target_0;
    std::test::assert(left_0 == right_0, "power/hp_metric_to_W: forward");
    std::test::assert(right_0 == left_0, "power/hp_metric_to_W: reverse");
    std::test::assert_eq_int(left_0 / 1W, k * 588399, "power/hp_metric_to_W: target count");
    std::test::assert_eq_int(right_0 / 1hp_metric, k * 800, "power/hp_metric_to_W: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);

    // The exact common-denomination product exceeds runtime i64 headroom; compare compiler-converted literal counts in both directions instead.
