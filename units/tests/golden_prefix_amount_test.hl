    std::test::assert_eq_int(left_35 / 1mol, k * 1000000000000, "prefix_amount/base_anchor_Tmol: target count");
    std::test::assert_eq_int(right_35 / 1Tmol, k * 1, "prefix_amount/base_anchor_Tmol: source count");

    // 1 Pmol = 1000000000000000 mol
    let source_36: Denomination3 = 1Pmol;
    let target_36: Denomination17 = 1000000000000000mol;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_amount/base_anchor_Pmol: forward");
    std::test::assert(right_36 == left_36, "prefix_amount/base_anchor_Pmol: reverse");
    std::test::assert_eq_int(left_36 / 1mol, k * 1000000000000000, "prefix_amount/base_anchor_Pmol: target count");
    std::test::assert_eq_int(right_36 / 1Pmol, k * 1, "prefix_amount/base_anchor_Pmol: source count");

    // 1 Emol = 1000000000000000000 mol
    let source_37: Denomination0 = 1Emol;
    let target_37: Denomination17 = 1000000000000000000mol;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_amount/base_anchor_Emol: forward");
    std::test::assert(right_37 == left_37, "prefix_amount/base_anchor_Emol: reverse");
    std::test::assert_eq_int(left_37 / 1mol, k * 1000000000000000000, "prefix_amount/base_anchor_Emol: target count");
    std::test::assert_eq_int(right_37 / 1Emol, k * 1, "prefix_amount/base_anchor_Emol: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
