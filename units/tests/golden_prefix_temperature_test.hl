    std::test::assert_eq_int(right_35 / 1TK, k * 1, "prefix_temperature/base_anchor_TK: source count");

    // 1 PK = 1000000000000000 K
    let source_36: Denomination4 = 1PK;
    let target_36: Denomination2 = 1000000000000000K;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_temperature/base_anchor_PK: forward");
    std::test::assert(right_36 == left_36, "prefix_temperature/base_anchor_PK: reverse");
    std::test::assert_eq_int(left_36 / 1K, k * 1000000000000000, "prefix_temperature/base_anchor_PK: target count");
    std::test::assert_eq_int(right_36 / 1PK, k * 1, "prefix_temperature/base_anchor_PK: source count");

    // 1 EK = 1000000000000000000 K
    let source_37: Denomination0 = 1EK;
    let target_37: Denomination2 = 1000000000000000000K;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_temperature/base_anchor_EK: forward");
    std::test::assert(right_37 == left_37, "prefix_temperature/base_anchor_EK: reverse");
    std::test::assert_eq_int(left_37 / 1K, k * 1000000000000000000, "prefix_temperature/base_anchor_EK: target count");
    std::test::assert_eq_int(right_37 / 1EK, k * 1, "prefix_temperature/base_anchor_EK: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
