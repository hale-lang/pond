    // 1 Eg = 1000000000000000000 g
    let source_37: Denomination0 = 1Eg;
    let target_37: Denomination14 = 1000000000000000000g;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_mass/base_anchor_Eg: forward");
    std::test::assert(right_37 == left_37, "prefix_mass/base_anchor_Eg: reverse");
    std::test::assert_eq_int(left_37 / 1g, k * 1000000000000000000, "prefix_mass/base_anchor_Eg: target count");
    std::test::assert_eq_int(right_37 / 1Eg, k * 1, "prefix_mass/base_anchor_Eg: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
