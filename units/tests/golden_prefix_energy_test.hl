    std::test::assert_eq_int(left_35 / 1J, k * 1000000000000, "prefix_energy/base_anchor_TJ: target count");
    std::test::assert_eq_int(right_35 / 1TJ, k * 1, "prefix_energy/base_anchor_TJ: source count");

    // 1 PJ = 1000000000000000 J
    let source_36: Denomination4 = 1PJ;
    let target_36: Denomination2 = 1000000000000000J;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_energy/base_anchor_PJ: forward");
    std::test::assert(right_36 == left_36, "prefix_energy/base_anchor_PJ: reverse");
    std::test::assert_eq_int(left_36 / 1J, k * 1000000000000000, "prefix_energy/base_anchor_PJ: target count");
    std::test::assert_eq_int(right_36 / 1PJ, k * 1, "prefix_energy/base_anchor_PJ: source count");

    // 1 EJ = 1000000000000000000 J
    let source_37: Denomination0 = 1EJ;
    let target_37: Denomination2 = 1000000000000000000J;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_energy/base_anchor_EJ: forward");
    std::test::assert(right_37 == left_37, "prefix_energy/base_anchor_EJ: reverse");
    std::test::assert_eq_int(left_37 / 1J, k * 1000000000000000000, "prefix_energy/base_anchor_EJ: target count");
    std::test::assert_eq_int(right_37 / 1EJ, k * 1, "prefix_energy/base_anchor_EJ: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
