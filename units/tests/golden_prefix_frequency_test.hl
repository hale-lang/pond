    std::test::assert_eq_int(right_35 / 1THz, k * 1, "prefix_frequency/base_anchor_THz: source count");

    // 1 PHz = 1000000000000000 Hz
    let source_36: Denomination4 = 1PHz;
    let target_36: Denomination2 = 1000000000000000Hz;
    let left_36 = k * source_36;
    let right_36 = k * target_36;
    std::test::assert(left_36 == right_36, "prefix_frequency/base_anchor_PHz: forward");
    std::test::assert(right_36 == left_36, "prefix_frequency/base_anchor_PHz: reverse");
    std::test::assert_eq_int(left_36 / 1Hz, k * 1000000000000000, "prefix_frequency/base_anchor_PHz: target count");
    std::test::assert_eq_int(right_36 / 1PHz, k * 1, "prefix_frequency/base_anchor_PHz: source count");

    // 1 EHz = 1000000000000000000 Hz
    let source_37: Denomination0 = 1EHz;
    let target_37: Denomination2 = 1000000000000000000Hz;
    let left_37 = k * source_37;
    let right_37 = k * target_37;
    std::test::assert(left_37 == right_37, "prefix_frequency/base_anchor_EHz: forward");
    std::test::assert(right_37 == left_37, "prefix_frequency/base_anchor_EHz: reverse");
    std::test::assert_eq_int(left_37 / 1Hz, k * 1000000000000000000, "prefix_frequency/base_anchor_EHz: target count");
    std::test::assert_eq_int(right_37 / 1EHz, k * 1, "prefix_frequency/base_anchor_EHz: source count");

}

fn main() {
    check_runtime(1);
    check_runtime(-1);
    check_runtime(3);
}
