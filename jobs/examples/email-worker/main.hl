// email-worker — end-to-end demo for pond/jobs over the REAL
// pond/sqlite driver.
//
// What it does:
//   1. Opens /tmp/pond-jobs-email-demo.db and drops the queue
//      table so every run starts fresh (idempotent).
//   2. Constructs a jobs::Queue over the connection (birth runs
//      the schema bringup) and enqueues 10 "send_email" jobs plus
//      one poison "send_fax" job (max_attempts = 2).
//   3. Runs a jobs::Pool with 2 workers and exit_on_empty, so the
//      workers drain the queue and exit. The handler prints one
//      "sent:" line per delivered email; the poison job is
//      rejected, retried once (attempt 0 → 1), then dead-lettered.
//   4. Verifies the row states in the real table:
//      done=10, failed=1, ready=0.
//
// Per pond's no-transitive-deps rule (and hale.toml [ffi]
// auto-pickup, which only scans DIRECT imports), this app imports
// pond/sqlite itself even though pond/jobs also uses it.
//
// Build & run (the [ffi] section links libsqlite3):
//     hale build jobs/examples/email-worker/
//     ./jobs/examples/email-worker/email-worker

import "../.." as jobs;
import "../../../sqlite" as sqlite;

// EmailHandler — satisfies jobs::JobHandler structurally
// (fn invoke(j) -> JobResult). Delivers "send_email" jobs;
// bounces anything else so the demo exercises the retry +
// dead-letter path too.
locus EmailHandler {
    params { delivered: Int = 0; }
    fn invoke(j: jobs::Job) -> jobs::JobResult {
        if j.kind == "send_email" {
            self.delivered = self.delivered + 1;
            println("sent: #", to_string(j.id), " ", j.payload);
            return jobs::JobResult { ok: true, detail: "delivered" };
        }
        println("bounce: #", to_string(j.id), " kind '", j.kind,
                "' (attempt ", to_string(j.attempt), "/",
                to_string(j.max_attempts), ")");
        return jobs::JobResult { ok: false, detail: "unknown kind" };
    }
}

locus EmailWorkerDemo {
    params {
        path:       String = "/tmp/pond-jobs-email-demo.db";
        total_jobs: Int    = 10;
        workers:    Int    = 2;
    }

    // Enqueue error bridge: print and substitute id 0.
    fn note(e: jobs::JobError) -> Int {
        println("[email-worker] JobError: ", e.kind, " — ", e.detail);
        return 0;
    }

    // The pool lives inside this member fn so its dissolve cascade
    // (which joins every worker) completes before run() verifies
    // the table.
    fn run_pool(q: jobs::Queue, h: EmailHandler) -> Int {
        let pool = jobs::Pool {
            queue:         q,
            workers:       self.workers,
            handler:       h,
            exit_on_empty: true,
        };
        let _ = pool;
        return 0;
    }

    run() {
        println("[email-worker] db: ", self.path);
        let conn = sqlite::Db { path: self.path };

        // Fresh start every run (self-cleaning).
        let _ = conn.exec("DROP TABLE IF EXISTS pond_jobs")
            or sqlite::ExecResult { };

        // Queue.birth() runs CREATE TABLE IF NOT EXISTS.
        let q = jobs::Queue { db: conn };

        // Enqueue 10 send_email jobs + 1 poison job.
        let mut i = 0;
        while i < self.total_jobs {
            let payload = "to=user" + to_string(i) + "@example.com";
            let id = q.enqueue("send_email", payload, 3) or self.note(err);
            let _ = id;
            i = i + 1;
        }
        let _ = q.enqueue("send_fax", "to=nobody", 2) or self.note(err);
        println("[email-worker] enqueued ", to_string(self.total_jobs),
                " send_email jobs + 1 poison send_fax job");

        // Drain the queue through the pool.
        let h = EmailHandler { };
        let _ = self.run_pool(q, h);
        println("[email-worker] pool drained; all workers joined");

        // Verify against the real table.
        let done = conn.query_one(
            "SELECT count(*) FROM pond_jobs WHERE state = 'done'"
        ) or sqlite::Row { data: "?" };
        let failed = conn.query_one(
            "SELECT count(*) FROM pond_jobs WHERE state = 'failed'"
        ) or sqlite::Row { data: "?" };
        let ready = conn.query_one(
            "SELECT count(*) FROM pond_jobs WHERE state = 'ready'"
        ) or sqlite::Row { data: "?" };
        println("[email-worker] table states: done=", done.data,
                " failed=", failed.data, " ready=", ready.data);

        if done.data == to_string(self.total_jobs) && failed.data == "1" {
            println("[email-worker] OK — ", done.data,
                    " delivered + acked, 1 dead-lettered after retry");
        } else {
            println("[email-worker] FAIL — unexpected row states");
        }
    }
}

fn main() {
    EmailWorkerDemo { };
}
