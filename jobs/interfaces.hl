// pond/jobs — public interface.
//
// Per CONTRACTS.md the public surface declares one structural
// interface:
//
//   interface JobHandler { fn invoke(j: Job) -> JobResult; }
//
// Per spec/types.md § F.20, satisfaction is implicit — any
// locus whose method set covers this signature structurally
// satisfies the interface.
//
// As of HEAD 43300e5 (2026-06-12), interface values CAN sit in
// locus params, so `Pool.params.handler: JobHandler` holds one
// directly — the fn-pointer shadow this file used to document is
// gone. Consumers declare a handler locus:
//
//   locus EmailHandler {
//       params { sent: Int = 0; }
//       fn invoke(j: jobs::Job) -> jobs::JobResult { ... }
//   }
//   ...
//   jobs::Pool { queue: q, handler: EmailHandler { }, ... };

interface JobHandler {
    fn invoke(j: Job) -> JobResult;
}
