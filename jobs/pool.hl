// pond/jobs — Pool + Worker (service locus + worker children).
//
// Two service loci (pattern 3):
//
//   Pool   — cooperative parent. Holds the queue ref, the handler,
//            and the worker fan-out. Spawns N Workers in birth()
//            so they attach as Pool children and dissolve when
//            Pool does.
//   Worker — child of Pool. Its run() loop is the dequeue →
//            invoke → ack/fail cycle. Placement is the consuming
//            app's choice (F.31): the app that instantiates the
//            pool declares `placement { worker_field: pinned(...) }`
//            in ITS main locus if it wants the workers on
//            dedicated threads; default is cooperative.
//
// CONTRACTS.md sketch, now matched directly:
//
//   locus Pool {
//       params { queue: Queue; workers: Int = 4; handler: JobHandler; }
//       birth() { /* spawn workers */ }
//       drain() { /* finish in-flight */ }
//   }
//
// Both former deviations are closed at HEAD 43300e5
// (FRICTION.log items 3 + interface-in-params):
//   - `queue: Queue` IS a locus-ref param now (no db_path/table
//     primitive-identity shadow).
//   - `handler: JobHandler` IS an interface-typed param now (no
//     fn-pointer shadow). The consumer passes any locus whose
//     method set covers `fn invoke(j: Job) -> JobResult`.
//
// One residual wrinkle (FRICTION.log item 15): an interface VALUE
// can't be re-injected into another interface-typed param ("type
// `JobHandler` cannot satisfy interface `JobHandler` — only loci
// satisfy interfaces"), so Pool can't copy `self.handler` into a
// Worker param. Workers instead hold a `pool: Pool` back-ref and
// dispatch through `Pool.run_job(j)`, which invokes the handler
// one hop from where it was injected.
//
// Worker exit (FRICTION.log items 5/14, refreshed): there is still
// no parent→worker stop signal, so the worker loop is bounded by
// `max_jobs_per_worker > 0` (exit after N handler invocations)
// and/or `exit_on_empty = true` (exit when dequeue reports the
// queue drained). A pool with both at defaults (0 / false) polls
// forever — fine for a daemon, wrong for a batch demo.

locus Pool {
    params {
        // The queue the workers consume. Caller-owned locus ref —
        // construct the Queue (over its own sqlite::Db), then
        // inject it here.
        queue: Queue;

        // Worker fan-out count. `workers = 0` is degenerate but
        // legal — birth() just doesn't spawn anything.
        workers: Int = 4;

        // The job handler — any locus satisfying JobHandler
        // (interfaces.hl). Copied into each Worker.
        handler: JobHandler;

        // Per-worker invocation cap. > 0 → each worker exits after
        // that many handler invocations; 0 → no cap.
        max_jobs_per_worker: Int = 0;

        // When true, a worker exits as soon as dequeue reports
        // "empty" (queue drained). The batch-shape exit used by
        // examples/email-worker; daemons leave it false and keep
        // polling.
        exit_on_empty: Bool = false;
    }

    // Parent-side accept hook. Pool accepts Worker children; the
    // type check at the accept site enforces the per-child-type
    // rule. Always accepts.
    accept(w: Worker) { }

    // birth() — fan out N workers as statement-position child
    // literals. Each attaches as a Pool child and dissolves with
    // Pool (the dissolve cascade joins each worker after its
    // run() returns).
    birth() {
        let mut i = 0;
        while i < self.workers {
            Worker {
                worker_id:     i,
                queue:         self.queue,
                max_jobs:      self.max_jobs_per_worker,
                exit_on_empty: self.exit_on_empty,
                pool:          self,
            };
            i = i + 1;
        }
    }

    // run_job — invoke the injected handler. Exists because an
    // interface value can't be copied into a Worker param (see
    // header); workers call back through their pool ref.
    fn run_job(j: Job) -> JobResult {
        return self.handler.invoke(j);
    }

    // The workers carry the work; Pool just owns their lifecycle.
    run() { }
    drain() { }
    dissolve() { }

    // on_failure — restart-strategy hook (F.9). If a Worker's
    // structural channel fires, restart it on fresh state with the
    // same params (v0 default cap: 2 attempts per worker; past the
    // cap the violation bubbles to Pool's parent).
    //
    // **duplicate-suspected (FRICTION.log item 8)**: this is
    // pond/supervisor's one_for_one strategy, open-coded.
    on_failure(w: Worker, err: ClosureViolation) {
        println("[jobs::Pool] worker ", err.locus,
                " failed (", err.closure, "); restarting");
        restart(w);
    }
}

// Worker — one child executing the dequeue → invoke → ack/fail
// loop against the shared Queue.
locus Worker {
    params {
        // Stable per-worker identifier for log lines.
        worker_id: Int = 0;

        // Shared queue ref (copied in from Pool.params).
        queue: Queue;

        // Bounded run loop: > 0 → exit after that many handler
        // invocations; 0 → unbounded (until exit_on_empty or
        // Pool's dissolve).
        max_jobs: Int = 0;

        // Exit when the queue reports empty (see Pool docs).
        exit_on_empty: Bool = false;

        // Back-ref to the spawning Pool — the handler dispatch
        // path (see Pool.run_job).
        pool: Pool;

        // --- private accounting ---
        jobs_done: Int  = 0;
        saw_empty: Bool = false;
    }

    // run() — the worker loop:
    //   1. dequeue — claim the oldest ready row.
    //   2. handler.invoke(j) — run the user handler.
    //   3. ack on r.ok; fail(retry = attempt+1 < max_attempts)
    //      otherwise.
    // "empty" → sleep-and-retry (or exit, per exit_on_empty);
    // db errors → logged, back off, retry.
    run() {
        let idle = 25ms;
        let mut keep_going = true;
        while keep_going {
            if self.max_jobs > 0 && self.jobs_done >= self.max_jobs {
                keep_going = false;
            } else {
                self.saw_empty = false;
                let j = self.queue.dequeue() or self.__on_dequeue_err(err);
                if j.id > 0 {
                    let r = self.pool.run_job(j);
                    if r.ok {
                        self.queue.ack(j.id) or self.__note(err);
                    } else {
                        let retry = j.attempt + 1 < j.max_attempts;
                        self.queue.fail(j.id, retry) or self.__note(err);
                    }
                    self.jobs_done = self.jobs_done + 1;
                } else if self.saw_empty && self.exit_on_empty {
                    keep_going = false;
                } else {
                    // empty (polling mode) or a db error: back off.
                    std::time::sleep(idle);
                }
            }
        }
    }

    // Dequeue error bridge: "empty" is the idle signal (not worth
    // a log line); anything else is logged. Returns the id=0
    // sentinel Job the loop branches on.
    fn __on_dequeue_err(e: JobError) -> Job {
        if e.kind == "empty" {
            self.saw_empty = true;
        } else {
            println("[jobs::Worker ", to_string(self.worker_id),
                    "] dequeue error: ", e.kind, " — ", e.detail);
        }
        return Job { };
    }

    // ack/fail error bridge: log and move on (the row stays
    // in_flight; a sweeper or manual replay handles it — v1 has
    // no automatic reclaim).
    fn __note(e: JobError) {
        println("[jobs::Worker ", to_string(self.worker_id),
                "] ack/fail error: ", e.kind, " — ", e.detail);
    }
}
