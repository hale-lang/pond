// pond/jobs — the Queue service locus.
//
// Pattern 3 (service locus), now matching CONTRACTS.md § pond/jobs
// (modulo the Job.id addition — FRICTION.log item 6):
//
//   locus Queue {
//       params { db: Db; table: String = "pond_jobs"; }
//       fn enqueue(kind, payload, max_attempts) -> Int fallible(JobError);
//       fn dequeue() -> Job fallible(JobError);
//       fn ack(job_id: Int) -> () fallible(JobError);
//       fn fail(job_id: Int, retry: Bool) -> () fallible(JobError);
//   }
//
// `db` is an injected pond/sqlite `Db` — the CALLER owns its
// lifecycle (opens it, keeps it alive while the Queue lives,
// closes it via scope exit). Holding a locus ref in another
// locus's params works at HEAD (FRICTION.log item 3, closed
// 2026-06-12); the ref does not cascade-dissolve with the Queue.
//
// birth() runs the schema bringup (CREATE TABLE IF NOT EXISTS —
// idempotent). Lifecycle methods can't be fallible, so a bringup
// failure stamps `schema_error` and every queue op reports it as
// `JobError { kind: "db", ... }` — the same first-call pattern
// pond/sqlite uses for open failures.
//
// Error bridging: `or handler(err)` handlers may themselves be
// fallible since hale 400ac68 (implicit propagation through the
// enclosing fn's error path), so converting a sqlite DbError into
// our JobError is a direct fallible bridge fn per success shape —
// `or self.__db_int(err)` etc. The old stash-member-fn pattern
// (private err_kind/err_detail params + `self.__check() or raise`
// after every op) is retired, and with it its non-reentrancy
// hazard (FRICTION.log § pond/jobs item 16, closed 2026-07-04).
// The statement-bearing paths finalize their stmt before failing
// so a failed bind/step can't leak the handle.
//
// Schema:
//   CREATE TABLE IF NOT EXISTS <table> (
//       id            INTEGER PRIMARY KEY AUTOINCREMENT,
//       kind          TEXT    NOT NULL,
//       payload       TEXT    NOT NULL,
//       attempt       INTEGER NOT NULL DEFAULT 0,
//       max_attempts  INTEGER NOT NULL DEFAULT 3,
//       state         TEXT    NOT NULL DEFAULT 'ready',
//       claimed_at    INTEGER,
//       last_error    TEXT
//   );
//   CREATE INDEX IF NOT EXISTS <table>_state_id ON <table>(state, id);
//
// Row state machine:
//   'ready'     → claimable by dequeue
//   'in_flight' → claimed (worker is running)
//   'done'      → acked (kept for audit, sweepable)
//   'failed'    → max_attempts exhausted (dead-letter)
//
// dequeue() flips ready→in_flight; ack() flips in_flight→done;
// fail(retry=true) flips in_flight→ready (attempt++);
// fail(retry=false) flips in_flight→failed. The (state, id) index
// makes the dequeue scan an index range scan.

import "../sqlite" as sqlite;

locus Queue {
    params {
        // Injected pond/sqlite connection (caller-owned).
        db: sqlite::Db;

        // Table name for the queue rows. Default matches
        // CONTRACTS.md so cross-lib code agrees on the schema
        // identifier without per-call configuration.
        table: String = "pond_jobs";

        // --- private state (not part of the contract) ---

        // Stamped by birth() when the schema bringup fails;
        // every op then fails kind="db" until fixed. (birth is a
        // lifecycle body — it can't be fallible, so this one
        // stash survives the item-16 cleanup.)
        schema_error: String = "";
    }

    // birth() — run the (idempotent) schema bringup over the
    // injected db. Failures stamp schema_error; see header.
    birth() {
        let create = "CREATE TABLE IF NOT EXISTS " + self.table + " ("
            + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
            + "kind TEXT NOT NULL, "
            + "payload TEXT NOT NULL, "
            + "attempt INTEGER NOT NULL DEFAULT 0, "
            + "max_attempts INTEGER NOT NULL DEFAULT 3, "
            + "state TEXT NOT NULL DEFAULT 'ready', "
            + "claimed_at INTEGER, "
            + "last_error TEXT)";
        let _ = self.db.exec(create) or self.__schema_err(err);
        let idx = "CREATE INDEX IF NOT EXISTS " + self.table
            + "_state_id ON " + self.table + "(state, id)";
        let _ = self.db.exec(idx) or self.__schema_err(err);
    }

    // ---- public surface (CONTRACTS.md) ----

    // enqueue — append a new ready row; returns its row id.
    // kind / payload travel as real bind parameters (?1/?2), not
    // string splicing — externally-sourced values never touch the
    // SQL text (FRICTION.log item 9, closed).
    fn enqueue(
        kind: String,
        payload: String,
        max_attempts: Int
    ) -> Int fallible(JobError) {
        self.__guard() or raise;
        let sql = "INSERT INTO " + self.table
            + " (kind, payload, attempt, max_attempts, state)"
            + " VALUES (?1, ?2, 0, ?3, 'ready')";
        let stmt = self.db.prepare(sql) or self.__db_int(err);
        self.db.bind_text(stmt, 1, kind) or self.__db_unit_fin(err, stmt);
        self.db.bind_text(stmt, 2, payload) or self.__db_unit_fin(err, stmt);
        self.db.bind_int(stmt, 3, max_attempts) or self.__db_unit_fin(err, stmt);
        // step on an INSERT lands on SQLITE_DONE, which the
        // sqlite driver reports as kind="no_row" — that's the
        // SUCCESS path here, so the bridge treats it as success.
        let _ = self.db.step(stmt) or self.__db_step_fin(err, stmt);
        self.db.finalize(stmt) or self.__db_unit(err);
        let row = self.db.query_one("SELECT last_insert_rowid()")
            or self.__db_row(err);
        return std::str::parse_int(row.data) or 0;
    }

    // dequeue — claim the oldest ready row (FIFO). The standard
    // at-least-once claim: SELECT the oldest ready row, then
    // UPDATE ... WHERE id = <id> AND state = 'ready'. If the
    // UPDATE affected 0 rows another worker won the race — rescan
    // (bounded) rather than fail, so contention stays invisible
    // to the caller. Zero ready rows → fail kind="empty".
    fn dequeue() -> Job fallible(JobError) {
        self.__guard() or raise;
        let mut tries = 0;
        while tries < 100 {
            let sel = "SELECT id, attempt, max_attempts, kind, payload FROM "
                + self.table + " WHERE state = 'ready' ORDER BY id LIMIT 1";
            let row = self.db.query_one(sel) or self.__db_row_or_empty(err);
            let j = __parse_job_row(row.data);
            let upd = "UPDATE " + self.table
                + " SET state = 'in_flight', claimed_at = strftime('%s','now')"
                + " WHERE id = " + to_string(j.id) + " AND state = 'ready'";
            let r = self.db.exec(upd) or self.__db_exec(err);
            if r.rows_affected > 0 {
                return j;
            }
            // Lost the claim race; rescan.
            tries = tries + 1;
        }
        fail JobError {
            kind:   "db",
            detail: "dequeue: lost 100 consecutive claim races on " + self.table,
        };
    }

    // ack — mark a claimed row done. Only an 'in_flight' row can
    // be acked; anything else fails kind="not_found".
    fn ack(job_id: Int) -> () fallible(JobError) {
        self.__guard() or raise;
        let upd = "UPDATE " + self.table + " SET state = 'done'"
            + " WHERE id = " + to_string(job_id) + " AND state = 'in_flight'";
        let r = self.db.exec(upd) or self.__db_exec(err);
        if r.rows_affected <= 0 {
            fail JobError {
                kind:   "not_found",
                detail: "ack: no in_flight row with id " + to_string(job_id),
            };
        }
    }

    // fail — record a failed invocation; retry vs dead-letter is
    // the caller's choice (the worker computes
    // `retry = attempt + 1 < max_attempts`).
    //
    //   retry == true:  attempt++, state back to 'ready' so the
    //                   next dequeue picks it up.
    //   retry == false: state → 'failed' (dead-letter). The row
    //                   stays for audit / manual replay.
    //
    // Named `fail` per CONTRACTS.md — the keyword and the member
    // fn coexist (probed at HEAD; FRICTION.log item 13 closed).
    fn fail(job_id: Int, retry: Bool) -> () fallible(JobError) {
        self.__guard() or raise;
        let mut upd = "UPDATE " + self.table + " SET state = 'failed'"
            + " WHERE id = " + to_string(job_id) + " AND state = 'in_flight'";
        if retry {
            upd = "UPDATE " + self.table
                + " SET state = 'ready', attempt = attempt + 1"
                + " WHERE id = " + to_string(job_id) + " AND state = 'in_flight'";
        }
        let r = self.db.exec(upd) or self.__db_exec(err);
        if r.rows_affected <= 0 {
            fail JobError {
                kind:   "not_found",
                detail: "fail: no in_flight row with id " + to_string(job_id),
            };
        }
    }

    // ---- private bridge helpers (see header comment) ----

    fn __guard() -> () fallible(JobError) {
        if self.schema_error != "" {
            fail JobError {
                kind:   "db",
                detail: "schema bringup failed at birth: " + self.schema_error,
            };
        }
    }

    // __schema_err — birth()'s bridge. Lifecycle bodies can't be
    // fallible, so this one keeps the stash shape (first error
    // wins) and returns a sentinel.
    fn __schema_err(e: sqlite::DbError) -> sqlite::ExecResult {
        if self.schema_error == "" {
            self.schema_error = e.kind + ": " + e.detail;
        }
        return sqlite::ExecResult { };
    }

    // ---- DbError→JobError bridges. Fallible or-handlers: their
    //      failure propagates through the calling op's error path
    //      implicitly (hale ≥ 400ac68). One bridge per success
    //      shape; the *_fin variants finalize the statement before
    //      failing so an aborted enqueue can't leak the handle.

    fn __db_int(e: sqlite::DbError) -> Int fallible(JobError) {
        fail JobError { kind: "db", detail: e.kind + ": " + e.detail };
    }

    fn __db_unit(e: sqlite::DbError) -> () fallible(JobError) {
        fail JobError { kind: "db", detail: e.kind + ": " + e.detail };
    }

    fn __db_unit_fin(e: sqlite::DbError, stmt: Int) -> () fallible(JobError) {
        self.db.finalize(stmt) or discard;
        fail JobError { kind: "db", detail: e.kind + ": " + e.detail };
    }

    // step-on-INSERT bridge: SQLITE_DONE ("no_row") is success.
    fn __db_step_fin(e: sqlite::DbError, stmt: Int) -> sqlite::Row fallible(JobError) {
        if e.kind != "no_row" {
            self.db.finalize(stmt) or discard;
            fail JobError { kind: "db", detail: e.kind + ": " + e.detail };
        }
        return sqlite::Row { };
    }

    fn __db_exec(e: sqlite::DbError) -> sqlite::ExecResult fallible(JobError) {
        fail JobError { kind: "db", detail: e.kind + ": " + e.detail };
    }

    fn __db_row(e: sqlite::DbError) -> sqlite::Row fallible(JobError) {
        fail JobError { kind: "db", detail: e.kind + ": " + e.detail };
    }

    // dequeue's SELECT bridge: zero ready rows is the contract's
    // kind="empty", anything else is kind="db".
    fn __db_row_or_empty(e: sqlite::DbError) -> sqlite::Row fallible(JobError) {
        if e.kind == "no_row" {
            fail JobError {
                kind:   "empty",
                detail: "no ready jobs in " + self.table,
            };
        }
        fail JobError { kind: "db", detail: e.kind + ": " + e.detail };
    }
}

// __parse_job_row — parse dequeue's SELECT row
// (id \t attempt \t max_attempts \t kind \t payload) into a Job.
// payload is the row REMAINDER after the fourth tab, so embedded
// tabs in the payload survive (newlines don't — see types.hl).
fn __parse_job_row(data: String) -> Job {
    let total = len(data);
    let t1 = std::str::index_of(data, "\t");
    if t1 < 0 { return Job { }; }
    let id = std::str::parse_int(data[0..t1]) or 0;

    let rest1 = data[(t1 + 1)..total];
    let t2 = std::str::index_of(rest1, "\t");
    if t2 < 0 { return Job { id: id }; }
    let attempt = std::str::parse_int(rest1[0..t2]) or 0;

    let rest2 = rest1[(t2 + 1)..len(rest1)];
    let t3 = std::str::index_of(rest2, "\t");
    if t3 < 0 { return Job { id: id, attempt: attempt }; }
    let max_attempts = std::str::parse_int(rest2[0..t3]) or 3;

    let rest3 = rest2[(t3 + 1)..len(rest2)];
    let t4 = std::str::index_of(rest3, "\t");
    if t4 < 0 {
        return Job { id: id, attempt: attempt, max_attempts: max_attempts,
                     kind: rest3 };
    }
    let kind = rest3[0..t4];
    let payload = rest3[(t4 + 1)..len(rest3)];
    return Job {
        id:           id,
        kind:         kind,
        payload:      payload,
        attempt:      attempt,
        max_attempts: max_attempts,
    };
}
