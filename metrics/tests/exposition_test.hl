// exposition_test — Registry + counter/gauge/histogram mutation,
// then render() and assert the exact Prometheus exposition lines.
//
// The histogram assertions are deliberately exact on cumulative
// bucket counts: observations land in specific buckets (including
// both v == bound boundary cases and a +Inf-only value), guarding
// the 2026-07-04 bounded[T; N] histogram-storage migration.

import ".." as metrics;
import "../../math/matrix" as mat;

fn assert_has(body: String, needle: String, msg: String) {
    std::test::assert(std::str::index_of(body, needle) >= 0, msg);
}

fn drive(reg: metrics::Registry) {
    // ----- counter -----
    let lbl_get = metrics::labels_one("method", "GET");
    let c = metrics::counter(reg, "http_requests_total", lbl_get);
    c.inc();
    c.inc();
    c.add(3.0);          // 5

    // Idempotent re-registration: same (name, labels) returns a
    // handle on the SAME series without resetting it.
    let lbl_get2 = metrics::labels_one("method", "GET");
    let c2 = metrics::counter(reg, "http_requests_total", lbl_get2);
    c2.inc();            // 6 total on the shared series

    // Same name, different labels — a separate series.
    let lbl_post = metrics::labels_one("method", "POST");
    let cpost = metrics::counter(reg, "http_requests_total", lbl_post);
    cpost.inc();         // 1

    // ----- gauge -----
    let lbl_none = metrics::labels_empty();
    let g = metrics::gauge(reg, "queue_depth", lbl_none);
    g.set(7.0);
    g.inc();
    g.inc();
    g.dec();             // 8

    // ----- histogram -----
    // Bounds [1, 5]; the +Inf bucket is implicit.
    let buckets = mat::from_rows(1, 2, "1.0, 5.0");
    let lbl_hist = metrics::labels_one("path", "/x");
    let h = metrics::histogram(reg, "req_seconds", buckets, lbl_hist);
    h.observe(0.5);      // le="1"
    h.observe(1.0);      // boundary: v <= bound lands in le="1"
    h.observe(2.0);      // le="5"
    h.observe(5.0);      // boundary: le="5"
    h.observe(9.5);      // +Inf only
    // cumulative: le="1" -> 2, le="5" -> 4, +Inf -> 5
    // sum = 0.5+1+2+5+9.5 = 18, count = 5

    let body = reg.render();

    // ----- counter lines -----
    assert_has(body, "# TYPE t_http_requests_total counter\n",
        "counter TYPE line");
    assert_has(body, "t_http_requests_total{method=\"GET\"} 6\n",
        "GET series carries both handles' increments");
    assert_has(body, "t_http_requests_total{method=\"POST\"} 1\n",
        "POST series is independent");

    // ----- gauge lines -----
    assert_has(body, "# TYPE t_queue_depth gauge\n", "gauge TYPE line");
    assert_has(body, "t_queue_depth 8\n",
        "gauge set/inc/inc/dec nets to 8, no braces without labels");

    // ----- histogram lines (exact cumulative counts) -----
    assert_has(body, "# TYPE t_req_seconds histogram\n",
        "histogram TYPE line");
    assert_has(body, "t_req_seconds_bucket{path=\"/x\",le=\"1\"} 2\n",
        "le=1 bucket holds 0.5 and the 1.0 boundary observation");
    assert_has(body, "t_req_seconds_bucket{path=\"/x\",le=\"5\"} 4\n",
        "le=5 cumulative count includes le=1's observations");
    assert_has(body, "t_req_seconds_bucket{path=\"/x\",le=\"+Inf\"} 5\n",
        "+Inf bucket counts every observation");
    assert_has(body, "t_req_seconds_sum{path=\"/x\"} 18\n",
        "histogram _sum");
    assert_has(body, "t_req_seconds_count{path=\"/x\"} 5\n",
        "histogram _count");
}

fn main() {
    // Two-step construction per the CONTRACTS.md shape: the
    // @form(...) substrate slots are default-less and passed in.
    let store = metrics::MetricMap { };
    let hl    = metrics::HistogramList { };
    let reg   = metrics::Registry {
        namespace:  "t",
        store:      store,
        histograms: hl
    };
    drive(reg);
}
