// pond/http/client — keep-alive support for the Client locus.
//
// The free-fn surface (get/post/request) stays one-shot + `Connection: close`
// + read-until-close, unchanged. This file adds the OPT-IN keep-alive path the
// `Client` locus uses when `keep_alive: true`: a framing-aware reader that
// stops at the response boundary (Content-Length OR chunked) so the connection
// can be reused without waiting for the peer to close. Latency: amortizes the
// TCP+TLS handshake across requests to the same host (the dominant cost for a
// request/response hotpath like exchange order entry).
//
// Correctness notes:
//   - A keep-alive response MUST be self-delimiting (Content-Length or
//     Transfer-Encoding: chunked); the reader handles both and falls back to
//     read-to-close (marked non-reusable) only when neither is present.
//   - The __HttpConn wrapper (wire.hl) auto-closes on fn-exit, which is wrong
//     for a pooled fd that must outlive the round-trip — so this path operates
//     on the raw handle (Int + is_tls) and the caller owns the lifecycle.

// --- raw-handle send/recv/close (no auto-close) ---
fn __send_raw(handle: Int, is_tls: Bool, b: Bytes) -> Int {
    if is_tls { return std::io::tls::send_bytes(handle, b); }
    return std::io::tcp::__send_bytes(handle, b);
}
fn __recv_raw(handle: Int, is_tls: Bool, max_bytes: Int) -> Bytes {
    if is_tls { return std::io::tls::recv_bytes(handle, max_bytes); }
    return std::io::tcp::__recv_bytes(handle, max_bytes);
}
fn __close_handle(handle: Int, is_tls: Bool) {
    if handle < 0 { return; }
    if is_tls { std::io::tls::close(handle); } else { std::io::tcp::__close_fd(handle); }
}

// Connect + set TCP_NODELAY (kill Nagle — up to ~40ms on small writes). Returns
// the handle, or -1 on connect failure (the pooled path retries).
fn __dial_nd(host: String, port: Int, is_tls: Bool) -> Int {
    if is_tls {
        let h = std::io::tls::connect(host, port) or - 1;
        if h < 0 { return -1; }
        std::io::tls::set_nodelay(h, true) or discard;
        return h;
    }
    let fd = std::io::tcp::connect(host, port) or - 1;
    if fd < 0 { return -1; }
    std::io::tcp::set_nodelay(fd, true) or discard;
    return fd;
}

// --- framing helpers ---

// Index of "\r\n\r\n" (header terminator) in a Bytes blob; -1 if absent.
fn __find_hdr_end(raw: Bytes) -> Int {
    let n = len(raw);
    let mut i = 0;
    while i + 3 < n {
        let a = std::bytes::at(raw, i) or - 1;
        if a == 13 {
            let b = std::bytes::at(raw, i + 1) or - 1;
            let c = std::bytes::at(raw, i + 2) or - 1;
            let d = std::bytes::at(raw, i + 3) or - 1;
            if b == 10 && c == 13 && d == 10 { return i; }
        }
        i = i + 1;
    }
    return -1;
}

// Index of the next CRLF at/after `from`, up to `end`; -1 if none.
fn __crlf_at(raw: Bytes, from: Int, end: Int) -> Int {
    let mut i = from;
    while i + 1 < end {
        let a = std::bytes::at(raw, i) or - 1;
        let b = std::bytes::at(raw, i + 1) or - 1;
        if a == 13 && b == 10 { return i; }
        i = i + 1;
    }
    return -1;
}

// Parse a hex chunk-size from [lo, hi), stopping at ';' (chunk-ext) or space.
// -1 if no hex digits.
fn __hex_size(raw: Bytes, lo: Int, hi: Int) -> Int {
    let mut v = 0;
    let mut i = lo;
    let mut any = false;
    while i < hi {
        let ch = std::bytes::at(raw, i) or - 1;
        if ch == 59 || ch == 32 { break; } // ';' or ' '
        let mut dgt = -1;
        if ch >= 48 && ch <= 57 { dgt = ch - 48; } // 0-9
        else if ch >= 97 && ch <= 102 { dgt = ch - 87; } // a-f
        else if ch >= 65 && ch <= 70 { dgt = ch - 55; } // A-F
        if dgt < 0 { break; }
        v = v * 16 + dgt;
        any = true;
        i = i + 1;
    }
    if !any { return -1; }
    return v;
}

type __ChunkScan { body: Bytes; complete: Bool; bad: Bool; }

// Try to de-chunk [start, end). complete=true once the 0-size terminator chunk
// AND its trailer section (optional trailer headers + final CRLF) are seen;
// bad=true means the framing is malformed (not "need more wire bytes") —
// callers must error, never return partial data.
fn __scan_chunks(raw: Bytes, start: Int, end: Int) -> __ChunkScan {
    let out = std::bytes::BytesBuilder { initial_cap: 4096 };
    let mut pos = start;
    while pos < end {
        let nl = __crlf_at(raw, pos, end);
        if nl < 0 { return __ChunkScan { body: b"", complete: false, bad: false }; } // size line incomplete
        let size = __hex_size(raw, pos, nl);
        if size < 0 { return __ChunkScan { body: b"", complete: false, bad: true }; }
        if size == 0 {
            // Terminator chunk: skip trailer headers (ignored), then the
            // blank line that ends the message.
            let mut tpos = nl + 2;
            while tpos < end {
                let tnl = __crlf_at(raw, tpos, end);
                if tnl < 0 { return __ChunkScan { body: b"", complete: false, bad: false }; }
                if tnl == tpos { return __ChunkScan { body: out.snapshot(), complete: true, bad: false }; }
                tpos = tnl + 2;
            }
            return __ChunkScan { body: b"", complete: false, bad: false };
        }
        let data_start = nl + 2;
        let data_end = data_start + size;
        if data_end + 2 > end { return __ChunkScan { body: b"", complete: false, bad: false }; } // data incomplete
        let ca = std::bytes::at(raw, data_end) or - 1;
        let cb = std::bytes::at(raw, data_end + 1) or - 1;
        if ca != 13 || cb != 10 { return __ChunkScan { body: b"", complete: false, bad: true }; }
        out.append(std::bytes::slice(raw, data_start, data_end));
        pos = data_end + 2; // skip trailing CRLF
    }
    return __ChunkScan { body: b"", complete: false, bad: false };
}

type __FramedRead { bytes: Bytes; framed: Bool; }

// Read exactly ONE response off a keep-alive connection, framed by
// Content-Length or chunked. framed=true ⇒ stopped cleanly at the boundary
// (connection reusable); framed=false ⇒ EOF/close or unframable.
fn __recv_framed(handle: Int, is_tls: Bool, max_body: Int) -> __FramedRead {
    let chunk = 8192;
    let buf = std::bytes::BytesBuilder { initial_cap: 4096 };
    let mut total = 0;
    let mut full = b"";
    let mut hdr_end = -1;

    // 1) accumulate until the header terminator.
    while total < max_body {
        let take = if (max_body - total) < chunk { max_body - total } else { chunk };
        let piece = __recv_raw(handle, is_tls, take);
        let n = len(piece);
        if n <= 0 { return __FramedRead { bytes: buf.snapshot(), framed: false }; }
        buf.append(piece);
        total = total + n;
        full = buf.snapshot();
        hdr_end = __find_hdr_end(full);
        if hdr_end >= 0 { break; }
    }
    if hdr_end < 0 { return __FramedRead { bytes: full, framed: false }; }

    let headers_str = std::str::from_bytes(std::bytes::slice(full, 0, hdr_end));
    let body_start = hdr_end + 4;

    // 2a) chunked.
    let te = std::str::lower(__find_header(headers_str, "transfer-encoding"));
    if std::str::index_of(te, "chunked") >= 0 {
        while total < max_body {
            let sc = __scan_chunks(full, body_start, total);
            // Raw bytes go back whole — __parse_response de-chunks.
            // framed=true ⇒ terminator + trailers seen.
            if sc.complete {
                return __FramedRead { bytes: full, framed: true };
            }
            if sc.bad {
                return __FramedRead { bytes: full, framed: false };
            }
            let take = if (max_body - total) < chunk { max_body - total } else { chunk };
            let piece = __recv_raw(handle, is_tls, take);
            let n = len(piece);
            if n <= 0 { return __FramedRead { bytes: full, framed: false }; }
            buf.append(piece);
            total = total + n;
            full = buf.snapshot();
        }
        return __FramedRead { bytes: full, framed: false };
    }

    // 2b) Content-Length.
    let cl = __find_header(headers_str, "content-length");
    if len(cl) > 0 {
        let clen = std::str::parse_int(cl) or 0;
        let need = body_start + clen;
        while total < need && total < max_body {
            let want = need - total;
            let take = if want < chunk { want } else { chunk };
            let piece = __recv_raw(handle, is_tls, take);
            let n = len(piece);
            if n <= 0 { return __FramedRead { bytes: buf.snapshot(), framed: false }; }
            buf.append(piece);
            total = total + n;
        }
        full = buf.snapshot();
        let end = if need < total { need } else { total };
        return __FramedRead { bytes: std::bytes::slice(full, 0, end), framed: total >= need };
    }

    // 2c) neither — can't frame under keep-alive; read to close, not reusable.
    while total < max_body {
        let take = if (max_body - total) < chunk { max_body - total } else { chunk };
        let piece = __recv_raw(handle, is_tls, take);
        let n = len(piece);
        if n <= 0 { break; }
        buf.append(piece);
        total = total + n;
    }
    return __FramedRead { bytes: buf.snapshot(), framed: false };
}

type __ExchangeResult { resp: Response; ok: Bool; reusable: Bool; }

// One keep-alive round-trip on a raw handle (no auto-close). Returns the parsed
// response + whether the handle is reusable (cleanly framed AND the peer didn't
// say `Connection: close`).
fn __exchange_on_handle(handle: Int, is_tls: Bool, req: Request, ua: String, max_body: Int) -> __ExchangeResult {
    let header_block = __build_request_headers(req, ua, true); // keep-alive
    let sent = __send_raw(handle, is_tls, std::bytes::from_string(header_block));
    if sent < 0 { return __ExchangeResult { resp: __empty_response(), ok: false, reusable: false }; }
    if len(req.body) > 0 {
        let bs = __send_raw(handle, is_tls, req.body);
        if bs < 0 { return __ExchangeResult { resp: __empty_response(), ok: false, reusable: false }; }
    }
    let fr = __recv_framed(handle, is_tls, max_body);
    let resp = __parse_response(fr.bytes);
    if resp.status <= 0 { return __ExchangeResult { resp: resp, ok: false, reusable: false }; }
    let conn = std::str::lower(__find_header(resp.headers, "connection"));
    let reusable = fr.framed && conn != "close";
    return __ExchangeResult { resp: resp, ok: true, reusable: reusable };
}
