// pond/http/client/tests — wire format: request-header building and
// response parsing over hand-written HTTP/1.1 byte strings. Pure
// codec logic only; nothing here touches a socket.

import ".." as http;

// contains — index_of >= 0 wrapper for readable asserts.
fn contains(haystack: String, needle: String) -> Bool {
    return std::str::index_of(haystack, needle) >= 0;
}

fn main() {
    // ---- request building ------------------------------------

    let req = http::Request {
        method:  "GET",
        url:     http::Url { scheme: "http", host: "example.com", port: 8080, path: "/things?a=1" },
        headers: "X-Token: abc",
        body:    b""
    };
    let hdrs = http::__build_request_headers(req, "pond-test/1.0", false);

    std::test::assert_eq_int(std::str::index_of(hdrs, "GET /things?a=1 HTTP/1.1\r\n"), 0,
        "request line first, method + path + version");
    std::test::assert(contains(hdrs, "Host: example.com:8080\r\n"), "Host header present");
    std::test::assert(contains(hdrs, "User-Agent: pond-test/1.0\r\n"), "User-Agent present");
    std::test::assert(contains(hdrs, "Content-Length: 0\r\n"), "Content-Length 0 for empty body");
    std::test::assert(contains(hdrs, "Connection: close\r\n"), "Connection close when keep_alive=false");
    std::test::assert(contains(hdrs, "X-Token: abc\r\n"), "user header present");
    let hn = len(hdrs);
    std::test::assert_eq_str(hdrs[(hn - 4)..hn], "\r\n\r\n", "header block CRLF-CRLF terminated");

    // POST with body: Content-Length reflects body byte count;
    // keep-alive flag flips the Connection header.
    let preq = http::Request {
        method:  "POST",
        url:     http::Url { scheme: "http", host: "example.com", port: 80, path: "/submit" },
        headers: "",
        body:    std::bytes::from_string("hi")
    };
    let phdrs = http::__build_request_headers(preq, "pond-test/1.0", true);
    std::test::assert_eq_int(std::str::index_of(phdrs, "POST /submit HTTP/1.1\r\n"), 0,
        "POST request line");
    std::test::assert(contains(phdrs, "Content-Length: 2\r\n"), "Content-Length 2 for 2-byte body");
    std::test::assert(contains(phdrs, "Connection: keep-alive\r\n"), "Connection keep-alive when keep_alive=true");
    std::test::assert(!contains(phdrs, "Connection: close"), "no Connection close in keep-alive mode");

    // ---- response parsing ------------------------------------

    let raw = std::bytes::from_string(
        "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello");
    let resp = http::__parse_response(raw);
    std::test::assert_eq_int(resp.status, 200, "status 200 extracted");
    std::test::assert_eq_int(len(resp.body), 5, "body length after header split");
    std::test::assert_eq_str(std::str::from_bytes(resp.body), "hello", "body content after split");

    // Header lookup on the parsed block — exact, case-insensitive,
    // and absent cases.
    std::test::assert_eq_str(http::__find_header(resp.headers, "Content-Type"),
        "text/plain", "header lookup exact case");
    std::test::assert_eq_str(http::__find_header(resp.headers, "content-LENGTH"),
        "5", "header lookup case-insensitive");
    std::test::assert_eq_str(http::__find_header(resp.headers, "X-Nope"),
        "", "absent header is empty string");

    // Empty body + non-200 status.
    let raw404 = std::bytes::from_string("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n");
    let r404 = http::__parse_response(raw404);
    std::test::assert_eq_int(r404.status, 404, "status 404 extracted");
    std::test::assert_eq_int(len(r404.body), 0, "empty body");

    // Malformed blob -> sentinel status 0.
    let bad = http::__parse_response(std::bytes::from_string("garbage with no crlf"));
    std::test::assert_eq_int(bad.status, 0, "unparseable response yields status 0");

    // ---- chunked transfer decoding ---------------------------

    // Transfer-Encoding: chunked, no Content-Length: the body is
    // de-chunked (hex-size framing, chunk extension, and trailer
    // header all stripped) — the FRICTION-log raw-framing bug.
    let chunked_raw = std::bytes::from_string(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
        + "6\r\nhello,\r\n1;ext=x\r\n \r\n5\r\nworld\r\n0\r\nX-Trailer: ignored\r\n\r\n");
    let rc = http::__parse_response(chunked_raw);
    std::test::assert_eq_int(rc.status, 200, "chunked: status extracted");
    std::test::assert_eq_str(std::str::from_bytes(rc.body), "hello, world",
        "chunked: body de-chunked across chunks + ext + trailer");

    // Truncated chunked stream (no terminator) -> status 0, never
    // partial data.
    let trunc = std::bytes::from_string(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nhello,\r\n");
    std::test::assert_eq_int(http::__parse_response(trunc).status, 0,
        "chunked: truncated stream yields status 0");

    // Malformed chunk-size line -> status 0.
    let malformed = std::bytes::from_string(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\nbogus\r\n0\r\n\r\n");
    std::test::assert_eq_int(http::__parse_response(malformed).status, 0,
        "chunked: malformed size line yields status 0");

    // ---- status-line parsing ---------------------------------

    std::test::assert_eq_int(http::__parse_status("HTTP/1.1 503 Service Unavailable"), 503,
        "status line with phrase");
    std::test::assert_eq_int(http::__parse_status("HTTP/1.1 204"), 204,
        "status line without phrase");
    std::test::assert_eq_int(http::__parse_status("junk"), -1,
        "malformed status line yields -1");
}
