// forward_test — tiny 2-2-1 model: layer metadata windows, forward
// pass produces finite right-shaped output, load_weights/load_biases
// dims, exact forward on a hand-loaded linear model (via apply_delta),
// and the fallible surface (empty model / shape mismatch).
//
// The upstream heap-corruption bug that once required all Matrix /
// Model creation to stay in the fn main() frame is fixed
// (FRICTION.log § pond/ml/neural, closed 2026-08-11); this file is
// laid out for readability, not to dodge it.

import "../../../math/matrix" as mat;
import ".." as nn;

fn near_eq(actual: Float, expected: Float, msg: String) {
    let mut diff = actual - expected;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    std::test::assert(diff < 0.000001, msg);
}

fn assert_finite(v: Float, msg: String) {
    std::test::assert(!std::math::is_nan(v), msg);
    std::test::assert(v > -1000000.0, msg);
    std::test::assert(v < 1000000.0, msg);
}

fn main() {
    // ---- build a 2-2-1 sigmoid MLP with a fixed seed ----
    let model = nn::Model { name: "t", rng_state: 42 };
    model.add_dense(2, 2, "sigmoid");
    model.add_dense(2, 1, "sigmoid");

    std::test::assert_eq_int(model.layer_count, 2, "layer_count");
    std::test::assert_eq_str(model.meta_csv, "2,2,sigmoid;2,1,sigmoid", "meta_csv");
    // params: layer0 = 2*2 W + 2 b = 6; layer1 = 2*1 W + 1 b = 3.
    std::test::assert_eq_int(model.params_len, 9, "params_len = 6 + 3");

    // Layer metadata windows.
    let l0 = model.layer_at(0);
    std::test::assert_eq_int(l0.input_dim, 2, "l0 input_dim");
    std::test::assert_eq_int(l0.output_dim, 2, "l0 output_dim");
    std::test::assert_eq_str(l0.activation, "sigmoid", "l0 activation");
    std::test::assert_eq_int(l0.weights_offset, 0, "l0 weights_offset");
    std::test::assert_eq_int(l0.weights_count, 4, "l0 weights_count");
    std::test::assert_eq_int(l0.biases_offset, 4, "l0 biases_offset");
    std::test::assert_eq_int(l0.biases_count, 2, "l0 biases_count");
    let l1 = model.layer_at(1);
    std::test::assert_eq_int(l1.weights_offset, 6, "l1 weights_offset");
    std::test::assert_eq_int(l1.biases_offset, 8, "l1 biases_offset");
    std::test::assert_eq_int(l1.biases_count, 1, "l1 biases_count");
    // Out-of-range layer_at returns default Layer.
    let lx = model.layer_at(5);
    std::test::assert_eq_int(lx.input_dim, 0, "layer_at OOB returns default");

    // load_weights / load_biases rebuild right-shaped Matrices.
    let w0 = nn::load_weights(model, l0);
    std::test::assert_eq_int(w0.rows, 2, "load_weights rows = output_dim");
    std::test::assert_eq_int(w0.cols, 2, "load_weights cols = input_dim");
    let b0 = nn::load_biases(model, l0);
    std::test::assert_eq_int(b0.rows, 2, "load_biases rows = output_dim");
    std::test::assert_eq_int(b0.cols, 1, "load_biases cols = 1");
    // Xavier init: weights finite; biases start at exactly 0.0.
    assert_finite(w0.get(0) or 0.0, "w0[0] finite");
    assert_finite(w0.get(3) or 0.0, "w0[3] finite");
    near_eq(b0.get(0) or -999.0, 0.0, "biases init to 0.0");
    near_eq(b0.get(1) or -999.0, 0.0, "biases init to 0.0 (second)");

    // ---- forward: right dims, finite, sigmoid range (0, 1) ----
    let x = mat::from_rows(2, 1, "1.0, 0.0");
    let out = nn::forward(model, x) or mat::error_matrix();
    std::test::assert(!mat::is_error(out), "forward succeeds on matching input");
    std::test::assert_eq_int(out.rows, 1, "forward output rows = last output_dim");
    std::test::assert_eq_int(out.cols, 1, "forward output cols = 1");
    let p = out.get(0) or -999.0;
    assert_finite(p, "forward output finite");
    std::test::assert(p > 0.0, "sigmoid output > 0");
    std::test::assert(p < 1.0, "sigmoid output < 1");

    // Same seed + same input is deterministic: rebuild and compare.
    let model_b = nn::Model { name: "t2", rng_state: 42 };
    model_b.add_dense(2, 2, "sigmoid");
    model_b.add_dense(2, 1, "sigmoid");
    let out_b = nn::forward(model_b, x) or mat::error_matrix();
    near_eq(out_b.get(0) or -999.0, p, "same seed reproduces forward output");

    // ---- exact forward on a hand-loaded linear model ----
    // apply_delta decodes "meta\n<tab-separated params>\n".
    // 2 -> 1 linear layer, W = [0.5, -0.25], b = [0.1]:
    //   f([2, 4]) = 0.5*2 - 0.25*4 + 0.1 = 0.1
    let lin = nn::Model { name: "lin" };
    let snap = std::bytes::from_string("2,1,linear\n0.5\t-0.25\t0.1\n");
    lin.apply_delta(snap) or discard;
    std::test::assert_eq_int(lin.layer_count, 1, "apply_delta layer_count");
    std::test::assert_eq_int(lin.params_len, 3, "apply_delta params_len");
    let xin = mat::from_rows(2, 1, "2.0, 4.0");
    let lout = nn::forward(lin, xin) or mat::error_matrix();
    std::test::assert(!mat::is_error(lout), "linear forward succeeds");
    near_eq(lout.get(0) or -999.0, 0.1, "exact linear forward value");

    // ---- snapshot round-trip: copy predicts identically ----
    let copy = nn::Model { name: "copy" };
    copy.apply_delta(model.snapshot_bytes()) or discard;
    let out_c = nn::forward(copy, x) or mat::error_matrix();
    near_eq(out_c.get(0) or -999.0, p, "snapshot round-trip preserves forward output");

    // ---- fallible surface ----
    let empty = nn::Model { name: "empty" };
    let e_out = nn::forward(empty, x) or mat::error_matrix();
    std::test::assert(mat::is_error(e_out), "forward on empty model fails (empty_model)");

    let x3 = mat::from_rows(3, 1, "1.0, 2.0, 3.0");
    let m_out = nn::forward(model, x3) or mat::error_matrix();
    std::test::assert(mat::is_error(m_out), "forward rejects wrong input dim (shape_mismatch)");
}
