// remove_test — Store.remove / remove_at semantics: first-match
// removal, order preservation of remaining rows (ids, metadata AND
// the flat float rows stay in lockstep), first/middle/last removal,
// not_found error kind.

import ".." as emb;
import "../../../math/matrix" as mat;

// Records the EmbError kind seen by an `or handler(err)` disposition.
locus ErrProbe {
    params { kind: String = ""; }
    fn set_kind(k: String) {
        self.kind = k;
    }
}

fn remove_err(p: ErrProbe, e: emb::EmbError) {
    p.set_kind(e.kind);
}

fn near_eq(actual: Float, expected: Float, msg: String) {
    let mut diff = actual - expected;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    std::test::assert(diff < 0.000001, msg);
}

// First newline-separated row of csv.
fn first_line(csv: String) -> String {
    let nl = std::str::index_of(csv, "\n");
    if nl < 0 {
        return csv;
    }
    return std::str::substring(csv, 0, nl);
}

fn main() {
    // Four distinct 2-dim rows. Axis-aligned queries make each row
    // individually addressable by a top-1 search.
    let v1 = mat::from_rows(1, 2, "1.0, 0.0");
    let v2 = mat::from_rows(1, 2, "0.0, 1.0");
    let v3 = mat::from_rows(1, 2, "-1.0, 0.0");
    let v4 = mat::from_rows(1, 2, "0.0, -1.0");
    let q_e = mat::from_rows(1, 2, "1.0, 0.0"); // east  -> one
    let q_n = mat::from_rows(1, 2, "0.0, 1.0"); // north -> two
    let q_w = mat::from_rows(1, 2, "-1.0, 0.0"); // west  -> three
    let q_s = mat::from_rows(1, 2, "0.0, -1.0"); // south -> four

    let store = emb::Store { dim: 2 };
    store.add("one", v1, "east") or discard;
    store.add("two", v2, "north") or discard;
    store.add("three", v3, "west") or discard;
    store.add("four", v4, "south") or discard;
    std::test::assert_eq_int(store.count(), 4, "count before removals");

    // Remove a middle row.
    store.remove("two") or discard;
    std::test::assert_eq_int(store.count(), 3, "count after remove(two)");

    // "two"'s exact-direction query no longer finds a positive match:
    // best remaining cosine against north is 0 (east/west) or -1 (south).
    let after = store.search(q_n, 1) or emb::Rows { csv: "" };
    let top = first_line(after.csv);
    std::test::assert(std::str::index_of(top, "two") < 0, "removed id absent from results");

    // Remaining rows kept their id/meta/vector lockstep: each axis
    // query still resolves to its own row with cosine 1.0.
    let r1 = store.search(q_e, 1) or emb::Rows { csv: "" };
    std::test::assert_eq_str(first_line(r1.csv), "one\t1\teast", "row one intact after shift");
    let r3 = store.search(q_w, 1) or emb::Rows { csv: "" };
    std::test::assert_eq_str(first_line(r3.csv), "three\t1\twest", "row three shifted intact");
    let r4 = store.search(q_s, 1) or emb::Rows { csv: "" };
    std::test::assert_eq_str(first_line(r4.csv), "four\t1\tsouth", "row four shifted intact");

    // not_found error kind via or-handler.
    let p = ErrProbe { };
    store.remove("nope") or remove_err(p, err);
    std::test::assert_eq_str(p.kind, "not_found", "remove of unknown id fails not_found");
    std::test::assert_eq_int(store.count(), 3, "failed remove leaves count unchanged");

    // Remove first and last remaining rows; the survivor still works.
    store.remove("one") or discard;
    store.remove("four") or discard;
    std::test::assert_eq_int(store.count(), 1, "count after removing first+last");
    let last = store.search(q_w, 1) or emb::Rows { csv: "" };
    std::test::assert_eq_str(first_line(last.csv), "three\t1\twest", "sole survivor searchable");

    // Drain to empty; empty-store search yields empty csv.
    store.remove("three") or discard;
    std::test::assert_eq_int(store.count(), 0, "store drained to empty");
    let none = store.search(q_e, 1) or emb::Rows { csv: "sentinel" };
    std::test::assert_eq_str(none.csv, "", "drained store yields empty csv");

    // Duplicate ids: remove takes the FIRST match only.
    let dup_v1 = mat::from_rows(1, 2, "1.0, 0.0");
    let dup_v2 = mat::from_rows(1, 2, "0.6, 0.8");
    store.add("dup", dup_v1, "first") or discard;
    store.add("dup", dup_v2, "second") or discard;
    std::test::assert_eq_int(store.count(), 2, "two dup rows added");
    store.remove("dup") or discard;
    std::test::assert_eq_int(store.count(), 1, "first-match removal removes one row");
    let dq = mat::from_rows(1, 2, "0.6, 0.8");
    let dr = store.search(dq, 1) or emb::Rows { csv: "" };
    std::test::assert_eq_str(first_line(dr.csv), "dup\t1\tsecond", "second dup row survives");
}
