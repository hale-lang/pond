// helpers_test — pure free fns: magnitude, cosine_from_parts,
// csv_field_count, embedding_from_matrix / to_matrix round-trip,
// format_hit_row, argmax_skipping_nan.

import ".." as emb;
import "../../../math/matrix" as mat;

fn near_eq(actual: Float, expected: Float, msg: String) {
    let mut diff = actual - expected;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    std::test::assert(diff < 0.000001, msg);
}

fn main() {
    // magnitude: 3-4-5 triangle.
    let v34 = mat::from_rows(1, 2, "3.0, 4.0");
    near_eq(emb::vector_magnitude_from_matrix(v34), 5.0, "magnitude of [3,4] is 5");

    // unit vector.
    let unit = mat::from_rows(1, 3, "0.0, 1.0, 0.0");
    near_eq(emb::vector_magnitude_from_matrix(unit), 1.0, "magnitude of unit vector");

    // zero vector -> 0.0 (documented; avoids NaN).
    let zero = mat::from_rows(1, 3, "0.0, 0.0, 0.0");
    near_eq(emb::vector_magnitude_from_matrix(zero), 0.0, "magnitude of zero vector is 0");

    // cosine_from_parts: dot=6, |a|=2, |b|=3 -> 1.0 (parallel).
    near_eq(emb::cosine_from_parts(6.0, 2.0, 3.0), 1.0, "cosine parallel = 1");
    // anti-parallel.
    near_eq(emb::cosine_from_parts(-6.0, 2.0, 3.0), -1.0, "cosine anti-parallel = -1");
    // orthogonal.
    near_eq(emb::cosine_from_parts(0.0, 2.0, 3.0), 0.0, "cosine orthogonal = 0");
    // partial: dot=1, mags 1 and 2 -> 0.5.
    near_eq(emb::cosine_from_parts(1.0, 1.0, 2.0), 0.5, "cosine 0.5");
    // zero magnitude on either side -> 0.0 (documented guard).
    near_eq(emb::cosine_from_parts(5.0, 0.0, 3.0), 0.0, "zero mag_a guard");
    near_eq(emb::cosine_from_parts(5.0, 2.0, 0.0), 0.0, "zero mag_b guard");

    // csv_field_count.
    std::test::assert_eq_int(emb::csv_field_count(""), 0, "empty csv = 0 fields");
    std::test::assert_eq_int(emb::csv_field_count("1.0"), 1, "one field");
    std::test::assert_eq_int(emb::csv_field_count("1.0,2.0,3.0"), 3, "three fields");

    // embedding_from_matrix -> to_matrix round-trip.
    let v = mat::from_rows(1, 3, "1.5, -2.0, 0.25");
    let e = emb::embedding_from_matrix("id7", v, "meta7");
    std::test::assert_eq_str(e.id, "id7", "embedding id preserved");
    std::test::assert_eq_str(e.metadata, "meta7", "embedding metadata preserved");
    std::test::assert_eq_str(e.vector_csv, "1.5,-2,0.25", "vector serialized as csv");
    let back = emb::to_matrix(e);
    std::test::assert_eq_int(back.rows, 1, "round-trip rows");
    std::test::assert_eq_int(back.cols, 3, "round-trip cols");
    near_eq(back.get(0) or -999.0, 1.5, "round-trip [0]");
    near_eq(back.get(1) or -999.0, -2.0, "round-trip [1]");
    near_eq(back.get(2) or -999.0, 0.25, "round-trip [2]");

    // Empty embedding -> 1x0 matrix.
    let e0 = emb::Embedding { id: "x", vector_csv: "", metadata: "" };
    let m0 = emb::to_matrix(e0);
    std::test::assert_eq_int(m0.len(), 0, "empty csv gives empty matrix");

    // format_hit_row: id\tscore\tmetadata.
    std::test::assert_eq_str(emb::format_hit_row("a", 1.0, "m"), "a\t1\tm", "hit row format");

    // argmax_skipping_nan.
    let buf = emb::FloatBuf { };
    std::test::assert_eq_int(emb::argmax_skipping_nan(buf), -1, "argmax of empty buf is -1");
    buf.push(1.0);
    buf.push(5.0);
    buf.push(3.0);
    std::test::assert_eq_int(emb::argmax_skipping_nan(buf), 1, "argmax picks largest");
    buf.set(1, std::math::nan()) or discard;
    std::test::assert_eq_int(emb::argmax_skipping_nan(buf), 2, "argmax skips NaN entries");
    buf.set(0, std::math::nan()) or discard;
    buf.set(2, std::math::nan()) or discard;
    std::test::assert_eq_int(emb::argmax_skipping_nan(buf), -1, "all-NaN buf yields -1");

    // Negative-only values still produce a valid argmax (best < 0).
    let neg = emb::FloatBuf { };
    neg.push(-3.0);
    neg.push(-1.0);
    neg.push(-2.0);
    std::test::assert_eq_int(emb::argmax_skipping_nan(neg), 1, "argmax over all-negative values");
}
