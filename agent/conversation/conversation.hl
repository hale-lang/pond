// pond/agent/conversation — Conversation locus.
//
// A state-bearing service locus that holds chat history for one
// session. The bus topic `ConversationUpdated` fires on every
// successful append so downstream consumers (LLM clients,
// transcript loggers, UI mirrors) can react incrementally
// without polling.
//
// Pattern 3 in the six-pattern catalog (Service locus, state-
// bearing). No `birth() / run() / dissolve()` — the locus is
// usable immediately after construction; state mutation happens
// through the `append` surface; nothing needs teardown at scope
// exit.
//
// **Cross-process state-mirroring is out of scope for v1.**
// Earlier drafts shipped a `version()` / `snapshot_bytes()` /
// `apply_delta()` surface on this locus so a remote mirror could
// resync via snapshots + deltas (the "Memory Owner Architecture"
// shape). That design is on hold — the substrate work it needs
// (durable version chain, gap-detect, resync protocol) wasn't
// load-bearing for v1, and the wire-format split between owner-
// local serialization and consumer-friendly framing pulled the
// implementation in two directions. Consumers that need cross-
// process delivery should bind `ConversationUpdated` in `main`'s
// `bindings` block — the bus substrate handles serialization
// without the owner having to choose a snapshot format.

// Bus topic — fires once per successful `append()`; the payload
// is the Message that was just appended (subscribers reconstruct
// post-append history by composing it onto their mirror of the
// prior state). Decl CO-LOCATED with the publisher: `hale check`
// still resolves topics file-locally even though build/run accept
// sibling-file decls since WS3.3 — co-location keeps the
// verification gate green.
//
// **Per-conversation subject derivation gap.** Two distinct
// Conversation instances share a single wire subject in v1 —
// every subscriber sees every conversation's traffic. The
// intended end-state is one hierarchical-topic per conversation
// (`topic SessionA : ConversationUpdated { subject: "session_a"; }`)
// so consumers filter at the bus level. See the FRICTION log.
topic ConversationUpdated { payload: Message; }

locus Conversation {
    params {
        // The system prompt for this conversation. Empty string
        // means "no system prompt" (a Conversation that's just
        // a turn-by-turn history).
        system_prompt: String = "";

        // Cap on the number of messages retained in history.
        // When `append()` would push the count past this cap,
        // the oldest messages are dropped to keep the count at
        // exactly `max_messages`. v1 strategy: simple FIFO
        // eviction. The storage ceiling is the bounded capacity
        // (128); a max_messages above it is clamped by the
        // eviction arithmetic.
        max_messages: Int = 100;

        // -------- Internal state, exposed as params per the
        //          stateful-locus convention --------

        // Retained history, oldest first (2026-07-02 bounded
        // migration — was a tab-separated String + msg_count
        // pair; content may now contain tabs). count() IS the
        // live message count.
        history: bounded[Message; 128];
    }
    bus {
        // Topic-decl form per CONTRACTS.md; the old G1
        // literal-subject workaround (`publish "conv.updated"
        // of type Message;`) is retired as of 2026-06-12.
        // The decl is co-located above: `hale build`/`run`
        // accept a sibling-file decl since WS3.3, but
        // `hale check` still resolves topics file-locally —
        // co-location keeps the verification gate green.
        // Subscribers wire up via
        // `subscribe conv::ConversationUpdated as handler;`.
        publish ConversationUpdated;
    }

    // --------- Public surface (per CONTRACTS.md) ---------

    // append(m) — record a new message at the end of the
    // history, fire the `ConversationUpdated` topic.
    //
    // If the post-append count would exceed `max_messages`, the
    // oldest messages are dropped to bring the count back to
    // `max_messages`. The eviction happens *before* the publish
    // so subscribers observe an already-bounded state.
    fn append(m: Message) {
        // Effective retention cap: max_messages clamped to the
        // bounded storage capacity.
        let mut cap = self.max_messages;
        if cap > 128 {
            cap = 128;
        }
        if cap < 1 {
            cap = 1;
        }
        // Evict from the front BEFORE pushing when at cap —
        // shift-left by k then truncate (set/truncate
        // intrinsics), the bounded drop-front idiom.
        let n = count(self.history);
        if n >= cap {
            let k = n - cap + 1;
            let mut j = 0;
            while j < n - k {
                let mv = at(self.history, j + k)
                or Message { };
                set(self.history, j, mv) or raise;
                j = j + 1;
            }
            truncate(self.history, n - k);
        }
        push(self.history, m) or raise;

        // Fire the topic. Subscribers see the just-appended
        // message; if they're maintaining their own mirror they
        // fold this onto their prior state.
        ConversationUpdated <- m;
    }

    // history_count() / history_at(i) — the retained-history
    // read surface (2026-07-02 — replaces the tab-separated
    // `history()` String). `history_at` returns an empty
    // Message (role == "") past the end, per the pond ""-
    // sentinel convention.
    fn history_count() -> Int {
        return count(self.history);
    }

    fn history_at(i: Int) -> Message {
        return at(self.history, i) or Message { };
    }
}
