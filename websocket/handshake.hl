// pond/websocket — RFC 6455 § 4 handshake
//
// Free fns (pattern 6). The client's `connect()` lifecycle step
// calls these against a freshly-opened TCP / TLS socket; on
// success the socket transitions from HTTP into the framed
// WebSocket protocol surface.
//
// **Key + accept validation (closed 2026-06-12).**
//
// `Sec-WebSocket-Key` is 16 CSPRNG bytes (`std::os::getrandom`)
// base64-encoded per § 4.1; the server replies with
// `Sec-WebSocket-Accept = base64(sha1(key + GUID))`, which the
// client now validates via `compute_accept` (std::crypto::sha1 +
// std::text::base64::encode). The old deterministic-key /
// no-validation shape is retired — see FRICTION.log
// § "stdlib gap: SHA-1 + base64" [CLOSED 2026-06-12].

// HandshakeRequest — the HTTP/1.1 upgrade bytes the client
// sends after a successful TCP / TLS connect.
//
// Mandatory headers per § 4.1:
//   GET <path> HTTP/1.1
//   Host: <host>
//   Upgrade: websocket
//   Connection: Upgrade
//   Sec-WebSocket-Key: <base64 of 16 CSPRNG bytes; caller supplies>
//   Sec-WebSocket-Version: 13
//
// `key` is the base64-encoded 16-byte nonce the caller generated
// (WsClient draws it from `std::os::getrandom(16)` per connect and
// keeps it to validate the server's Sec-WebSocket-Accept).
//
// Optional headers (subprotocol, extensions, custom auth) can be
// appended by the caller via the `extra_headers` param on
// `WsClient`; this builder takes that String verbatim, so the
// caller is responsible for CRLF-terminating each line.
fn build_request(host: String, path: String, key: String, extra_headers: String) -> Bytes {
    let mut s = "GET " + path + " HTTP/1.1\r\n";
    s = s + "Host: " + host + "\r\n";
    s = s + "Upgrade: websocket\r\n";
    s = s + "Connection: Upgrade\r\n";
    s = s + "Sec-WebSocket-Key: " + key + "\r\n";
    s = s + "Sec-WebSocket-Version: 13\r\n";
    if len(extra_headers) > 0 {
        s = s + extra_headers;
        // Caller terminates each line; we only ensure final \r\n.
        if !ends_with_crlf(extra_headers) {
            s = s + "\r\n";
        }
    }
    s = s + "\r\n";
    return std::bytes::from_string(s);
}

// parse_response — read the server's HTTP/1.1 response from `b`.
// Returns the number of bytes consumed up to and including the
// final `\r\n\r\n`; the caller's recv buffer keeps any tail
// (which is the first WebSocket frame).
//
// Validates:
//   - First line starts with "HTTP/1.1 101 " (any reason
//     phrase passes).
//   - `Sec-WebSocket-Accept` matches `expected_accept` (the
//     caller's `compute_accept(key)` — RFC 6455 § 4.1 step 4).
//     Pass `expected_accept = ""` to skip (lower-level callers
//     that don't track the key).
//
// FRICTION: a v2 pass could additionally gate on
//   - Upgrade: websocket (case-insensitive)
//   - Connection: Upgrade
fn parse_response(b: Bytes, expected_accept: String) -> Int fallible(WsError) {
    let total = len(b);
    if total < 12 {
        return 0;     // need at least "HTTP/1.1 NNN" before deciding
    }

    // Find the end-of-headers double-CRLF. If absent we're still
    // accumulating; signal to caller via 0.
    let s = std::str::from_bytes(b);
    let end = std::str::index_of(s, "\r\n\r\n");
    if end < 0 {
        return 0;
    }

    // Validate the status line — first 12 chars must be "HTTP/1.1 101".
    let head = s[0..12];
    if head != "HTTP/1.1 101" {
        fail WsError {
            kind:   "handshake",
            detail: "server did not return 101 Switching Protocols: " + s[0..end],
        };
    }

    // Validate Sec-WebSocket-Accept (RFC 6455 § 4.1: "If the
    // response lacks a Sec-WebSocket-Accept header field or [it]
    // does not equal the expected value, the client MUST fail the
    // WebSocket connection").
    if expected_accept != "" {
        let got = header_value(s, end, "sec-websocket-accept");
        if got == "" {
            fail WsError {
                kind:   "handshake",
                detail: "server response lacks Sec-WebSocket-Accept",
            };
        }
        if got != expected_accept {
            fail WsError {
                kind:   "handshake",
                detail: "Sec-WebSocket-Accept mismatch: " + got,
            };
        }
    }
    return end + 4;     // consume up to and including \r\n\r\n
}

// header_value — find one header's value in the raw header block
// `s[0..head_end]`. Name match is case-insensitive (RFC 7230
// § 3.2); leading LWS in the value is skipped. Returns "" when
// the header is absent (or present with an empty value).
fn header_value(s: String, head_end: Int, name_lc: String) -> String {
    let first_crlf = std::str::index_of(s, "\r\n");
    if first_crlf < 0 {
        return "";
    }
    let mut cursor = first_crlf + 2;
    while cursor < head_end {
        let mut line = "";
        let line_end = std::str::index_of(s[cursor..head_end], "\r\n");
        if line_end < 0 {
            line = s[cursor..head_end];
            cursor = head_end;
        } else {
            line = s[cursor..cursor+line_end];
            cursor = cursor + line_end + 2;
        }
        let colon = std::str::index_of(line, ":");
        if colon >= 1 {
            if std::str::lower(line[0..colon]) == name_lc {
                let line_len = len(line);
                let mut vs = colon + 1;
                while vs < line_len {
                    let ch = line[vs..vs+1];
                    if ch != " " && ch != "\t" {
                        return line[vs..line_len];
                    }
                    vs = vs + 1;
                }
                return "";
            }
        }
    }
    return "";
}

// ends_with_crlf — small helper for the extra-headers stitcher.
fn ends_with_crlf(s: String) -> Bool {
    let n = len(s);
    if n < 2 {
        return false;
    }
    let tail = s[n-2..n];
    return tail == "\r\n";
}

// ===== server-side handshake =====
//
// Mirror of the client side: parse the inbound HTTP/1.1 upgrade
// request, compute Sec-WebSocket-Accept per RFC 6455 § 4.2.2,
// and assemble the 101 Switching Protocols response.
//
// Uses the same std::crypto::sha1 + std::text::base64::encode
// pair the client-side accept validation rides (verified
// 2026-05-28 against compiler tests
// crates/hale-codegen/tests/sha1_base64.rs).
//
// Per RFC 6455 § 4.2.2:
//   Sec-WebSocket-Accept = base64(sha1(client_key + WS_MAGIC_GUID))

// WS_MAGIC_GUID — fixed string defined by RFC 6455 § 1.3.
fn ws_magic_guid() -> String {
    return "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
}

// WsUpgradeRequest — fields extracted from the client's HTTP/1.1
// upgrade request. All strings are zero-default; callers check
// `key != ""` to detect "no key header found, not a real upgrade".
type WsUpgradeRequest {
    path:        String = "/";
    key:         String = "";
    version:     String = "";    // expect "13"
    has_upgrade: Bool   = false; // true if Upgrade: websocket present
}

// parse_request — pull the upgrade-relevant headers out of an
// inbound HTTP/1.1 request blob. Tolerant of header order and
// the LWS / case-insensitivity rules per RFC 7230 (header names
// matched case-insensitively).
//
// Returns a zero-default WsUpgradeRequest on parse error (no
// Sec-WebSocket-Key found) — caller checks `req.key != ""` to
// gate the upgrade response.
fn parse_request(b: Bytes) -> WsUpgradeRequest {
    let s = std::str::from_bytes(b);
    let total = len(s);

    // Find end-of-headers — \r\n\r\n. If absent we treat the
    // whole buffer as still-headers and try anyway; callers
    // should ensure they've read at least one full request.
    let mut head_end = std::str::index_of(s, "\r\n\r\n");
    if head_end < 0 {
        head_end = total;
    }

    let mut out = WsUpgradeRequest {
        path:        "/",
        key:         "",
        version:     "",
        has_upgrade: false,
    };

    // Request line: "GET <path> HTTP/1.1\r\n"
    let first_crlf = std::str::index_of(s, "\r\n");
    if first_crlf > 4 {
        let request_line = s[0..first_crlf];
        // Strip "GET " prefix and " HTTP/x.x" suffix to leave path.
        let after_method = std::str::index_of(request_line, " ");
        if after_method > 0 {
            let rest = request_line[after_method+1..len(request_line)];
            let space2 = std::str::index_of(rest, " ");
            if space2 > 0 {
                out.path = rest[0..space2];
            } else {
                out.path = rest;
            }
        }
    }

    // Walk header lines.
    let mut cursor = first_crlf + 2;
    while cursor < head_end {
        let line_end = std::str::index_of(s[cursor..head_end], "\r\n");
        if line_end < 0 {
            cursor = head_end;
        } else {
            let line = s[cursor..cursor+line_end];
            __apply_header(line, out);
            cursor = cursor + line_end + 2;
        }
    }

    return out;
}

// __apply_header — recognize one header line and update the
// passed-by-locus-ref WsUpgradeRequest. Header name match is
// case-insensitive (per RFC 7230 § 3.2). Skips leading LWS in
// the value.
fn __apply_header(line: String, out: WsUpgradeRequest) {
    let colon = std::str::index_of(line, ":");
    if colon < 1 {
        return;
    }
    let name_lc = std::str::lower(line[0..colon]);
    let line_len = len(line);
    let mut vs = colon + 1;
    while vs < line_len {
        let ch = line[vs..vs+1];
        if ch != " " && ch != "\t" {
            __set_header_field(name_lc, line[vs..line_len], out);
            return;
        }
        vs = vs + 1;
    }
    __set_header_field(name_lc, "", out);
}

fn __set_header_field(name_lc: String, value: String, out: WsUpgradeRequest) {
    if name_lc == "sec-websocket-key" {
        out.key = value;
        return;
    }
    if name_lc == "sec-websocket-version" {
        out.version = value;
        return;
    }
    if name_lc == "upgrade" {
        if std::str::lower(value) == "websocket" {
            out.has_upgrade = true;
        }
        return;
    }
}

// compute_accept — RFC 6455 § 4.2.2 derivation.
// accept = base64(sha1(client_key + WS_MAGIC_GUID))
fn compute_accept(client_key: String) -> String {
    let concat = client_key + ws_magic_guid();
    let digest = std::crypto::sha1(std::bytes::from_string(concat));
    return std::text::base64::encode(digest);
}

// build_101_response — server's HTTP/1.1 101 Switching Protocols
// reply. After sending these bytes the socket is in WebSocket
// framed mode.
fn build_101_response(accept_key: String) -> Bytes {
    let mut s = "HTTP/1.1 101 Switching Protocols\r\n";
    s = s + "Upgrade: websocket\r\n";
    s = s + "Connection: Upgrade\r\n";
    s = s + "Sec-WebSocket-Accept: " + accept_key + "\r\n";
    s = s + "\r\n";
    return std::bytes::from_string(s);
}

// build_400_response — fallback when the inbound request isn't a
// valid WS upgrade. Used by WsServer to return a basic HTTP error
// so clients don't hang waiting for a response on a misrouted
// request.
fn build_400_response(reason: String) -> Bytes {
    // Connection: close lets the client detect end-of-body on
    // socket close, dodging the need for a Content-Length header
    // (which would require Int-to-String — codegen v0 doesn't
    // surface `std::str::from_int` yet).
    let body = "400 Bad Request: " + reason + "\r\n";
    let mut s = "HTTP/1.1 400 Bad Request\r\n";
    s = s + "Content-Type: text/plain; charset=utf-8\r\n";
    s = s + "Connection: close\r\n";
    s = s + "\r\n";
    s = s + body;
    return std::bytes::from_string(s);
}
