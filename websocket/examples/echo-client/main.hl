// pond/websocket/examples/echo-client — minimal end-to-end exercise.
//
// Connects to a WebSocket echo server (default
// wss://echo.websocket.events; pass a ws://host:port/path URL as
// argv[1] to target e.g. a local server), sends a few text frames,
// prints the echoes, exits cleanly.
//
// Build:
//   hale build pond/websocket/examples/echo-client/
//
// Run:
//   ./pond/websocket/examples/echo-client/echo-client
//   ./pond/websocket/examples/echo-client/echo-client ws://127.0.0.1:9001/
//
// Shape (post-refactor 2026-05-19): owner-driven recv. EchoTap
// owns the WsClient as a child locus, drives the recv loop from
// its own run() body, never touches the bus.

import "../.." as ws;

// F.31 removed the per-locus `: schedule` annotation; thread
// placement now lives in a `main locus`'s `placement { }` block.
// This single-locus demo just runs on the main thread.
locus EchoTap {
    params {
        limit: Int = 5;
    }

    run() {
        println("=== echo-client ===");

        let mut url = std::env::arg(1);
        if url == "" {
            url = "wss://echo.websocket.events";
        }
        println("[echo] url = ", url);

        let conn = ws::WsClient {
            url:            url,
            auto_reconnect: true,
            max_retries:    3,
            reconnect_initial: 1s,
            reconnect_max:  10s,
            ping_interval:  30s,
            pong_timeout:   10s,
            recv_chunk:     4096,
        };

        let mut bail = false;
        if !conn.open() {
            println("[echo] open failed: kind=", conn.last_error.kind,
                    " detail=", conn.last_error.detail);
            bail = true;
        } else {
            println("[echo] connected");

            // send_* / close now carry fallible(WsError) (v0.8.1).
            // Best-effort here: drop a failed send with `or discard`.
            conn.send_text("hello from pond/websocket") or discard;
            conn.send_text("frame 2") or discard;
            conn.send_text("frame 3") or discard;

            let mut seen = 0;
            while seen < self.limit && !bail {
                if conn.read_msg() {
                    seen = seen + 1;
                    let m = conn.last_message;
                    if m.kind == "text" {
                        println("[echo] text #", seen, ": ", m.text);
                    } else {
                        println("[echo] ", m.kind, " #", seen,
                                " (", len(m.bytes), " bytes)");
                    }
                } else {
                    println("[echo] error: kind=", conn.last_error.kind,
                            " detail=", conn.last_error.detail);
                    bail = true;
                }
            }

            conn.close() or discard;
            println("[echo] done; frames_received=", conn.frames_received,
                    " frames_sent=", conn.frames_sent,
                    " reconnects=", conn.reconnects);
        }

        let _ = conn;
    }
}

fn main() {
    EchoTap { limit: 5 };
}
