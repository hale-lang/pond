// pond/websocket/server — server-side WebSocket connection wrapper.
//
// The inverse of `client.hl`'s WsClient. Wraps one accepted TCP
// connection, drives the server-side RFC 6455 handshake, and
// exposes the same `read_msg` / `send_text` / `send_binary`
// surface for the connection's lifetime.
//
// **Driver model**: owner-driven, exactly like WsClient. The
// owning locus's run() body calls `read_msg()` in a loop and
// inspects `last_message` via the contract. Async I/O parking
// (when placed on a `where async_io` pool) happens transparently
// inside the recv path; user code stays synchronous-shaped.
//
// **Single connection**: this locus is the per-connection state.
// An accept-loop locus (typically pinned) accepts inbound TCP
// connections, publishes the fd on a bus topic, and a dispatcher
// locus inline-instantiates one `WsServerConn` per event in a
// handler that runs on the async_io pool — the F.35-shaped
// pattern.
//
// **Surface (mirrors WsClient)**:
//   birth(fd)        — wraps the accepted fd; no I/O yet
//   handshake()      — read upgrade request, send 101 response
//                      (returns false if handshake invalid)
//   read_msg()       — block (or park) until next message
//   send_text(s)     — send a text frame (unmasked, server-shape)
//   send_binary(b)   — send a binary frame
//   close()          — send close frame + tear down

// Same-seed siblings (types/frame/handshake/loggers) are
// referenced bare per the pond/websocket multi-file
// convention — see client.hl for the same pattern.

locus WsServerConn {
    params {
        // ---- inputs ----
        conn_fd: Int = -1;

        // Liveness cadences, mirroring WsClient (2026-06-12;
        // std::io::tcp::set_recv_timeout + the -2 recv-timeout
        // sentinel on recv_into):
        //
        //   - `ping_interval` — steady-state recv deadline. A
        //     client silent that long gets a proactive ping.
        //   - `pong_timeout`  — post-ping deadline; silence past
        //     it ⇒ peer presumed dead, read_msg returns false
        //     with last_error.kind == "timeout". Also bounds the
        //     handshake() wait for the upgrade request.
        //   - Either at 0 disables that deadline (recv blocks).
        //
        // Any inbound bytes count as liveness and re-arm
        // `ping_interval`.
        ping_interval: Duration = 30s;
        pong_timeout:  Duration = 10s;

        // ---- internal state ----
        handshake_done: Bool = false;
        connected:      Bool = false;
        awaiting_pong:  Bool = false;

        rx_buf: std::bytes::BytesBuilder
              = std::bytes::BytesBuilder { initial_cap: 8192 };

        frag_kind: String = "";
        frag_buf:  std::bytes::BytesBuilder
                 = std::bytes::BytesBuilder { initial_cap: 1024 };

        scratch_buf: std::bytes::BytesBuilder
                   = std::bytes::BytesBuilder { initial_cap: 128 };

        // ---- exposed via contract ----
        last_message: WsMessage;
        last_error:   WsError;

        frames_received: Int = 0;
        frames_sent:     Int = 0;

        // ---- diagnostic logger ----
        logger: WsLogger =   StderrWsLogger { };

        // recv chunk size
        recv_chunk: Int = 4096;
    }

    contract {
        expose connected:        Bool;
        expose last_message:     WsMessage;
        expose last_error:       WsError;
        expose frames_received:  Int;
        expose frames_sent:      Int;
    }

    birth() {
        // No I/O at birth — the caller has already accepted the
        // connection. `handshake()` does the protocol exchange.
        self.connected = true;
    }

    // handshake — read the client's HTTP/1.1 upgrade request,
    // validate the Sec-WebSocket-Key, send the 101 response.
    // Returns true on success; false on malformed / non-upgrade
    // requests (a 400 response is sent before tearing down).
    fn handshake() -> Bool {
        let stream = std::io::tcp::Stream { conn_fd: self.conn_fd, owns_fd: false };

        // Bound the upgrade-request wait: a client that connects
        // and then goes silent can't park this conn forever.
        self.awaiting_pong = false;
        self.set_recv_deadline(self.pong_timeout);

        // Read until we have a full HTTP request (terminated by
        // \r\n\r\n). Cap at 16 KB — anything bigger isn't a
        // real handshake.
        self.rx_buf.clear();
        let mut total = 0;
        let cap = 16384;
        while total < cap {
            let got = std::io::tcp::recv_into(self.conn_fd, self.rx_buf, self.recv_chunk);
            if got == -2 {
                self.last_error = WsError {
                    kind:   "timeout",
                    detail: "no upgrade request within pong_timeout",
                };
                self.logger.on_event(WsLogEvent {
                    phase:  "handshake",
                    detail: "upgrade request timed out",
                    bytes:  total,
                    op:     -1,
                });
                self.connected = false;
                return false;
            }
            if got <= 0 {
                self.last_error = WsError {
                    kind:   "handshake",
                    detail: "peer closed before upgrade headers complete",
                };
                self.logger.on_event(WsLogEvent {
                    phase:  "handshake",
                    detail: "peer closed",
                    bytes:  total,
                    op:     -1,
                });
                self.connected = false;
                return false;
            }
            total = total + got;
            let snap = self.rx_buf.snapshot();
            let s = std::str::from_bytes(snap);
            if std::str::contains(s, "\r\n\r\n") {
                total = cap;     // exit loop
            }
        }

        let req_bytes = self.rx_buf.snapshot();
        let req = parse_request(req_bytes);
        self.logger.on_event(WsLogEvent {
            phase:  "handshake",
            detail: "recv upgrade path=" + req.path,
            bytes:  len(req_bytes),
            op:     -1,
        });

        if !req.has_upgrade || req.key == "" {
            let body =   build_400_response("missing Upgrade or Sec-WebSocket-Key");
            stream.send_bytes(body) or discard;
            self.last_error = WsError {
                kind:   "handshake",
                detail: "not a websocket upgrade",
            };
            self.connected = false;
            return false;
        }

        let accept_key =   compute_accept(req.key);
        let resp       =   build_101_response(accept_key);
        stream.send_bytes(resp) or discard;

        self.handshake_done = true;
        self.rx_buf.clear();

        // Steady-state liveness deadline from here on.
        self.set_recv_deadline(self.ping_interval);

        self.logger.on_event(WsLogEvent {
            phase:  "handshake",
            detail: "101 sent for path " + req.path,
            bytes:  len(resp),
            op:     -1,
        });
        return true;
    }

    // read_msg — block (or park on async_io) until the next
    // application-level message arrives. Continuation frames
    // are reassembled into frag_buf; control frames (ping/close)
    // are handled inline. Returns false on EOF / framing error;
    // caller inspects `self.last_error` and `self.last_message`.
    fn read_msg() -> Bool {
        if !self.handshake_done {
            self.last_error = WsError {
                kind:   "framing",
                detail: "read_msg before handshake",
            };
            return false;
        }
        let stream = std::io::tcp::Stream { conn_fd: self.conn_fd, owns_fd: false };

        while true {
            // Ensure we have at least 2 bytes (min frame header).
            while self.rx_buf.len() < 2 {
                if !self.pump_recv() {
                    return false;
                }
            }

            let buf = self.rx_buf.snapshot();
            let hdr =   peek_header(buf, 0) or __raise_framing(err, self);
            if hdr.total <= 0 {
                return false;
            }

            // Wait until we have the full frame.
            while self.rx_buf.len() < hdr.total {
                if !self.pump_recv() {
                    return false;
                }
            }

            let full = self.rx_buf.snapshot();
            self.frames_received = self.frames_received + 1;

            // Unmask payload into scratch (client-to-server is
            // always masked per RFC 6455 § 5.1).
            self.scratch_buf.clear();
              unmask_into(self.scratch_buf, full,
                            hdr.payload_off, hdr.payload_len,
                            hdr.masked,
                            hdr.mk0, hdr.mk1, hdr.mk2, hdr.mk3);
            let payload = self.scratch_buf.snapshot();

            // Consume the frame from rx_buf.
            self.rx_buf.shift_front(hdr.total);

            let kind =   opcode_to_kind(hdr.opcode);

            // Control frames: handle inline, then loop for the
            // next frame.
            if kind == "ping" {
                let pong =   emit_server_frame(true, 10, payload);
                stream.send_bytes(pong) or discard;
                self.frames_sent = self.frames_sent + 1;
            } else if kind == "close" {
                let close =   emit_server_frame(true, 8, payload);
                stream.send_bytes(close) or discard;
                self.frames_sent = self.frames_sent + 1;
                self.connected = false;
                self.last_error = WsError {
                    kind:   "close",
                    detail: "peer requested close",
                };
                return false;
            } else if kind == "pong" {
                // Drop silently.
            } else {
                // Data frame: handle fragmentation.
                if !hdr.fin {
                    if kind != "continuation" {
                        self.frag_kind = kind;
                        self.frag_buf.clear();
                    }
                    self.frag_buf.append(payload);
                } else {
                    if kind == "continuation" {
                        self.frag_buf.append(payload);
                        // In-place mutation, not a whole-value
                        // WsMessage replace: a replaced struct
                        // accumulates per message in the locus
                        // arena for the connection's lifetime
                        // (default-on unbounded-alloc warning;
                        // upstream audit's true-positive class).
                        // kind only re-anchors on a transition.
                        if self.last_message.kind != self.frag_kind {
                            self.last_message.kind = self.frag_kind;
                        }
                        self.last_message.text  = self.frag_buf.text_view();
                        self.last_message.bytes = self.frag_buf.view();
                        self.frag_kind = "";
                    } else {
                        // Single-frame message — stash into
                        // frag_buf so the view outlives this
                        // method's stack frame (consumer reads
                        // last_message.{text,bytes} after we
                        // return).
                        self.frag_buf.clear();
                        self.frag_buf.append(payload);
                        // In-place for the same reason as the
                        // continuation arm above.
                        if self.last_message.kind != kind {
                            self.last_message.kind = kind;
                        }
                        self.last_message.text  = self.frag_buf.text_view();
                        self.last_message.bytes = self.frag_buf.view();
                    }
                    return true;
                }
            }
        }
        return false;
    }

    // pump_recv — one liveness-bounded recv into rx_buf. Returns
    // true when bytes arrived; false when the connection is dead
    // (last_error set, connected = false). On a recv deadline
    // (-2 sentinel) it sends a proactive ping and gives the peer
    // `pong_timeout` to produce any traffic; a second deadline
    // expiry declares the peer dead.
    fn pump_recv() -> Bool {
        // Loop-invariant hoists: this single activation lives for
        // the whole connection, so anything allocated inside the
        // loop accumulates per iteration (default-on
        // unbounded-alloc warning). The fd wrapper, the empty
        // ping frame, and the pong-death log event are all
        // constant for the connection.
        let stream = std::io::tcp::Stream { conn_fd: self.conn_fd, owns_fd: false };
        let ping = emit_server_frame(true, 9, b"");
        let pong_dead = WsLogEvent {
            phase:  "error",
            detail: "pong deadline exceeded; peer presumed dead",
            bytes:  0,
            op:     -1,
        };
        while true {
            let got = std::io::tcp::recv_into(self.conn_fd, self.rx_buf, self.recv_chunk);
            if got > 0 {
                if self.awaiting_pong {
                    self.awaiting_pong = false;
                    self.set_recv_deadline(self.ping_interval);
                }
                return true;
            }
            if got == -2 {
                if self.awaiting_pong {
                    self.awaiting_pong = false;
                    self.connected = false;
                    self.last_error = WsError {
                        kind:   "timeout",
                        detail: "no pong within pong_timeout; peer presumed dead",
                    };
                    self.logger.on_event(pong_dead);
                    return false;
                }
                // First silence: proactive ping (best-effort),
                // then arm the pong deadline.
                self.awaiting_pong = true;
                stream.send_bytes(ping) or discard;   // best-effort; a dead
                // peer is caught by the pong deadline, not the send error
                self.frames_sent = self.frames_sent + 1;
                self.set_recv_deadline(self.pong_timeout);
            } else {
                // EOF (0) or fatal recv error (< 0, not -2).
                self.last_error = WsError {
                    kind:   "io",
                    detail: "peer closed",
                };
                self.connected = false;
                return false;
            }
        }
        return false;
    }

    // set_recv_deadline — arm SO_RCVTIMEO on the wrapped fd.
    // d = 0 disables. A setsockopt failure degrades to the old
    // fully-blocking recv, so it is dropped rather than bubbled.
    fn set_recv_deadline(d: Duration) {
        if self.conn_fd >= 0 {
            std::io::tcp::set_recv_timeout(self.conn_fd, d) or discard;
        }
    }

    // send_text / send_binary — owner-called outbound surface, so
    // they carry `fallible(WsError)` (v0.8.1 two-channel rule).
    // Address with `or raise` / `or fail ...` / `or <substitute>`.
    fn send_text(s: String) -> () fallible(WsError) {
        self.send_frame(1, std::bytes::from_string(s)) or raise;
    }

    fn send_binary(b: Bytes) -> () fallible(WsError) {
        self.send_frame(2, b) or raise;
    }

    fn send_frame(opcode: Int, payload: Bytes) -> () fallible(WsError) {
        if !self.connected {
            fail WsError {
                kind:   "io",
                detail: "send on closed connection",
            };
        }
        let stream = std::io::tcp::Stream { conn_fd: self.conn_fd, owns_fd: false };
        let frame =   emit_server_frame(true, opcode, payload);
        // EPIPE / closed peer: since hale 9bc53d5 send_bytes fails with
        // IoError on a genuine error (success is Unit; it loops until the
        // whole frame is written, so there is no short-write case).
        // Translate to the WsError channel and flip `connected` so the
        // owner stops pushing to a closed socket.
        stream.send_bytes(frame) or self.__send_frame_failed(err);
        self.frames_sent = self.frames_sent + 1;
    }

    fn __send_frame_failed(e: IoError) -> () fallible(WsError) {
        self.connected = false;
        self.logger.on_event(WsLogEvent {
            phase:  "close",
            detail: "send failed; peer gone",
            bytes:  0,
            op:     -1,
        });
        fail WsError {
            kind:   "io",
            detail: "send failed; peer gone",
        };
    }

    // close — graceful close frame + teardown. User-called member fn
    // → `fallible(WsError)`; the close-frame write is best-effort
    // (`or discard`) since teardown proceeds regardless.
    fn close() -> () fallible(WsError) {
        if !self.connected {
            return;
        }
        self.send_frame(8, b"") or discard;
        self.connected = false;
    }
}

// ===== free-fn helpers =====

fn __raise_framing(e: WsError, c: WsServerConn) ->   FrameHeader {
    c.last_error = WsError {
        kind:   "framing",
        detail: e.detail,
    };
    c.connected = false;
    return   FrameHeader {
        fin:    false,
        opcode: 0,
        total:  -1,
    };
}

