// pond/subprocess — Process locus (long-lived streaming child)
//
// CONTRACTS.md declares:
//
//   locus Process {
//       params { cmd, args, cwd, pid: Int = -1; }
//       bus { publish StdoutLine; publish StderrLine; publish ProcessExit; }
//       fn send_stdin(b: Bytes) -> () fallible(SpawnError);
//       fn signal(sig: Int) -> () fallible(SpawnError);
//       fn wait() -> ExitStatus fallible(SpawnError);
//   }
//
// Two-channel rule (v0.8.1 #24 v0.2): user-declared `fn` member
// methods carry `fallible(E)` directly — the pre-v0.8.1
// "non-fallible method + self.last_error + paired bridge fns"
// workaround is retired. `send_stdin` / `signal` / `wait` are now
// `fallible(SpawnError)` per the contract; callers address with
// `or raise` / `or <substitute>` / `or handler(err)`.
//
// `birth()` is a lifecycle method (substrate-facing) and so stays
// on the *structural* channel: a spawn failure routes through the
// `closure fatal_spawn { ...; epoch inline; }` + `violate` pattern
// (spec/styleguide.md § 7) so the parent's `on_failure` handles
// it, since birth can't declare `fallible(E)`.
//
// The topic decls live in THIS file (not a sibling) because
// `bus { publish T; }` / `T <- v` only resolve a `topic T`
// declared in the same file as the publishing locus (codegen v0:
// bus-block topic resolution is file-local, not seed-global —
// payload-type resolution IS seed-global). Cross-seed subscribers
// still reference these by qualified name (`sub::ProcessExit`).
//
// `run()` is intentionally a no-op placeholder: the contract names
// StdoutLine/StderrLine streaming publishes but a real
// line-by-line drain loop wants non-blocking I/O + a yield point
// pond doesn't expose yet. The send_stdin / signal / wait surface
// is fully functional; the StdoutLine/StderrLine streaming side is
// documented as a gap in FRICTION.md and remains future work.

topic StdoutLine  { payload: String;     subject: "subprocess.stdout"; }
topic StderrLine  { payload: String;     subject: "subprocess.stderr"; }
topic ProcessExit { payload: ExitStatus; subject: "subprocess.exit";   }

locus Process {
    params {
        cmd:         String;
        args:        String = "";
        cwd:         String = "";
        pid:         Int    = -1;
        // Held Child handle from std::process::spawn. Its own
        // dissolve() reaps the child (TERM → 100ms → KILL); we
        // declare it as a param so the m82 deferred-dissolve frame
        // chains its cleanup after Process's dissolve.
        child:       std::process::Child;
        // Captured by `fatal_spawn` so the parent's on_failure can
        // read the spawn-failure detail off the frozen child.
        spawn_error: String = "";
    }
    bus {
        publish StdoutLine;
        publish StderrLine;
        publish ProcessExit;
    }

    // Birth-time spawn failure is structural (birth can't be
    // fallible): on_spawn_fail records the detail and violates.
    closure fatal_spawn { captures: cmd, spawn_error; epoch inline; }

    birth() {
        // Spawn the child via std::process::spawn. cwd is a
        // documented no-op (no upstream chdir hook yet); the child
        // inherits the parent's working directory.
        let argv = argv_blob(self.cmd, self.args);
        self.child = std::process::spawn(argv) or self.on_spawn_fail(err);
        self.pid = self.child.pid;
    }

    run() {
        // No-op at v1. The StdoutLine/StderrLine streaming shape
        // wants a polling loop with non-blocking reads and yield
        // points; revisit when those primitives land. Placeholder
        // so the body isn't empty (empty bodies parse-fail).
        let _ = self.pid;
    }

    dissolve() {
        // The held std::process::Child handle has its own
        // dissolve() (TERM→100ms→KILL→reap); m82 deferred-dissolve
        // chaining runs it after Process's dissolve. Placeholder so
        // the body isn't empty.
        let _ = self.pid;
    }

    // send_stdin — write bytes to the child's stdin pipe.
    fn send_stdin(b: Bytes) -> () fallible(SpawnError) {
        if self.pid <= 0 {
            fail SpawnError {
                kind:   "spawn_failed",
                detail: "send_stdin: child never spawned",
                errno:  0,
            };
        }
        let s = std::str::from_bytes(b);
        std::process::write_stdin(self.child, s) or fail SpawnError {
            kind:   "io",
            detail: err.kind + ": " + err.path,
            errno:  err.errno,
        };
    }

    // signal — request the child terminate. The upstream
    // `std::process::kill` runs a fixed SIGTERM → 100ms grace →
    // SIGKILL escalation; the `sig` argument is therefore currently
    // ignored (documented no-op — see FRICTION.md).
    fn signal(sig: Int) -> () fallible(SpawnError) {
        let _ = sig;
        if self.pid <= 0 {
            fail SpawnError {
                kind:   "spawn_failed",
                detail: "signal: child never spawned",
                errno:  0,
            };
        }
        std::process::kill(self.child) or fail SpawnError {
            kind:   "io",
            detail: err.kind + ": " + err.path,
            errno:  err.errno,
        };
    }

    // wait — block until the child exits, publish ProcessExit, and
    // return the ExitStatus.
    fn wait() -> ExitStatus fallible(SpawnError) {
        if self.pid <= 0 {
            fail SpawnError {
                kind:   "spawn_failed",
                detail: "wait: child never spawned",
                errno:  0,
            };
        }
        let code = std::process::wait(self.child) or fail SpawnError {
            kind:   "io",
            detail: err.kind + ": " + err.path,
            errno:  err.errno,
        };
        let st = ExitStatus {
            code:     code,
            signaled: code < 0,
            signal:   0,
        };
        // One-shot exit notification. Subscribers wire via
        // `subscribe sub::ProcessExit as on_exit;`.
        ProcessExit <- st;
        return st;
    }

    // on_spawn_fail — error-check fn (spec/styleguide.md § 7) for
    // the birth() spawn call. Records the IoError-derived detail and
    // violates `fatal_spawn` so the failure escalates to the
    // parent's on_failure via the structural channel. Divergent
    // (`violate` is Never), so the declared Child return is never
    // produced.
    fn on_spawn_fail(e: IoError) -> std::process::Child {
        self.spawn_error = e.kind + ": " + e.path;
        violate fatal_spawn;
    }
}
