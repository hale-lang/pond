// The wire, bytes in and frames out: what a client writes, and every
// server frame, whole, split across reads, and several in one read.
import ".." as nats;

fn feed_str(f: nats::NatsFramer, s: String) { f.feed(std::bytes::from_string(s)); }

fn main() {
    // ---- encoders
    std::test::assert_eq_str(std::str::from_bytes(nats::pub_frame("orders.new", "", std::bytes::from_string("hello"))), "PUB orders.new 5\r\nhello\r\n", "PUB without a reply");
    std::test::assert_eq_str(std::str::from_bytes(nats::pub_frame("orders.new", "_INBOX.a.1", std::bytes::from_string(""))), "PUB orders.new _INBOX.a.1 0\r\n\r\n", "PUB with a reply and an empty payload");
    let h = nats::msg_id_headers("fact-7");
    std::test::assert_eq_str(h, "NATS/1.0\r\nNats-Msg-Id: fact-7\r\n\r\n", "a message-id header block");
    std::test::assert_eq_str(std::str::from_bytes(nats::hpub_frame("orders.new", "_INBOX.r", h, std::bytes::from_string("hi"))), "HPUB orders.new _INBOX.r 33 35\r\n" + h + "hi\r\n", "HPUB sizes: the header block, then header block plus payload");
    std::test::assert_eq_str(nats::sub_line("orders.>", "", 3), "SUB orders.> 3\r\n", "SUB");
    std::test::assert_eq_str(nats::sub_line("orders.>", "workers", 4), "SUB orders.> workers 4\r\n", "SUB with a queue group");
    std::test::assert_eq_str(nats::unsub_line(3, 0), "UNSUB 3\r\n", "UNSUB at once");
    std::test::assert_eq_str(nats::unsub_line(3, 1), "UNSUB 3 1\r\n", "UNSUB after one");
    let c = nats::connect_line("ana", "secret", "", "probe", false);
    std::test::assert(std::str::starts_with(c, "CONNECT {") && std::str::ends_with(c, "}\r\n"), "CONNECT is one JSON line: " + c);
    std::test::assert(std::str::contains(c, "\"user\": \"ana\"") && std::str::contains(c, "\"pass\": \"secret\"") && std::str::contains(c, "\"echo\": false") && std::str::contains(c, "\"headers\": true"), "with the credentials and options: " + c);
    let t = nats::connect_line("ana", "secret", "tok", "", true);
    std::test::assert(std::str::contains(t, "\"auth_token\": \"tok\"") && !std::str::contains(t, "\"user\""), "a token wins over user/pass: " + t);

    // ---- server frames
    let f = nats::NatsFramer { };
    feed_str(f, "INFO {\"server_id\":\"S1\",\"max_payload\":1048576}\r\n");
    std::test::assert(f.next() && f.frame.op == "INFO" && std::str::contains(f.frame.text, "\"server_id\":\"S1\""), "INFO carries its JSON");
    std::test::assert(!f.next(), "and nothing is left");

    // a MSG split across three reads: nothing until it is whole
    feed_str(f, "MSG orders.new 7 _INBOX.x.9 1");
    std::test::assert(!f.next(), "half a control line is not a frame");
    feed_str(f, "1\r\nhello ");
    std::test::assert(!f.next(), "a control line without its whole payload is not a frame");
    feed_str(f, "world\r\n");
    std::test::assert(f.next(), "whole now");
    std::test::assert(f.frame.op == "MSG" && f.frame.subject == "orders.new" && f.frame.sid == 7 && f.frame.reply == "_INBOX.x.9", "MSG fields: " + f.frame.subject + " " + f.frame.reply);
    std::test::assert_eq_str(std::str::from_bytes(f.frame.data), "hello world", "and its payload, whole");

    // several frames in one read, in order
    feed_str(f, "PING\r\nMSG a.b 1 3\r\nabc\r\n+OK\r\nPONG\r\n-ERR 'Authorization Violation'\r\n");
    std::test::assert(f.next() && f.frame.op == "PING", "PING first");
    std::test::assert(f.next() && f.frame.op == "MSG" && f.frame.reply == "" && std::str::from_bytes(f.frame.data) == "abc", "MSG without a reply");
    std::test::assert(f.next() && f.frame.op == "OK", "+OK");
    std::test::assert(f.next() && f.frame.op == "PONG", "PONG");
    std::test::assert(f.next() && f.frame.op == "ERR" && f.frame.text == "Authorization Violation", "-ERR with its message: " + f.frame.text);
    std::test::assert(!f.next(), "the read is used up");

    // a payload holding CRLF and a zero byte is carried whole by its size
    let bin = std::bytes::BytesBuilder { };
    bin.append_str("MSG bin 2 5\r\n");
    bin.append_str("a\r\n");
    bin.append(std::bytes::from_int(0));
    bin.append_str("z\r\n");
    f.feed(bin.finish());
    std::test::assert(f.next() && len(f.frame.data) == 5, "a sized payload is not split at its CRLF");

    // HMSG: headers, a status line, and a payload
    feed_str(f, "HMSG js.in 4 $JS.ACK.S.C.1.2.3.4.5 20 23\r\nNATS/1.0\r\nX-A: 1\r\n\r\nabc\r\n");
    std::test::assert(f.next() && f.frame.op == "HMSG" && f.frame.reply == "$JS.ACK.S.C.1.2.3.4.5", "HMSG with a reply");
    std::test::assert(std::str::contains(f.frame.headers, "X-A: 1") && std::str::from_bytes(f.frame.data) == "abc", "headers apart from the payload");
    feed_str(f, "HMSG _INBOX.q 5 28 28\r\nNATS/1.0 404 No Messages\r\n\r\n\r\n");
    std::test::assert(f.next(), "a status-only HMSG");
    std::test::assert_eq_str(nats::header_status(f.frame.headers), "404 No Messages", "its status line");
    std::test::assert_eq_str(nats::header_status("NATS/1.0\r\nX: y\r\n\r\n"), "", "no status");

    // what cannot be NATS stops the framer instead of buffering
    let bad = nats::NatsFramer { };
    feed_str(bad, "HELLO there\r\n");
    std::test::assert(!bad.next() && len(bad.error) > 0, "an unknown op is an error: " + bad.error);
    let bad2 = nats::NatsFramer { };
    feed_str(bad2, "MSG a 1 notanumber\r\n");
    std::test::assert(!bad2.next() && len(bad2.error) > 0, "a size that is not a number is an error");
}
