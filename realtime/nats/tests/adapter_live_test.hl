// The bus adapter end to end against a real server, core mode. The
// program publishes `Out`, bound to NatsAdapter; a relay with its own
// connection takes each message off NATS and publishes its bytes, as
// they are, on the subject of `In`; NatsConn receives them and
// dispatches `In` on the bus. Every message crosses the wire twice.
// Opt-in: set NATS_URL; unset, it says so on stderr and passes.
import ".." as nats;

type Note { n: Int = 0; text: String = ""; }
topic Out { payload: Note; subject: "pond.nats.adapter_test.out"; }
topic In { payload: Note; subject: "pond.nats.adapter_test.in"; }

// The adapter this program binds. `bindings` takes only a locus
// declared in the program itself (hale#1034), so the library's
// NatsAdapter is spelled here: publish onto the library's queue.
locus Nats {
    bus { publish nats::NatsOutbound; }
    fn send(subject: String, bytes: Bytes) { nats::NatsOutbound <- nats::Outbound { subject: subject, data: bytes }; }
}

// Copies what arrives on one subject to another.
locus Relay {
    params {
        url: String = "";
        run_for_ms: Int = 0;
        c: nats::NatsClient = nats::NatsClient { name: "relay" };
        ready: Bool = false;
    }
    // @unbounded: a test fixture's loop, ended by run_for_ms.
    @unbounded
    run() {
        self.c.url = self.url;
        if !self.c.open() { return; }
        let sid = self.c.sub_to("pond.nats.adapter_test.out", "") or 0;
        self.c.flush() or discard;
        let started = std::time::monotonic_ns();
        while std::time::monotonic_ns() - started < self.run_for_ms * 1000000 {
            if self.c.read_msg(20ms) { self.c.pub_msg("pond.nats.adapter_test.in", "", self.c.last.data) or discard; }
        }
        self.c.close();
    }
}

main locus App {
    params {
        url: String = "";
        conn: nats::NatsConn = nats::NatsConn { subjects: "pond.nats.adapter_test.in", run_for_ms: 3000 };
        relay: Relay = Relay { run_for_ms: 3000 };
        got: Int = 0;
        sum: Int = 0;
        last_text: String = "";
    }
    placement { conn: pinned; relay: pinned; }
    bindings { Out: Nats { }; }
    bus { publish Out; subscribe In as on_in; }

    fn on_in(m: Note) {
        self.got = self.got + 1;
        self.sum = self.sum + m.n;
        self.last_text = m.text;
    }

    run() {
        // both connections up before the first publish
        std::time::sleep(500ms);
        let mut i = 1;
        while i <= 50 {
            Out <- Note { n: i, text: "note " + to_string(i) };
            i = i + 1;
        }
        let mut waited = 0;
        while self.got < 50 && waited < 200 {
            std::time::sleep(10ms);
            waited = waited + 1;
        }
        std::test::assert(self.got == 50, "every message came back in: " + to_string(self.got));
        std::test::assert(self.sum == 1275 && self.last_text == "note 50", "whole and in order: " + to_string(self.sum) + " " + self.last_text);
    }
}

fn main() {
    let url = std::env::var("NATS_URL");
    if len(url) == 0 { eprintln("adapter_live_test: NATS_URL unset, skipped"); return; }
    App { url: url, conn: nats::NatsConn { url: url, subjects: "pond.nats.adapter_test.in", run_for_ms: 3000 }, relay: Relay { url: url, run_for_ms: 3000 } };
}
