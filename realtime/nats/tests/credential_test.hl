// A sealed credential read from the vault, against the loopback server
// (tests/loopback), which refuses a CONNECT whose password, or with no
// user its token, is not the one it was given. `hale test` runs each
// test file with a vault of its own (HALE_VAULT_DIR); the test writes
// the entries there and names them, so what a client presents comes
// from the vault, never from a param. Covered: NatsClient with a vault password as
// `user`'s, as a token with no user, a wrong one and a missing one
// refused; and NatsConn presenting its own on every (re)connect,
// carrying a latest-value binding through.
import ".." as nats;
import "loopback" as lb;

type Version { v: Int = 0; }

topic Signal {
    payload: Version;
    subject: "signal";
}
topic Seen {
    payload: Version;
    subject: "seen.signal";
}

const SECRET: String = "s3cret \"quoted\" pass";

main locus App {
    params {
        url: String = "";
        conn_fd: Int = -1;
        client_fd: Int = -1;
        conn_server: lb::LoopServer = lb::LoopServer { };
        conn_watch: lb::LoopWatch = lb::LoopWatch { };
        client_server: lb::LoopServer = lb::LoopServer { };
        client_watch: lb::LoopWatch = lb::LoopWatch { };
        conn: nats::NatsConn = nats::NatsConn { };
        got: Int = 0;
        last: Int = 0;
    }
    placement {
        conn_server: pinned;
        conn_watch: pinned;
        client_server: pinned;
        client_watch: pinned;
        conn: pinned;
    }
    bindings { Signal: nats::NatsAdapter { delivery: nats::Delivery::Latest }; }
    bus {
        publish Signal;
        subscribe Seen as on_seen;
    }

    fn on_seen(m: Version) {
        self.got = self.got + 1;
        self.last = m.v;
    }

    run() {
        // the vault's password, presented as `user`'s
        let a = nats::NatsClient {
            url: self.url,
            user: "svc",
            credential: std::secret::Credential { vault: "nats-pass" },
            timeout: 2s,
        };
        std::test::assert(a.open(), "the vault's password is accepted: " + a.last_error);
        a.close();

        // with no user, the same credential is the token
        let t = nats::NatsClient {
            url: self.url,
            credential: std::secret::Credential { vault: "nats-pass" },
            timeout: 2s,
        };
        std::test::assert(t.open(), "and as a token: " + t.last_error);
        t.close();

        // a wrong one, and one the vault does not have (nothing is presented)
        let w = nats::NatsClient {
            url: self.url,
            user: "svc",
            credential: std::secret::Credential { vault: "nats-wrong" },
            timeout: 2s,
        };
        std::test::assert(!w.open(), "a wrong password is refused");
        std::test::assert(
            std::str::starts_with(w.last_error, "server: Authorization Violation"),
            "by the server: " + w.last_error,
        );
        let m = nats::NatsClient {
            url: self.url,
            user: "svc",
            credential: std::secret::Credential { vault: "nats-missing" },
            timeout: 2s,
        };
        std::test::assert(!m.open(), "a missing entry presents nothing, and is refused");

        // the conn presents its own, and the latest-value message gets through
        Signal <- Version { v: 7 };
        let mut waited = 0;
        while self.last != 7 && waited < 3000 {
            std::time::sleep(10ms);
            waited = waited + 10;
        }
        std::test::assert(
            self.got == 1 && self.last == 7,
            "the conn connected with it: " + to_string(self.got),
        );

        std::io::tcp::__shutdown_listen_socket(self.client_fd);
        std::io::tcp::__shutdown_listen_socket(self.conn_fd);
    }
}

fn main() {
    let dir = std::env::var("HALE_VAULT_DIR");
    if len(dir) == 0 {
        // never the developer's own vault
        eprintln("credential_test: HALE_VAULT_DIR unset (run it with `hale test`), skipped");
        return;
    }
    std::io::fs::write_file(dir + "/nats-pass", SECRET) or raise;
    std::io::fs::write_file(dir + "/nats-wrong", "not it") or raise;
    let conn_fd = std::io::tcp::listen_socket("127.0.0.1", 0) or - 1;
    let client_fd = std::io::tcp::listen_socket("127.0.0.1", 0) or - 1;
    std::test::assert(conn_fd >= 0 && client_fd >= 0, "two loopback listeners");
    App {
        url: "nats://127.0.0.1:" + to_string(std::io::tcp::__local_port(client_fd)),
        conn_fd: conn_fd,
        client_fd: client_fd,
        conn_server: lb::LoopServer { fd: conn_fd, secret: SECRET },
        conn_watch: lb::LoopWatch { fd: conn_fd, after_ms: 15000 },
        client_server: lb::LoopServer { fd: client_fd, secret: SECRET },
        client_watch: lb::LoopWatch { fd: client_fd, after_ms: 15000 },
        conn: nats::NatsConn {
            url: "nats://127.0.0.1:" + to_string(std::io::tcp::__local_port(conn_fd)),
            user: "svc",
            credential: std::secret::Credential { vault: "nats-pass" },
            timeout: 1s,
            reconnect_max_ms: 100,
            run_for_ms: 8000,
        },
    };
}
